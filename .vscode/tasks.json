{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build TrackMeUp (Unpackaged x64)",
      "type": "shell",
      "command": "C:\\Program Files\\dotnet\\dotnet.exe",
      "args": [
        "build",
        "${workspaceFolder}\\TrackMeUp\\TrackMeUp.csproj",
        "-c",
        "Debug-Unpackaged",
        "-p:Platform=x64"
      ],
      "options": {
        "shell": {
          "executable": "pwsh.exe",
          "args": [
            "-NoProfile",
            "-Command"
          ]
        }
      },
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}