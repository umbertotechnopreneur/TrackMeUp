{
  "name": "trackmeup-reports-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && npm run test && vite build && npm run notices:production && npm run verify:production",
    "test": "vitest run",
    "notices:production": "node scripts/generate-third-party-notices.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "echarts": "6.1.0",
    "vue": "3.5.40",
    "vue-echarts": "8.0.1",
    "vuetify": "4.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.2.0",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
