<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="TrackMeUp.AtomicResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close"
    Background="{ThemeResource NuclearizeAcrylicBrush}">
    <ContentDialog.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush x:Key="NuclearizeAcrylicBrush" TintColor="#F7F8FC" TintOpacity="0.88" FallbackColor="#F7F8FC" />
                    <LinearGradientBrush x:Key="NuclearizeVeilBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#30F7F8FC" Offset="0" />
                        <GradientStop Color="#EAF7F8FC" Offset="0.65" />
                        <GradientStop Color="#FFF7F8FC" Offset="1" />
                    </LinearGradientBrush>
                    <x:Double x:Key="NuclearizeArtworkOpacity">0.65</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush x:Key="NuclearizeAcrylicBrush" TintColor="#20232B" TintOpacity="0.8" FallbackColor="#20232B" />
                    <LinearGradientBrush x:Key="NuclearizeVeilBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1020232B" Offset="0" />
                        <GradientStop Color="#E620232B" Offset="0.65" />
                        <GradientStop Color="#FF20232B" Offset="1" />
                    </LinearGradientBrush>
                    <x:Double x:Key="NuclearizeArtworkOpacity">0.8</x:Double>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="NuclearizeAcrylicBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="NuclearizeVeilBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <x:Double x:Key="NuclearizeArtworkOpacity">0</x:Double>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </ContentDialog.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="440" CornerRadius="8">
            <Image Source="ms-appx:///Assets/TrackMeUpNuclearize.png"
                   Stretch="UniformToFill" Opacity="{ThemeResource NuclearizeArtworkOpacity}"
                   IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <Border Background="{ThemeResource NuclearizeVeilBrush}" IsHitTestVisible="False" />
            <StackPanel Padding="20" Spacing="12">
                <Border Height="160" />
                <TextBlock x:Name="WarningMessage" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</ContentDialog>
