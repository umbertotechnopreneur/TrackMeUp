<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Snapshot schedule">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="24,0,180,0"
            Background="Transparent">
            <TextBlock
                VerticalAlignment="Center"
                CharacterSpacing="80"
                FontSize="13"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Text="SNAPSHOT SCHEDULE" />
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Padding="32,24,48,16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="960"
                        Spacing="16">
                <Grid ColumnSpacing="20" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Capture interval" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Minutes between eligible snapshots" />
                    </StackPanel>
                    <NumberBox
                        x:Name="IntervalNumberBox"
                        Grid.Row="1"
                        Width="176"
                        HorizontalAlignment="Left"
                        Value="5"
                        Minimum="1"
                        Maximum="1440"
                        SmallChange="1"
                        LargeChange="5"
                        SpinButtonPlacementMode="Inline" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,4,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="The countdown restarts after every eligible interval."
                        TextWrapping="Wrap" />
                </Grid>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Working hours" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Text="Select the 30-minute periods when scheduled snapshots may run."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Name="StandardWorkWeekButton"
                                AutomationProperties.Name="Apply the 09:00-18:00 work week"
                                Click="StandardWorkWeekButton_Click"
                                Content="09:00-18:00" />
                            <Button
                                x:Name="ClearAllHoursButton"
                                AutomationProperties.Name="Clear all working hours"
                                Click="ClearAllHoursButton_Click"
                                Content="Clear all" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Selected 30-minute blocks are the only times when scheduled snapshots can run. Gaps inside an active period are breaks. With no blocks selected, scheduled snapshots are skipped."
                        TextWrapping="Wrap" />
                    <controls:WeeklyHoursEditor x:Name="WorkingHoursEditor" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="When screen capture is enabled, an eligible snapshot also includes a screen capture."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Height="1"
            VerticalAlignment="Top"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Grid Grid.Row="2" Padding="32,16,48,24" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                MinWidth="112"
                Click="CancelButton_Click"
                Content="Cancel" />
            <Button
                Grid.Column="2"
                MinWidth="112"
                Click="StartButton_Click"
                Content="Start" />
        </Grid>
    </Grid>
</Window>
