<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Snapshot schedule">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Margin="16,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <Image
                    Style="{StaticResource TrackMeUpTitleBarLogoStyle}" />
                <TextBlock
                    CharacterSpacing="100"
                    FontSize="12"
                    Style="{StaticResource TrackMeUpTitleBarLabelStyle}"
                    Tag="Schedule.WindowTitleUpper"
                    Text="SNAPSHOT SCHEDULE" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="ScheduleBodyGrid"
            Grid.Row="1"
            MaxWidth="1040"
            Margin="24,14,40,12"
            HorizontalAlignment="Stretch"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="ScheduleHeaderGrid" ColumnSpacing="16" RowSpacing="10">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="ScheduleWidthStates">
                        <VisualState x:Name="NarrowSchedule">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="WideSchedule">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="820" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="HeaderActionsColumn.Width" Value="Auto" />
                                <Setter Target="HeaderActionsPanel.(Grid.Row)" Value="0" />
                                <Setter Target="HeaderActionsPanel.(Grid.Column)" Value="2" />
                                <Setter Target="HeaderActionsPanel.(Grid.ColumnSpan)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="HeaderActionsColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="5">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Tag="Schedule.Interval.Title" Text="Capture interval" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox
                            x:Name="IntervalNumberBox"
                            Width="120"
                            Value="15"
                            Minimum="1"
                            Maximum="1440"
                            SmallChange="1"
                            LargeChange="5"
                            Tag="Schedule.Interval.Value"
                            SpinButtonPlacementMode="Inline" />
                        <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="min" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Tag="Schedule.WorkingHours.Title" Text="Working hours" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Tag="Schedule.WorkingHours.Description"
                        Text="Select the 15-minute periods when scheduled snapshots may run."
                        TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel
                    x:Name="HeaderActionsPanel"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="StandardWorkWeekButton"
                        MinWidth="124"
                        AutomationProperties.Name="Apply the 09:00-18:00 work week"
                        Click="StandardWorkWeekButton_Click"
                        Content="09:00-18:00"
                        Tag="Schedule.Preset.WorkWeek" />
                    <Button
                        x:Name="ClearAllHoursButton"
                        MinWidth="108"
                        AutomationProperties.Name="Clear all working hours"
                        Click="ClearAllHoursButton_Click"
                        Content="Clear all"
                        Tag="Schedule.ClearAll" />
                </StackPanel>
            </Grid>

            <controls:WeeklyHoursEditor
                x:Name="WorkingHoursEditor"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <TextBlock
                Grid.Row="2"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Tag="Schedule.WorkingHours.CaptureNote"
                Text="When screen capture is enabled, an eligible snapshot also includes a screen capture."
                TextWrapping="Wrap" />
        </Grid>

        <Grid
            x:Name="ScheduleFooterGrid"
            Grid.Row="2"
            Padding="24,13,40,18"
            Background="Transparent"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border
                Grid.ColumnSpan="3"
                Height="1"
                Margin="-24,-13,-40,0"
                VerticalAlignment="Top"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <Button Grid.Column="1" MinWidth="112" Click="CancelButton_Click" Content="Cancel" Tag="Schedule.Cancel" />
            <Button
                Grid.Column="2"
                MinWidth="112"
                Click="StartButton_Click"
                Content="Start"
                Style="{StaticResource AccentButtonStyle}"
                Tag="Schedule.Start" />
        </Grid>
    </Grid>
</Window>
