<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Captured moments">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="24,0,180,0"
            Background="Transparent"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <TextBlock
                VerticalAlignment="Center"
                Tag="Screenshots.Caption"
                Text="Captured moments" />

            <Button
                x:Name="TitleBarMoreButton"
                Width="46"
                Height="40"
                Margin="0,0,8,0"
                Padding="6,0,6,7"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Screenshot actions menu"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarMoreButton_Click"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="19"
                    Glyph="&#xE712;"/>
                <Button.Flyout>
                    <Flyout Opened="MoreMenu_Opened"
                            Placement="TopEdgeAlignedRight"
                            ShouldConstrainToRootBounds="False">
                        <Flyout.SystemBackdrop>
                            <DesktopAcrylicBackdrop />
                        </Flyout.SystemBackdrop>
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="CornerRadius"
                                        Value="12"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="252"
                                    Spacing="2">
                            <StackPanel.Resources>
                                <Style x:Key="ScreenshotOverflowMenuButtonStyle"
                                       TargetType="Button">
                                    <Setter Property="MinHeight"
                                            Value="40"/>
                                    <Setter Property="Padding"
                                            Value="10,6"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="CornerRadius"
                                            Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="MenuItemSurface"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{TemplateBinding CornerRadius}">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                Value="#0DFFFFFF"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                Value="#18FFFFFF"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="MenuItemSurface"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0.45"
                                                                                     Duration="0"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Padding="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconChipStyle"
                                       TargetType="Border">
                                    <Setter Property="Width"
                                            Value="22"/>
                                    <Setter Property="Height"
                                            Value="22"/>
                                    <Setter Property="CornerRadius"
                                            Value="0"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconStyle"
                                       TargetType="FontIcon">
                                    <Setter Property="FontFamily"
                                            Value="Segoe Fluent Icons"/>
                                    <Setter Property="FontSize"
                                            Value="15"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="AutomationProperties.AccessibilityView"
                                            Value="Raw"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button
                                x:Name="SaveScreenshotMenuItem"
                                AutomationProperties.Name="Save selected image"
                                Click="SaveScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE74E;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.Save"
                                        VerticalAlignment="Center"
                                        Text="Save selected image"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="ShareScreenshotMenuItem"
                                AutomationProperties.Name="Share with another app"
                                Click="ShareScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE72D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.Share"
                                        VerticalAlignment="Center"
                                        Text="Share with another app"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="OpenScreenshotFolderMenuItem"
                                AutomationProperties.Name="Open containing folder"
                                Click="OpenScreenshotFolderMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8B7;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.OpenFolder"
                                        VerticalAlignment="Center"
                                        Text="Open containing folder"/>
                                </Grid>
                            </Button>
                            <Border
                                Height="1"
                                Margin="0,5"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button
                                x:Name="DeleteScreenshotMenuItem"
                                AutomationProperties.Name="Delete screenshot"
                                Click="DeleteScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FFE98A5B"
                                            Glyph="&#xE74D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteScreenshot"
                                        VerticalAlignment="Center"
                                        Text="Delete screenshot"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="DeleteSnapshotMenuItem"
                                AutomationProperties.Name="Delete snapshot"
                                Click="DeleteSnapshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FF7FA8D9"
                                            Glyph="&#xE823;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteSnapshot"
                                        VerticalAlignment="Center"
                                        Text="Delete snapshot"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <InfoBar
            x:Name="ScreenshotActionInfoBar"
            Grid.Row="1"
            Margin="32,8,32,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <controls:ScreenshotHeaderControl
            x:Name="HeaderSection"
            Grid.Row="2"
            Margin="32,16,32,0" />

        <controls:ScreenshotGalleryViewControl
            x:Name="GallerySection"
            Grid.Row="3"
            Margin="32,16,32,10" />

        <controls:ScreenshotTimelineControl
            x:Name="TimelineSection"
            Grid.Row="4"
            Margin="32,0,32,20" />
    </Grid>
</Window>
