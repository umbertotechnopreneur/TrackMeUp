<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Captured moments">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <LinearGradientBrush x:Key="ScreenshotBackdropVeilBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#48FFFFFF" Offset="0" />
                            <GradientStop Color="#20EDF7FF" Offset="0.52" />
                            <GradientStop Color="#3DFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                        <RadialGradientBrush
							x:Key="ScreenshotBackdropBloomBrush"
							Center="0.60,0.38"
							GradientOrigin="0.60,0.38"
							RadiusX="0.62"
							RadiusY="0.82">
							<GradientStop Color="#4674B8FF" Offset="0" />
							<GradientStop Color="#2464A7EF" Offset="0.48" />
							<GradientStop Color="#0064A7EF" Offset="1" />
						</RadialGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#CCFFFFFF" Offset="0" />
                            <GradientStop Color="#73EAF4FF" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F2FFFFFF" Offset="0" />
                            <GradientStop Color="#73FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <LinearGradientBrush x:Key="ScreenshotBackdropVeilBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3D020914" Offset="0" />
                            <GradientStop Color="#22081322" Offset="0.52" />
                            <GradientStop Color="#30020A16" Offset="1" />
                        </LinearGradientBrush>
                        <RadialGradientBrush
							x:Key="ScreenshotBackdropBloomBrush"
							Center="0.60,0.38"
							GradientOrigin="0.60,0.38"
							RadiusX="0.62"
							RadiusY="0.82">
							<GradientStop Color="#4D1F6FC4" Offset="0" />
							<GradientStop Color="#26124F96" Offset="0.48" />
							<GradientStop Color="#00124F96" Offset="1" />
						</RadialGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D9141C28" Offset="0" />
                            <GradientStop Color="#99101A27" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#59FFFFFF" Offset="0" />
                            <GradientStop Color="#26FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Default">
                        <LinearGradientBrush x:Key="ScreenshotBackdropVeilBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#48FFFFFF" Offset="0" />
                            <GradientStop Color="#20EDF7FF" Offset="0.52" />
                            <GradientStop Color="#3DFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                        <RadialGradientBrush
							x:Key="ScreenshotBackdropBloomBrush"
							Center="0.60,0.38"
							GradientOrigin="0.60,0.38"
							RadiusX="0.62"
							RadiusY="0.82">
							<GradientStop Color="#4674B8FF" Offset="0" />
							<GradientStop Color="#2464A7EF" Offset="0.48" />
							<GradientStop Color="#0064A7EF" Offset="1" />
						</RadialGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#CCFFFFFF" Offset="0" />
                            <GradientStop Color="#73EAF4FF" Offset="1" />
                        </LinearGradientBrush>
                        <LinearGradientBrush x:Key="ScreenshotDetailsPaneBorderBrush" StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F2FFFFFF" Offset="0" />
                            <GradientStop Color="#73FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="ScreenshotTitleTextStyle" TargetType="TextBlock">
                    <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                    <Setter Property="FontSize" Value="15" />
					<Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="LineHeight" Value="20" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle
            Grid.ColumnSpan="2"
            Grid.RowSpan="5"
			Fill="{ThemeResource ScreenshotBackdropVeilBrush}"
            IsHitTestVisible="False" />
		<Rectangle
			Grid.ColumnSpan="2"
			Grid.RowSpan="5"
			Fill="{ThemeResource ScreenshotBackdropBloomBrush}"
			IsHitTestVisible="False" />

        <Border
            x:Name="TitleBarDragRegion"
            Grid.ColumnSpan="2"
            Height="52"
            Padding="28,0,226,0"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource ScreenshotTitleTextStyle}"
                    Tag="Screenshots.Caption"
                    Text="Captured moments" />

                <ToggleButton
                    x:Name="DetailsToggleButton"
                    Width="40"
                    Height="40"
                    Margin="0,0,8,0"
                    Padding="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AllowFocusOnInteraction="True"
                    AutomationProperties.Name="Show snapshot details"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="DetailsToggleButton_Click"
                    CornerRadius="4"
                    IsTabStop="True"
                    ToolTipService.ToolTip="Show snapshot details">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="17"
                        Glyph="&#xE8A0;" />
                </ToggleButton>

                <Button
                    x:Name="TitleBarMoreButton"
                    Width="46"
                    Height="40"
                    Margin="0,0,54,0"
                    Padding="6,0,6,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Screenshot actions menu"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="TitleBarMoreButton_Click"
                    Style="{StaticResource TitleBarOverflowButtonStyle}"
                    ToolTipService.ToolTip="Menu">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="19"
                    Glyph="&#xE712;"/>
                <Button.Flyout>
                    <Flyout Opened="MoreMenu_Opened"
                            Placement="TopEdgeAlignedRight"
                            ShouldConstrainToRootBounds="False">
                        <Flyout.SystemBackdrop>
                            <DesktopAcrylicBackdrop />
                        </Flyout.SystemBackdrop>
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="CornerRadius"
                                        Value="12"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="252"
                                    Spacing="2">
                            <StackPanel.Resources>
                                <Style x:Key="ScreenshotOverflowMenuButtonStyle"
                                       TargetType="Button">
                                    <Setter Property="MinHeight"
                                            Value="40"/>
                                    <Setter Property="Padding"
                                            Value="10,6"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                    <Setter Property="CornerRadius"
                                            Value="10"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="MenuItemSurface"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{TemplateBinding CornerRadius}">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal"/>
                                                            <VisualState x:Name="PointerOver">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                Value="#0DFFFFFF"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <Storyboard>
                                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                   Storyboard.TargetProperty="Background">
                                                                        <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                Value="#18FFFFFF"/>
                                                                    </ObjectAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="MenuItemSurface"
                                                                                     Storyboard.TargetProperty="Opacity"
                                                                                     To="0.45"
                                                                                     Duration="0"/>
                                                                </Storyboard>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Padding="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconChipStyle"
                                       TargetType="Border">
                                    <Setter Property="Width"
                                            Value="22"/>
                                    <Setter Property="Height"
                                            Value="22"/>
                                    <Setter Property="CornerRadius"
                                            Value="0"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="BorderThickness"
                                            Value="0"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconStyle"
                                       TargetType="FontIcon">
                                    <Setter Property="FontFamily"
                                            Value="Segoe Fluent Icons"/>
                                    <Setter Property="FontSize"
                                            Value="15"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="AutomationProperties.AccessibilityView"
                                            Value="Raw"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button
                                x:Name="SaveScreenshotMenuItem"
                                AutomationProperties.Name="Save selected image"
                                Click="SaveScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE74E;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.Save"
                                        VerticalAlignment="Center"
                                        Text="Save selected image"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="ShareScreenshotMenuItem"
                                AutomationProperties.Name="Share with another app"
                                Click="ShareScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE72D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.Share"
                                        VerticalAlignment="Center"
                                        Text="Share with another app"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="OpenScreenshotFolderMenuItem"
                                AutomationProperties.Name="Open containing folder"
                                Click="OpenScreenshotFolderMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8B7;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.OpenFolder"
                                        VerticalAlignment="Center"
                                        Text="Open containing folder"/>
                                </Grid>
                            </Button>
                            <Border
                                Height="1"
                                Margin="0,5"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                            <Button
                                x:Name="DeleteScreenshotMenuItem"
                                AutomationProperties.Name="Delete screenshot"
                                Click="DeleteScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FFE98A5B"
                                            Glyph="&#xE74D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteScreenshot"
                                        VerticalAlignment="Center"
                                        Text="Delete screenshot"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="DeleteSnapshotMenuItem"
                                AutomationProperties.Name="Delete snapshot"
                                Click="DeleteSnapshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FF7FA8D9"
                                            Glyph="&#xE823;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteSnapshot"
                                        VerticalAlignment="Center"
                                        Text="Delete snapshot"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <InfoBar
            x:Name="ScreenshotActionInfoBar"
            Grid.ColumnSpan="2"
            Grid.Row="1"
            Margin="32,8,32,0"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <controls:ScreenshotHeaderControl
            x:Name="HeaderSection"
            Grid.Row="2"
            Margin="32,16,32,0" />

        <controls:ScreenshotGalleryViewControl
            x:Name="GallerySection"
            Grid.Row="3"
            Margin="32,16,32,10" />

        <controls:ScreenshotTimelineControl
            x:Name="TimelineSection"
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Margin="32,0,32,22" />

        <Border
            x:Name="DetailsPane"
            Grid.Row="2"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="340"
            Margin="0,16,24,20"
            Background="{ThemeResource ScreenshotDetailsPaneBackgroundBrush}"
            BorderBrush="{ThemeResource ScreenshotDetailsPaneBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Visibility="Collapsed">
            <Border.Transitions>
                <TransitionCollection>
                    <PaneThemeTransition Edge="Right" />
                </TransitionCollection>
            </Border.Transitions>
            <controls:ScreenshotDetailsControl x:Name="DetailsSection" />
        </Border>
    </Grid>
</Window>
