<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Captured moments">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="24,0,180,0"
            Background="Transparent"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <TextBlock
                VerticalAlignment="Center"
                Tag="Screenshots.Caption"
                Text="Captured moments" />

            <Button
                x:Name="TitleBarMoreButton"
                Width="46"
                Height="40"
                Margin="0,0,8,0"
                Padding="6,0,6,7"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Screenshot actions menu"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarMoreButton_Click"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    CharacterSpacing="80"
                    FontSize="19"
                    FontWeight="Bold"
                    Text="•••"/>
                <Button.Flyout>
                    <Flyout Opened="MoreMenu_Opened"
                            Placement="TopEdgeAlignedRight">
                        <Flyout.SystemBackdrop>
                            <DesktopAcrylicBackdrop/>
                        </Flyout.SystemBackdrop>
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="CornerRadius"
                                        Value="12"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="252"
                                    Spacing="2">
                            <StackPanel.Resources>
                                <Style x:Key="ScreenshotOverflowMenuButtonStyle"
                                       TargetType="Button">
                                    <Setter Property="MinHeight"
                                            Value="42"/>
                                    <Setter Property="Padding"
                                            Value="12,7"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="CornerRadius"
                                            Value="6"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconChipStyle"
                                       TargetType="Border">
                                    <Setter Property="Width"
                                            Value="30"/>
                                    <Setter Property="Height"
                                            Value="30"/>
                                    <Setter Property="CornerRadius"
                                            Value="10"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconStyle"
                                       TargetType="FontIcon">
                                    <Setter Property="FontFamily"
                                            Value="Segoe Fluent Icons"/>
                                    <Setter Property="FontSize"
                                            Value="15"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="AutomationProperties.AccessibilityView"
                                            Value="Raw"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button
                                x:Name="DeleteScreenshotMenuItem"
                                AutomationProperties.Name="Delete screenshot"
                                Click="DeleteScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}"
                                        Background="#1AF6A56E">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FFE98A5B"
                                            Glyph="&#xE74D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteScreenshot"
                                        VerticalAlignment="Center"
                                        Text="Delete screenshot"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="DeleteSnapshotMenuItem"
                                AutomationProperties.Name="Delete snapshot"
                                Click="DeleteSnapshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}"
                                        Background="#1A9B6FBF">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FF7FA8D9"
                                            Glyph="&#xE823;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteSnapshot"
                                        VerticalAlignment="Center"
                                        Text="Delete snapshot"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="32,20,32,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock
                    Tag="Screenshots.Caption"
                    Text="Captured moments"
                    Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="GalleryCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="0 captures" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <TextBlock
                    Tag="Screenshots.Date.Header"
                    VerticalAlignment="Center"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Date" />
                <CalendarDatePicker
                    x:Name="SelectedDatePicker"
                    Width="258"
                    AutomationProperties.Name="Screenshot date"
                    DateFormat="{}{dayofweek.abbreviated}, {day.integer} {month.full} {year.full}"
                    DateChanged="SelectedDatePicker_DateChanged"
                    PlaceholderText="Select a day"
                    Tag="Screenshots.Date" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="GallerySurface"
            Grid.Row="2"
            Margin="32,18,32,18"
            MinHeight="300"
            PointerEntered="GallerySurface_PointerEntered"
            PointerExited="GallerySurface_PointerExited">
            <Grid x:Name="CoverFlowPanel" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="154" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="154" />
                </Grid.ColumnDefinitions>
                <Border
                    x:Name="PreviousPreviewFrame"
                    Grid.Column="0"
                    Width="142"
                    Height="176"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Opacity="0.62"
                    Padding="4"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <CompositeTransform Rotation="-5" TranslateX="-10" />
                    </Border.RenderTransform>
                    <Image x:Name="PreviousImage" Stretch="UniformToFill" />
                </Border>
                <Border
                    x:Name="GalleryImageFrame"
                    Grid.Column="1"
                    MaxWidth="760"
                    MaxHeight="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="8">
                    <Image x:Name="CurrentImage" Stretch="Uniform" />
                </Border>
                <Border
                    x:Name="NextPreviewFrame"
                    Grid.Column="2"
                    Width="142"
                    Height="176"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Opacity="0.62"
                    Padding="4"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <CompositeTransform Rotation="5" TranslateX="10" />
                    </Border.RenderTransform>
                    <Image x:Name="NextImage" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <Button
                x:Name="PreviousButton"
                Margin="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="Previous screenshot"
                Click="PreviousButton_Click"
                Opacity="1"
                Style="{StaticResource NavigationButtonStyle}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
            </Button>
            <Button
                x:Name="NextButton"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Next screenshot"
                Click="NextButton_Click"
                Opacity="1"
                Style="{StaticResource NavigationButtonStyle}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" />
            </Button>

            <Grid x:Name="EmptyGalleryPanel" Background="Transparent" Visibility="Collapsed">
                <StackPanel MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="32"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE722;" />
                    <TextBlock
                        x:Name="EmptyGalleryText"
                        Tag="Screenshots.Empty"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="No screenshots for this day."
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
            <ProgressRing
                x:Name="GalleryProgressRing"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel
            x:Name="FilmstripStrip"
            Grid.Row="3"
            Margin="32,0,32,20"
            HorizontalAlignment="Stretch"
            Spacing="6"
            Visibility="Collapsed">
            <Button
                x:Name="FilmstripToggleButton"
                Width="32"
                Height="24"
                Padding="0"
                HorizontalAlignment="Center"
                AutomationProperties.Name="Show screenshot strip"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="FilmstripToggleButton_Click">
                <FontIcon
                    x:Name="FilmstripChevronIcon"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15"
                    Glyph="&#xE70D;" />
            </Button>
            <ScrollViewer
                x:Name="FilmstripPanelHost"
                Padding="0,4,0,0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                Visibility="Collapsed">
                <StackPanel x:Name="FilmstripPanel" Orientation="Horizontal" Spacing="10" />
            </ScrollViewer>
        </StackPanel>
    </Grid>
</Window>
