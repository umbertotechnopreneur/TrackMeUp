<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScreenshotWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Captured moments">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <Style x:Key="MetadataChipStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="14,10" />
            </Style>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="46" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="23" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="24,0,180,0"
            Background="Transparent"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <TextBlock
                VerticalAlignment="Center"
                Tag="Screenshots.Caption"
                Text="Captured moments" />

            <Button
                x:Name="TitleBarMoreButton"
                Width="46"
                Height="40"
                Margin="0,0,8,0"
                Padding="6,0,6,7"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Screenshot actions menu"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarMoreButton_Click"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    CharacterSpacing="80"
                    FontSize="19"
                    FontWeight="Bold"
                    Text="•••"/>
                <Button.Flyout>
                    <Flyout Opened="MoreMenu_Opened"
                            Placement="BottomEdgeAlignedRight">
                        <Flyout.SystemBackdrop>
                            <DesktopAcrylicBackdrop/>
                        </Flyout.SystemBackdrop>
                        <Flyout.FlyoutPresenterStyle>
                            <Style TargetType="FlyoutPresenter">
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="CornerRadius"
                                        Value="12"/>
                            </Style>
                        </Flyout.FlyoutPresenterStyle>
                        <StackPanel Width="252"
                                    Spacing="2">
                            <StackPanel.Resources>
                                <Style x:Key="ScreenshotOverflowMenuButtonStyle"
                                       TargetType="Button">
                                    <Setter Property="MinHeight"
                                            Value="42"/>
                                    <Setter Property="Padding"
                                            Value="12,7"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Stretch"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="Background"
                                            Value="Transparent"/>
                                    <Setter Property="BorderBrush"
                                            Value="Transparent"/>
                                    <Setter Property="CornerRadius"
                                            Value="6"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconChipStyle"
                                       TargetType="Border">
                                    <Setter Property="Width"
                                            Value="30"/>
                                    <Setter Property="Height"
                                            Value="30"/>
                                    <Setter Property="CornerRadius"
                                            Value="10"/>
                                    <Setter Property="Padding"
                                            Value="0"/>
                                </Style>
                                <Style x:Key="ScreenshotOverflowIconStyle"
                                       TargetType="FontIcon">
                                    <Setter Property="FontFamily"
                                            Value="Segoe Fluent Icons"/>
                                    <Setter Property="FontSize"
                                            Value="15"/>
                                    <Setter Property="HorizontalAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalAlignment"
                                            Value="Center"/>
                                    <Setter Property="AutomationProperties.AccessibilityView"
                                            Value="Raw"/>
                                </Style>
                            </StackPanel.Resources>
                            <Button
                                x:Name="DeleteScreenshotMenuItem"
                                AutomationProperties.Name="Delete screenshot"
                                Click="DeleteScreenshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}"
                                        Background="#1AF6A56E">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FFE98A5B"
                                            Glyph="&#xE74D;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteScreenshot"
                                        VerticalAlignment="Center"
                                        Text="Delete screenshot"/>
                                </Grid>
                            </Button>
                            <Button
                                x:Name="DeleteSnapshotMenuItem"
                                AutomationProperties.Name="Delete snapshot"
                                Click="DeleteSnapshotMenuItem_Click"
                                Style="{StaticResource ScreenshotOverflowMenuButtonStyle}">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Style="{StaticResource ScreenshotOverflowIconChipStyle}"
                                        Background="#1A9B6FBF">
                                        <FontIcon
                                            Style="{StaticResource ScreenshotOverflowIconStyle}"
                                            Foreground="#FF7FA8D9"
                                            Glyph="&#xE823;"/>
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Tag="Screenshots.Menu.DeleteSnapshot"
                                        VerticalAlignment="Center"
                                        Text="Delete snapshot"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,12,24,4" Spacing="2" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock
                    Tag="Screenshots.Caption"
                    Text="Captured moments"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    x:Name="GalleryCountText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="0 captures" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,8,24,0"
            Padding="10,6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Visibility="Collapsed"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    Tag="Screenshots.Date.Header"
                    VerticalAlignment="Center"
                    Text="Date" />
                <CalendarDatePicker
                    x:Name="SelectedDatePicker"
                    Width="270"
                    AutomationProperties.Name="Screenshot date"
                    DateFormat="{}{dayofweek.abbreviated}, {day.integer} {month.full} {year.full}"
                    DateChanged="SelectedDatePicker_DateChanged"
                    PlaceholderText="Select a day"
                    Tag="Screenshots.Date" />
            </StackPanel>
        </Border>

        <Grid
            x:Name="GallerySurface"
            Grid.Row="2"
            Margin="24,18,24,24"
            MinHeight="360"
            PointerEntered="GallerySurface_PointerEntered"
            PointerExited="GallerySurface_PointerExited">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,42,0,42"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Opacity="0.6"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <CompositeTransform Rotation="-6" TranslateX="-18" />
                    </Border.RenderTransform>
                    <Image x:Name="PreviousImage" Stretch="UniformToFill" />
                </Border>

                <Border
                    Grid.Column="1"
                    MaxWidth="760"
                    MaxHeight="470"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="6">
                    <Image x:Name="CurrentImage" Stretch="Uniform" />
                </Border>

                <Border
                    Grid.Column="2"
                    Margin="0,42,0,42"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Opacity="0.6"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <CompositeTransform Rotation="6" TranslateX="18" />
                    </Border.RenderTransform>
                    <Image x:Name="NextImage" Stretch="UniformToFill" />
                </Border>
            </Grid>

            <Button
                x:Name="PreviousButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.Name="Previous screenshot"
                Click="PreviousButton_Click"
                Opacity="1"
                Style="{StaticResource NavigationButtonStyle}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
            </Button>
            <Button
                x:Name="NextButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                AutomationProperties.Name="Next screenshot"
                Click="NextButton_Click"
                Opacity="1"
                Style="{StaticResource NavigationButtonStyle}">
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" />
            </Button>

            <Grid x:Name="EmptyGalleryPanel" Background="Transparent" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <FontIcon
                        HorizontalAlignment="Center"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="28"
                        Glyph="&#xE722;" />
                    <TextBlock
                        x:Name="EmptyGalleryText"
                        Tag="Screenshots.Empty"
                        Text="No screenshots for this day."
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
            <ProgressRing
                x:Name="GalleryProgressRing"
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="24,0,24,12" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Border MinWidth="190" Style="{StaticResource MetadataChipStyle}">
                    <Grid ColumnSpacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE787;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Tag="Screenshots.DateLabel" Text="Date" />
                            <TextBlock x:Name="CaptureDateText" FontWeight="SemiBold" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border MinWidth="150" Style="{StaticResource MetadataChipStyle}">
                    <Grid ColumnSpacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Tag="Screenshots.TimeLabel" Text="Time" />
                            <TextBlock x:Name="CaptureTimeText" FontWeight="SemiBold" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border MinWidth="230" Style="{StaticResource MetadataChipStyle}">
                    <Grid ColumnSpacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Tag="Screenshots.ApplicationLabel" Text="Foreground app" />
                            <TextBlock x:Name="CaptureApplicationText" FontWeight="SemiBold" Text="—" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border MinWidth="130" Style="{StaticResource MetadataChipStyle}">
                    <Grid ColumnSpacing="10">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Tag="Screenshots.OriginLabel" Text="Origin" />
                            <TextBlock x:Name="CaptureOriginText" FontWeight="SemiBold" Text="—" />
                        </StackPanel>
                    </Grid>
                </Border>
        </StackPanel>

        <Expander
            x:Name="FilmstripExpander"
            Grid.Row="4"
            Margin="24,0,24,24"
            HorizontalContentAlignment="Stretch"
            IsExpanded="True"
            Visibility="Collapsed">
            <Expander.Header>
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Tag="Screenshots.Timeline" Text="Timeline" />
                    <TextBlock x:Name="FilmstripCountText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0" />
                </Grid>
            </Expander.Header>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="FilmstripPanel" Orientation="Horizontal" Spacing="10" />
            </ScrollViewer>
        </Expander>
    </Grid>
</Window>
