<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ReportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp Reports">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="16,0,180,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">
                <Image
                    Width="22"
                    Height="22"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <TextBlock
                    x:Name="TitleBarCaptionText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="TrackMeUp Reports" />
            </StackPanel>
        </Grid>

        <Grid
            Grid.Row="1"
            Margin="32,12,32,16"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image
                    Width="44"
                    Height="44"
                    Margin="0,2,0,0"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/TrackMeUpSquare150Logo.png" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Tag="Reports.Title"
                        Text="Reports" />
                    <TextBlock
                        Style="{StaticResource TitleTextBlockStyle}"
                        Tag="Reports.Motto"
                        Text="Turn data into rhythm."
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Tag="Reports.Description"
                        Text="See when you work, where your time goes and how consistently."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <ScrollViewer
                Grid.Column="1"
                HorizontalAlignment="Right"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalAlignment="Bottom"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="12">
                    <ComboBox
                        x:Name="RangeComboBox"
                        Width="184"
                        Header="Range"
                        SelectionChanged="ReportSelection_Changed"
                        Tag="Reports.Range">
                        <ComboBoxItem Content="Today" Tag="today" />
                        <ComboBoxItem Content="7 days" Tag="7" />
                        <ComboBoxItem Content="30 days" Tag="30" />
                        <ComboBoxItem Content="90 days" Tag="90" />
                        <ComboBoxItem Content="This month" Tag="thisMonth" />
                        <ComboBoxItem Content="Last month" Tag="lastMonth" />
                        <ComboBoxItem Content="Custom" Tag="custom" />
                    </ComboBox>

                    <ComboBox
                        x:Name="ViewComboBox"
                        Width="184"
                        Header="View"
                        SelectionChanged="ReportSelection_Changed"
                        Tag="Reports.View">
                        <ComboBoxItem Content="Calendar" Tag="calendar" />
                        <ComboBoxItem Content="Time bands" Tag="hourOfWeek" />
                        <ComboBoxItem Content="Trend" Tag="trend" />
                        <ComboBoxItem Content="Applications" Tag="applications" />
                    </ComboBox>

                    <StackPanel
                        x:Name="CustomFromPanel"
                        Visibility="Collapsed">
                        <DatePicker
                            x:Name="CustomFromPicker"
                            Width="168"
                            DateChanged="CustomDatePicker_DateChanged"
                            Header="From"
                            Tag="Reports.From" />
                    </StackPanel>

                    <StackPanel
                        x:Name="CustomToPanel"
                        Visibility="Collapsed">
                        <DatePicker
                            x:Name="CustomToPicker"
                            Width="168"
                            DateChanged="CustomDatePicker_DateChanged"
                            Header="To"
                            Tag="Reports.To" />
                    </StackPanel>

                    <Button
                        x:Name="RefreshReportButton"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Refresh"
                        Click="RefreshReportButton_Click"
                        Content="Refresh"
                        Tag="Reports.Refresh"
                        ToolTipService.ToolTip="Refresh" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Margin="24,0,24,24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <WebView2
                    x:Name="ReportsWebView"
                    AutomationProperties.Name="Interactive report"
                    Visibility="Collapsed" />

                <Grid
                    x:Name="ReportStatusPanel"
                    Padding="32"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                        <ProgressRing
                            x:Name="ReportProgressRing"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Loading report"
                            IsActive="True" />
                        <FontIcon
                            x:Name="ReportErrorIcon"
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="32"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xEA39;"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ReportStatusText"
                            AutomationProperties.LiveSetting="Assertive"
                            FontSize="15"
                            Text="Starting the report engine…"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
