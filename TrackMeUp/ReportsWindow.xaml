<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ReportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp Reports">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Padding="16,0,180,0"
            Background="Transparent">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="10">
                <Image
                    Width="22"
                    Height="22"
                    AutomationProperties.Name="Icona TrackMeUp"
                    IsHitTestVisible="False"
                    Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="TrackMeUp Reports" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Margin="24,18,24,12"
            Padding="22"
            Background="Transparent">
            <Grid RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="56"
                        Height="56"
                        AutomationProperties.Name="Icona TrackMeUp Reports"
                        Source="ms-appx:///Assets/TrackMeUpSquare150Logo.png" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Tag="Reports.Title"
                            Text="Reports" />
                        <TextBlock
                            Style="{StaticResource TitleTextBlockStyle}"
                            Tag="Reports.Motto"
                            Text="Turn data into rhythm." />
                        <TextBlock
                            Style="{StaticResource BodyTextBlockStyle}"
                            Tag="Reports.Description"
                            Text="See when you work, where your time goes and how consistently."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="5">
                        <ComboBox
                            x:Name="RangeComboBox"
                            Tag="Reports.Range"
                            MinWidth="180"
                            Header="Range"
                            SelectionChanged="ReportSelection_Changed">
                            <ComboBoxItem Content="Today" Tag="today" />
                            <ComboBoxItem Content="7 days" Tag="7" />
                            <ComboBoxItem Content="30 days" Tag="30" />
                            <ComboBoxItem Content="90 days" Tag="90" />
                            <ComboBoxItem Content="This month" Tag="thisMonth" />
                            <ComboBoxItem Content="Last month" Tag="lastMonth" />
                            <ComboBoxItem Content="Custom" Tag="custom" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="5">
                        <ComboBox
                            x:Name="ViewComboBox"
                            Tag="Reports.View"
                            MinWidth="180"
                            Header="View"
                            SelectionChanged="ReportSelection_Changed">
                            <ComboBoxItem Content="Calendar" Tag="calendar" />
                            <ComboBoxItem Content="Time bands" Tag="hourOfWeek" />
                            <ComboBoxItem Content="Trend" Tag="trend" />
                            <ComboBoxItem Content="Applications" Tag="applications" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="CustomFromPanel" Grid.Column="2" Spacing="5" Visibility="Collapsed">
                        <DatePicker
                            x:Name="CustomFromPicker"
                            Tag="Reports.From"
                            Header="From"
                            DateChanged="CustomDatePicker_DateChanged" />
                    </StackPanel>

                    <StackPanel x:Name="CustomToPanel" Grid.Column="3" Spacing="5" Visibility="Collapsed">
                        <DatePicker
                            x:Name="CustomToPicker"
                            Tag="Reports.To"
                            Header="To"
                            DateChanged="CustomDatePicker_DateChanged" />
                    </StackPanel>

                    <Button
                        x:Name="RefreshReportButton"
                        Tag="Reports.Refresh"
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Aggiorna il report ignorando la cache"
                        Click="RefreshReportButton_Click"
                        Content="Refresh"
                        ToolTipService.ToolTip="Aggiorna report" />
                </Grid>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Margin="24,0,24,24"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="20">
            <Grid>
                <WebView2
                    x:Name="ReportsWebView"
                    AutomationProperties.Name="Visualizzazione interattiva del report"
                    Visibility="Collapsed" />

                <Grid
                    x:Name="ReportStatusPanel"
                    Padding="32"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                    <StackPanel
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="14">
                        <ProgressRing
                            x:Name="ReportProgressRing"
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Caricamento report"
                            IsActive="True" />
                        <FontIcon
                            x:Name="ReportErrorIcon"
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="32"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Glyph="&#xEA39;"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ReportStatusText"
                            AutomationProperties.LiveSetting="Assertive"
                            FontSize="15"
                            Text="Avvio del motore dei report…"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
