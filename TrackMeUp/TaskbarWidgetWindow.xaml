<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.TaskbarWidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp taskbar control">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid x:Name="TitleBarRegion" Height="1" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" IsHitTestVisible="False" />
        <Viewbox x:Name="WidgetViewbox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid Width="144" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="51" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OpenFlyoutButton" Click="OpenFlyoutButton_Click" Width="38" Height="38" Padding="0" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Apri TrackMeUp" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Apri TrackMeUp">
                    <Image Source="ms-appx:///Assets/TrackMeUpSquare44Logo.targetsize-24_altform-unplated.png" Width="22" Height="22" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Button x:Name="TrackingButton" Grid.Column="1" Click="TrackingButton_Click" Width="38" Height="38" Padding="0" CornerRadius="19" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Avvia registrazione sessione" Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="Avvia registrazione sessione">
                    <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="17" Foreground="{ThemeResource FlyoutTextBrush}" AutomationProperties.AccessibilityView="Raw" />
                </Button>
                <Grid x:Name="RecordingIndicator" Grid.Column="2" Width="51" Height="38" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Registrazione in pausa" ToolTipService.ToolTip="Registrazione in pausa">
                    <Ellipse x:Name="RecordingGlow" Width="22" Height="22" Fill="#88FB4351" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <Ellipse x:Name="RecordingLed" Width="9" Height="9" Fill="#FF77808D" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
