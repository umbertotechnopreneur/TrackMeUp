<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.WorldClockCityPickerDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="26,10,26,24"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="DialogTitleText"
                AutomationProperties.LiveSetting="Assertive"
                FontSize="22"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <ComboBox
                x:Name="CityComboBox"
                Grid.Row="1"
                DisplayMemberPath="DisplayName"
                HorizontalAlignment="Stretch"
                IsTextSearchEnabled="True"
                MaxDropDownHeight="320"
                SelectionChanged="CityComboBox_SelectionChanged" />
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    Click="CancelButton_Click"
                    MinWidth="88" />
                <Button
                    x:Name="AddAnotherButton"
                    Click="AddAnotherButton_Click"
                    IsEnabled="False"
                    MinWidth="132" />
                <Button
                    x:Name="AddButton"
                    Click="AddButton_Click"
                    IsEnabled="False"
                    MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <controls:TimedInfoBar
            x:Name="PickerNotificationBanner"
            Grid.RowSpan="2"
            Margin="18,54,18,0"
            VerticalAlignment="Top"
            Canvas.ZIndex="10" />
    </Grid>
</Window>
