<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.WorldClockCityPickerDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0"
            Padding="22,0">
            <TextBlock
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="26,10,26,24"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                x:Name="DialogTitleText"
                AutomationProperties.LiveSetting="Assertive"
                FontSize="22"
                FontWeight="SemiBold"
                TextWrapping="Wrap" />
            <AutoSuggestBox
                x:Name="CitySearchBox"
                Grid.Row="1"
                TextChanged="CitySearchBox_TextChanged" />
            <ListView
                x:Name="CityList"
                Grid.Row="2"
                DisplayMemberPath="DisplayName"
                IsItemClickEnabled="True"
                ItemClick="CityList_ItemClick"
                SelectionChanged="CityList_SelectionChanged"
                SelectionMode="Single" />
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="CancelButton"
                    Click="CancelButton_Click"
                    MinWidth="88" />
                <Button
                    x:Name="AddButton"
                    Click="AddButton_Click"
                    IsEnabled="False"
                    MinWidth="88"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
