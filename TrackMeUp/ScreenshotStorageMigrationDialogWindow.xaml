<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ScreenshotStorageMigrationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Data migration">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="30,18,30,30"
            ColumnSpacing="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                x:Name="MigrationProgressRing"
                Width="46"
                Height="46"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                IsActive="True" />

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Spacing="7">
                <TextBlock
                    x:Name="MigrationTitleText"
                    AutomationProperties.LiveSetting="Assertive"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="Data migration"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="MigrationMessageText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    FontSize="14"
                    LineHeight="21"
                    Text="Data migration in progress. Please wait…"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
