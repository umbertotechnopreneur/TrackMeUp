<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TrackMeUp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TrackMeUpIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The same sources ship in two distinct deployment modes. The unpackaged
      configurations compile the bootstrapper path before WinUI is activated;
      MSIX configurations retain package-identity deployment initialization.
    -->
    <Configurations>Debug;Release;Debug-Unpackaged;Release-Unpackaged</Configurations>
    <TrackMeUpDistributionMode Condition="'$(TrackMeUpDistributionMode)' == '' and ('$(Configuration)' == 'Debug-Unpackaged' or '$(Configuration)' == 'Release-Unpackaged')">Unpackaged</TrackMeUpDistributionMode>
    <TrackMeUpDistributionMode Condition="'$(TrackMeUpDistributionMode)' == ''">MSIX</TrackMeUpDistributionMode>
    <WindowsPackageType Condition="'$(TrackMeUpDistributionMode)' == 'Unpackaged'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(TrackMeUpDistributionMode)' == 'MSIX'">MSIX</WindowsPackageType>
    <TrackMeUpBuildInfoPath>$(MSBuildProjectDirectory)\BuildInfo.json</TrackMeUpBuildInfoPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="Assets\TrackMeUp*.png" />
    <Content Include="Assets\TrackMeUpIcon.ico" />
    <Content Include="$(TrackMeUpBuildInfoPath)" Link="BuildInfo.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <Content Include="..\TrackMeUp.Reports.Web\dist\**\*">
      <Link>ReportsWeb\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>ReportsWeb\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="GenerateTrackMeUpBuildInformation" BeforeTargets="PrepareForBuild">
    <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\..\scripts\TrackMeUp.ps1&quot; -Action BuildInfo -VersionStatePath &quot;$(MSBuildProjectDirectory)\build-version.json&quot; -OutputPath &quot;$(TrackMeUpBuildInfoPath)&quot; -PackageManifestPath &quot;$(MSBuildProjectDirectory)\Package.appxmanifest&quot; -Configuration &quot;$(Configuration)&quot; -Platform &quot;$(Platform)&quot; -RuntimeIdentifier &quot;$(RuntimeIdentifier)&quot;" />
  </Target>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Sentry.Extensions.Logging" Version="6.7.0" />
    <PackageReference Include="SkiaSharp" Version="4.151.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.151.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.10" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Debug-Unpackaged'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Debug-Unpackaged'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug' or '$(Configuration)' == 'Debug-Unpackaged'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Debug-Unpackaged'">True</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TrackMeUp.Core\TrackMeUp.Core.csproj" />
    <ProjectReference Include="..\TrackMeUp.Cli\TrackMeUp.Cli.csproj" />
    <ProjectReference Include="..\TrackMeUp.Presentation\TrackMeUp.Presentation.csproj" />
    <ProjectReference Include="..\TrackMeUp.Taskbar\TrackMeUp.Taskbar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Providers\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
  </ItemGroup>

</Project>
