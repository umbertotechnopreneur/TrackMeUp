<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="DragRegion"
            Height="48"
            Loaded="DragRegion_Loaded"
            SizeChanged="DragRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TitleBarBackButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Margin="8,0,0,0"
                Padding="8"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Indietro"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarBackButton_Click"
                IsTabStop="False"
                Visibility="Collapsed">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="17"
                    Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="2"
                Margin="20,0,12,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="130"
                FontSize="13"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Text="TRACK ME UP"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="TitleBarMoreButton"
                Grid.Column="4"
                Width="46"
                Height="40"
                Margin="0,0,8,0"
                Padding="6,0,6,7"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Apri menu applicazione"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarMoreButton_Click"
                IsTabStop="False"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M" Modifiers="Menu" />
                </Button.KeyboardAccelerators>
                <TextBlock
                    AutomationProperties.AccessibilityView="Raw"
                    CharacterSpacing="80"
                    FontSize="19"
                    FontWeight="Bold"
                    Text="•••" />
            </Button>
        </Grid>

        <Border
            x:Name="PlayerPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent">
            <Border.Resources>
                <ResourceDictionary>
                    <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFAB8D" Offset="0" />
                        <GradientStop Color="#FFF16F4E" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFF16F4E" />
                    <SolidColorBrush x:Key="SnapshotCaptureBrush"
                                     Color="#FF2D8BA8"/>
                    <SolidColorBrush x:Key="SnapshotDeleteBrush"
                                     Color="#FFC8544D"/>
                    <Style x:Key="CircularActionButtonStyle"
                           TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ActionSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}"/>
                                        <Border x:Name="ActionHoverOverlay"
                                                Background="Black"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                IsHitTestVisible="False"
                                                Opacity="0"/>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Padding="{TemplateBinding Padding}"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.12"
                                                                         Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.22"
                                                                         Duration="0:0:0.5"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionSurface"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.45"
                                                                         Duration="0"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFAB8D" Offset="0" />
                                <GradientStop Color="#FFF16F4E" Offset="1" />
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFF16F4E" />
                            <SolidColorBrush x:Key="SnapshotCaptureBrush"
                                             Color="#FF2D8BA8"/>
                            <SolidColorBrush x:Key="SnapshotDeleteBrush"
                                             Color="#FFC8544D"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF96DDD1" Offset="0" />
                                <GradientStop Color="#FF55B9A7" Offset="1" />
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FF68C9B7" />
                            <SolidColorBrush x:Key="SnapshotCaptureBrush"
                                             Color="#FF55B9A7"/>
                            <SolidColorBrush x:Key="SnapshotDeleteBrush"
                                             Color="#FFE3746A"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled">
                <Grid Padding="0,0,6,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="Menu applicazione"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Visibility="Collapsed">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE712;" />
                            <Button.Flyout>
                                <Flyout Opened="MoreMenu_Opened" Placement="BottomEdgeAlignedRight">
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop />
                                    </Flyout.SystemBackdrop>
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="10" />
                                            <Setter Property="CornerRadius" Value="12" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="252"
                                            Spacing="2">
                                    <StackPanel.Resources>
                                        <Style x:Key="OverflowMenuButtonStyle"
                                               TargetType="Button">
                                            <Setter Property="MinHeight"
                                                    Value="40"/>
                                            <Setter Property="Padding"
                                                    Value="10,6"/>
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Left"/>
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                            <Setter Property="CornerRadius"
                                                    Value="10"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="MenuItemSurface"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{TemplateBinding CornerRadius}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="PointerOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                        Value="#0DFFFFFF"/>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                        Value="#18FFFFFF"/>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="MenuItemSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="0.45"
                                                                                             Duration="0"/>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Padding="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="OverflowMenuIconChipStyle"
                                               TargetType="Border">
                                            <Setter Property="Width"
                                                    Value="22"/>
                                            <Setter Property="Height"
                                                    Value="22"/>
                                            <Setter Property="CornerRadius"
                                                    Value="0"/>
                                            <Setter Property="Padding"
                                                    Value="0"/>
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                        </Style>
                                        <Style x:Key="OverflowMenuIconStyle"
                                               TargetType="FontIcon">
                                            <Setter Property="FontFamily"
                                                    Value="Segoe Fluent Icons"/>
                                            <Setter Property="FontSize"
                                                    Value="15"/>
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="AutomationProperties.AccessibilityView"
                                                    Value="Raw"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button
                                        AutomationProperties.Name="Open reports"
                                        Click="ReportsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF7D9FF8"
                                                          Glyph="&#xE787;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Reports.Title"
                                                       VerticalAlignment="Center"
                                                       Text="Reports"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Open captured moments"
                                        Click="ScreenshotsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF71CBB7"
                                                          Glyph="&#xE722;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Screenshots.Caption"
                                                       VerticalAlignment="Center"
                                                       Text="Captured moments"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Open snapshot schedule"
                                        Click="ScheduleScreenshotMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF85A8DB"
                                                          Glyph="&#xE823;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Schedule.Snapshots"
                                                       VerticalAlignment="Center"
                                                       Text="Snapshot schedule"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="App options"
                                        Click="OptionsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFE5B06A"
                                                          Glyph="&#xE713;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuTitleOptions"
                                                       VerticalAlignment="Center"
                                                       Text="App options"/>
                                        </Grid>
                                    </Button>
                                    <Border MinHeight="44"
                                            Padding="10,4"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFA97BEA"
                                                          Glyph="&#xE945;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuToggleOpenAi"
                                                       VerticalAlignment="Center"
                                                       Text="OpenAI integration"/>
                                            <ToggleSwitch x:Name="OpenAiMenuToggle"
                                                          Grid.Column="2"
                                                          MinWidth="0"
                                                          OffContent=""
                                                          OnContent=""
                                                          Toggled="OpenAiMenuToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <Border MinHeight="44"
                                            Padding="10,4"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFE88F6B"
                                                          Glyph="&#xE7ED;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuToggleScreenshot"
                                                       VerticalAlignment="Center"
                                                       Text="Screenshot"/>
                                            <ToggleSwitch x:Name="ScreenshotsMenuToggle"
                                                          Grid.Column="2"
                                                          MinWidth="0"
                                                          OffContent=""
                                                          OnContent=""
                                                          Toggled="ScreenshotsMenuToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="1"
                                            Margin="0,5"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                    <Button
                                        AutomationProperties.Name="About"
                                        Click="AboutMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF85A8DB"
                                                          Glyph="&#xE946;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuTitleAbout"
                                                       VerticalAlignment="Center"
                                                       Text="About"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Grid Grid.Row="0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CaptureActionsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Bottom"
                                    Spacing="6">
                            <Button
                                x:Name="TrackingButton"
                                Width="84"
                                Height="84"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="Avvia il monitoraggio"
                                Background="{ThemeResource PlayerAccentBrush}"
                                BorderBrush="#D9FFFFFF"
                                BorderThickness="2"
                                Click="TrackingButton_Click"
                                CornerRadius="42"
                                Style="{StaticResource CircularActionButtonStyle}"
                                Translation="0,0,6">
                                <Button.Shadow>
                                    <ThemeShadow/>
                                </Button.Shadow>
                                <FontIcon
                                    x:Name="PlayPauseIcon"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="30"
                                    Foreground="White"
                                    Glyph="&#xE768;"/>
                            </Button>
                            <Button
                                x:Name="TakeScreenshotButton"
                                Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                AutomationProperties.Name="Scatta uno snapshot"
                                Background="{ThemeResource SnapshotCaptureBrush}"
                                BorderBrush="#D9FFFFFF"
                                BorderThickness="2"
                                Click="TakeScreenshotButton_Click"
                                CornerRadius="18"
                                Style="{StaticResource CircularActionButtonStyle}"
                                ToolTipService.ToolTip="Take snapshot">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Foreground="White"
                                    Glyph="&#xE722;"/>
                            </Button>
                            <StackPanel
                                x:Name="PendingSnapshotPanel"
                                Width="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Spacing="2"
                                Visibility="Collapsed">
                                <Button
                                    x:Name="DeleteSnapshotButton"
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.Name="Delete snapshot"
                                    Background="{ThemeResource SnapshotDeleteBrush}"
                                    BorderBrush="#D9FFFFFF"
                                    BorderThickness="2"
                                    Click="DeleteSnapshotButton_Click"
                                    CornerRadius="18"
                                    Style="{StaticResource CircularActionButtonStyle}"
                                    ToolTipService.ToolTip="Delete snapshot">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Foreground="White"
                                        Glyph="&#xE74D;"/>
                                </Button>
                                <ProgressBar
                                    x:Name="SnapshotDeleteCountdownProgress"
                                    Width="36"
                                    Height="3"
                                    Foreground="{ThemeResource SnapshotDeleteBrush}"
                                    IsHitTestVisible="False"
                                    Maximum="30"
                                    Value="30"/>
                                <TextBlock
                                    x:Name="SnapshotDeleteCountdownText"
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="00:30"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="TrackingStateText"
                                AutomationProperties.LiveSetting="Polite"
                                CharacterSpacing="80"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerAccentTextBrush}"
                                Text="IN PAUSA" />
                            <TextBlock
                                x:Name="ElapsedText"
                                FontSize="36"
                                FontWeight="Normal"
                                Text="00:00" />
                            <TextBlock
                                x:Name="CurrentContextText"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="Pronto a misurare il tuo tempo"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="8">
                        <Grid x:Name="ActivityTrendChart"
                                Height="26"
                                Visibility="Collapsed">
                            <Path
                                x:Name="ActivityTrendPath"
                                Margin="0,3,0,4"
                                AutomationProperties.Name="Attività delle ultime 24 ore"
                                Stretch="Fill"
                                Stroke="{ThemeResource PlayerAccentTextBrush}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5"/>
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Margin="0,2,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE765;" />
                                <StackPanel>
                                    <TextBlock Tag="KeysLabel" CharacterSpacing="80" FontSize="10" Text="KEYS" />
                                    <TextBlock x:Name="KeyCountText" FontSize="19" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="34" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE962;" />
                                <StackPanel>
                                    <TextBlock Tag="ClicksLabel" CharacterSpacing="80" FontSize="10" Text="CLICKS" />
                                    <TextBlock x:Name="ClickCountText" FontSize="19" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="34" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE823;" />
                                <StackPanel>
                                    <TextBlock Tag="ActiveLabel" CharacterSpacing="80" FontSize="10" Text="ACTIVE" />
                                    <TextBlock x:Name="ActiveTimeText" FontSize="17" FontWeight="SemiBold" Text="0 min" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="DetailsButton"
                        Grid.Row="2"
                        MinWidth="44"
                        MinHeight="36"
                        Padding="8,3"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Mostra ultima sessione"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="DetailsButton_Click"
                        ToolTipService.ToolTip="Ultima sessione">
                        <FontIcon
                            x:Name="DetailsChevron"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE70D;" />
                    </Button>

                    <Grid x:Name="DetailsPanel" Grid.Row="3" Margin="0,0,0,2" RowSpacing="12" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Grid.Row="1" ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon
                                Grid.RowSpan="2"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="26"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE7F4;" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    x:Name="LastSessionAppText"
                                    FontWeight="SemiBold"
                                    MaxLines="1"
                                    Text="No session recorded"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="LastSessionDetailText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ScreenshotStatusText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Tag="ScreenshotDisabledHint"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Screen captures are off"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ScreenshotPreviewButton"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Width="112"
                                Height="64"
                                Padding="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Apri galleria screenshot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="ScreenshotPreviewButton_Click"
                                PointerEntered="ScreenshotPreviewButton_PointerEntered"
                                PointerExited="ScreenshotPreviewButton_PointerExited"
                                ToolTipService.ToolTip="Apri galleria screenshot">
                                <Border
                                    Width="112"
                                    Height="64"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Translation="0,0,10">
                                    <Border.Shadow>
                                        <ThemeShadow />
                                    </Border.Shadow>
                                    <Grid>
                                        <Image
                                            x:Name="ScreenshotPlaceholderImage"
                                            AutomationProperties.Name="Snapshot placeholder"
                                            Source="ms-appx:///Assets/TrackMeUpSnapshotPlaceholder.png"
                                            Stretch="UniformToFill" />
                                        <Image
                                            x:Name="LastScreenshotImage"
                                            AutomationProperties.Name="Latest snapshot"
                                            ImageFailed="LastScreenshotImage_ImageFailed"
                                            Stretch="UniformToFill"
                                            Visibility="Collapsed" />
                                        <Border
                                            x:Name="ScreenshotOpenOverlay"
                                            Width="27"
                                            Height="27"
                                            Margin="0,0,6,6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            IsHitTestVisible="False"
                                            Opacity="0">
                                            <FontIcon
                                                AutomationProperties.AccessibilityView="Raw"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="13"
                                                Glyph="&#xE8A7;" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="LocalTimeText"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Local time"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="0.82"
                                    Text="Local time --:--:--" />
                                <TextBlock
                                    x:Name="UtcTimeText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="UTC time"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="0.82"
                                    Text="UTC --:--:--" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="OptionsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OptionsControl x:Name="OptionsControl" BackRequested="OptionsControl_BackRequested" />
        </Border>

        <Border
            x:Name="OperationsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OperationsControl x:Name="OperationsControl" BackRequested="OperationsControl_BackRequested" />
        </Border>

        <Border
            x:Name="AboutPanel"
            Grid.Row="1"
            Margin="12"
            Padding="22"
            Background="Transparent"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="0,0,6,0" Spacing="12">
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        Padding="8"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Torna al player"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="AboutBackButton_Click"
                        >
                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="TRACK ME UP" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Personal activity player" TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Tag="About.Description" Style="{StaticResource BodyTextBlockStyle}" Text="A local activity player for understanding time, applications and work rhythm. Typed content is never recorded; snapshots and OpenAI are always opt-in." TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="MVP · MIT License" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="TrackingStatusToast"
            Grid.Row="1"
            Margin="0,18,18,0"
            Padding="10,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Stato monitoraggio"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Canvas.ZIndex="10"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Border.Background>
                <AcrylicBrush FallbackColor="#E0173148" TintColor="#FF173148" TintLuminosityOpacity="0.46" TintOpacity="0.72" />
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Image Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TrackingStatusToastText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock FontSize="9" Foreground="#D9FFFFFF" Text="Local activity player" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
