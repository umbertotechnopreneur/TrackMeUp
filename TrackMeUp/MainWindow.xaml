<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="DragRegion"
            Height="48"
            Padding="12,0,150,0"
            AutomationProperties.AccessibilityView="Raw">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Image Width="20" Height="20" IsHitTestVisible="False" Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" IsHitTestVisible="False" Text="TrackMeUp" />
            </StackPanel>
        </Grid>

        <Border
            x:Name="PlayerPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Grid Padding="0,0,6,0" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid MinHeight="40">
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="130"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="TRACK ME UP"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="MoreButton"
                            MinWidth="40"
                            MinHeight="40"
                            Padding="8"
                            HorizontalAlignment="Right"
                            AutomationProperties.Name="Apri menu applicazione"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            ToolTipService.ToolTip="Menu">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE712;" />
                            <Button.Flyout>
                                <Flyout Opened="MoreMenu_Opened" Placement="BottomEdgeAlignedRight">
                                    <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop />
                                    </Flyout.SystemBackdrop>
                                    <StackPanel MinWidth="300" Spacing="2">
                                        <Button HorizontalContentAlignment="Stretch" AutomationProperties.Name="App options" Background="Transparent" BorderBrush="Transparent" Click="OptionsMenuItem_Click">
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" /><TextBlock Grid.Column="1" Tag="MenuTitleOptions" VerticalAlignment="Center" Text="App options" /></Grid>
                                        </Button>
                                        <Button HorizontalContentAlignment="Stretch" AutomationProperties.Name="Reports" Background="Transparent" BorderBrush="Transparent" Click="ReportsMenuItem_Click">
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D2;" /><TextBlock Grid.Column="1" Tag="Main.Menu.Reports" VerticalAlignment="Center" Text="Reports" /></Grid>
                                        </Button>
                                        <Button HorizontalContentAlignment="Stretch" AutomationProperties.Name="Tools and diagnostics" Background="Transparent" BorderBrush="Transparent" Click="OperationsMenuItem_Click">
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9D9;" /><TextBlock Grid.Column="1" Tag="Main.Menu.Operations" VerticalAlignment="Center" Text="Tools and diagnostics" /></Grid>
                                        </Button>
                                        <Grid MinHeight="44" Padding="12,4" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <FontIcon VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" Glyph="&#xE950;" />
                                            <TextBlock Grid.Column="1" Tag="MenuToggleOpenAi" VerticalAlignment="Center" Text="OpenAI integration" />
                                            <ToggleSwitch x:Name="OpenAiMenuToggle" Grid.Column="2" MinWidth="0" OffContent="" OnContent="" Toggled="OpenAiMenuToggle_Toggled" />
                                        </Grid>
                                        <Button HorizontalContentAlignment="Stretch" AutomationProperties.Name="Take snapshot now" Background="Transparent" BorderBrush="Transparent" Click="TakeSnapshotNowMenuItem_Click">
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" /><TextBlock Grid.Column="1" Tag="Main.Menu.TakeSnapshotNow" VerticalAlignment="Center" Text="Take snapshot now" /></Grid>
                                        </Button>
                                        <Border Height="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                        <Button HorizontalContentAlignment="Stretch" AutomationProperties.Name="About" Background="Transparent" BorderBrush="Transparent" Click="AboutMenuItem_Click">
                                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" /><TextBlock Grid.Column="1" Tag="MenuTitleAbout" VerticalAlignment="Center" Text="About" /></Grid>
                                        </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="TrackingButton"
                            Width="72"
                            Height="72"
                            Padding="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Avvia il monitoraggio"
                            Click="TrackingButton_Click"
                            CornerRadius="36"
                            Style="{StaticResource AccentButtonStyle}">
                            <FontIcon
                                x:Name="PlayPauseIcon"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="27"
                                Foreground="White"
                                Glyph="&#xE768;" />
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock
                                x:Name="TrackingStateText"
                                AutomationProperties.LiveSetting="Polite"
                                CharacterSpacing="80"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="IN PAUSA" />
                            <TextBlock
                                x:Name="ElapsedText"
                                FontSize="31"
                                FontWeight="SemiBold"
                                Text="00:00" />
                            <TextBlock
                                x:Name="CurrentContextText"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="2"
                                Text="Pronto a misurare il tuo tempo"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Spacing="10">
                        <ProgressBar
                            x:Name="ActivityLine"
                            Height="3"
                            AutomationProperties.Name="Intensità attività corrente"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            Foreground="{ThemeResource ActivityLineBrush}"
                            Maximum="100"
                            Value="0" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE765;" />
                                <StackPanel>
                                    <TextBlock Tag="KeysLabel" Style="{StaticResource CaptionTextBlockStyle}" Text="KEYS" />
                                    <TextBlock x:Name="KeyCountText" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="25" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="7">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE962;" />
                                <StackPanel>
                                    <TextBlock Tag="ClicksLabel" Style="{StaticResource CaptionTextBlockStyle}" Text="CLICKS" />
                                    <TextBlock x:Name="ClickCountText" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="25" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="7">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE823;" />
                                <StackPanel>
                                    <TextBlock Tag="ActiveLabel" Style="{StaticResource CaptionTextBlockStyle}" Text="ACTIVE" />
                                    <TextBlock x:Name="ActiveTimeText" FontWeight="SemiBold" Text="0 min" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="DetailsButton"
                        Grid.Row="3"
                        MinWidth="44"
                        MinHeight="36"
                        Padding="8,3"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Mostra ultima sessione"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="DetailsButton_Click"
                        ToolTipService.ToolTip="Ultima sessione">
                        <FontIcon
                            x:Name="DetailsChevron"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE70D;" />
                    </Button>

                    <Grid x:Name="DetailsPanel" Grid.Row="4" Margin="0,0,0,2" ColumnSpacing="12" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock Tag="LastSessionTitle" Style="{StaticResource CaptionTextBlockStyle}" Text="LAST SESSION" />
                            <TextBlock x:Name="LastSessionAppText" FontWeight="SemiBold" MaxLines="2" Text="No session recorded" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            <TextBlock x:Name="LastSessionDetailText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            <TextBlock x:Name="LastSessionAttributesText" Style="{StaticResource CaptionTextBlockStyle}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="ScreenshotPreviewButton"
                            Grid.Column="1"
                            Padding="0"
                            AutomationProperties.Name="Apri cartella screenshot"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ScreenshotPreviewButton_Click"
                            ToolTipService.ToolTip="Apri cartella screenshot">
                            <Grid Width="112" Height="62">
                                <Image x:Name="LastScreenshotImage" AutomationProperties.AccessibilityView="Raw" Stretch="UniformToFill" Visibility="Collapsed" />
                                <Border x:Name="ScreenshotPlaceholder" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" />
                                        <TextBlock Tag="ScreenshotDisabledHint" Style="{StaticResource CaptionTextBlockStyle}" Text="Snapshots disabled" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="OptionsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OptionsControl x:Name="OptionsControl" BackRequested="OptionsControl_BackRequested" />
        </Border>

        <Border
            x:Name="OperationsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OperationsControl x:Name="OperationsControl" BackRequested="OperationsControl_BackRequested" />
        </Border>

        <Border
            x:Name="AboutPanel"
            Grid.Row="1"
            Margin="12"
            Padding="22"
            Background="Transparent"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="0,0,6,0" Spacing="12">
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        Padding="8"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Torna al player"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="AboutBackButton_Click"
                        >
                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="TRACK ME UP" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Personal activity player" TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Tag="About.Description" Style="{StaticResource BodyTextBlockStyle}" Text="A local activity player for understanding time, applications and work rhythm. Typed content is never recorded; snapshots and OpenAI are always opt-in." TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="MVP · MIT License" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="TrackingStatusToast"
            Grid.Row="1"
            Margin="0,18,18,0"
            Padding="10,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Stato monitoraggio"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Canvas.ZIndex="10"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Border.Background>
                <AcrylicBrush FallbackColor="#E0173148" TintColor="#FF173148" TintLuminosityOpacity="0.46" TintOpacity="0.72" />
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Image Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TrackingStatusToastText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock FontSize="9" Foreground="#D9FFFFFF" Text="Local activity player" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
