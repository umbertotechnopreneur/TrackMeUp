<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid
            x:Name="DragRegion"
            Height="48"
            Loaded="DragRegion_Loaded"
            SizeChanged="DragRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="TitleBarBackButton"
                Grid.Column="1"
                Width="40"
                Height="40"
                Margin="8,0,0,0"
                Padding="8"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Indietro"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarBackButton_Click"
                IsTabStop="False"
                Visibility="Collapsed">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="17"
                    Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                Grid.Column="2"
                Margin="28,0,12,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="130"
                FontSize="13"
                FontWeight="SemiBold"
                IsHitTestVisible="False"
                Text="TRACK ME UP"
                TextTrimming="CharacterEllipsis" />
            <Button
                x:Name="TitleBarMoreButton"
                Grid.Column="4"
                Width="46"
                Height="40"
                Margin="0,0,8,0"
                Padding="6,0,6,7"
                AllowFocusOnInteraction="False"
                AutomationProperties.Name="Apri menu applicazione"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="TitleBarMoreButton_Click"
                IsTabStop="False"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="M" Modifiers="Menu" />
                </Button.KeyboardAccelerators>
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="17"
                    Glyph="&#xE712;" />
            </Button>
        </Grid>

        <Border
            x:Name="PlayerPanel"
            Grid.Row="1"
            Margin="12,4,12,8"
            Padding="16,8,16,10"
            Background="Transparent">
            <Border.Resources>
                <ResourceDictionary>
                    <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFE86C4F" Offset="0" />
                        <GradientStop Color="#FFD34D34" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFB7422E" />
                    <SolidColorBrush x:Key="PlayerAccentGlyphBrush" Color="#FFFFFFFF" />
                    <Style x:Key="CircularActionButtonStyle"
                           TargetType="Button">
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="ActionRoot">
                                        <Border x:Name="ActionSurface"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}"/>
                                        <Border x:Name="ActionHoverOverlay"
                                                Background="{ThemeResource TextFillColorPrimaryBrush}"
                                                CornerRadius="{TemplateBinding CornerRadius}"
                                                IsHitTestVisible="False"
                                                Opacity="0"/>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                          Padding="{TemplateBinding Padding}"/>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionRoot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0"/>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="PointerOver">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionRoot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0"/>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.06"
                                                                         Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionRoot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0"/>
                                                        <DoubleAnimation Storyboard.TargetName="ActionHoverOverlay"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.1"
                                                                         Duration="0:0:0.08"/>
                                                    </Storyboard>
                                                </VisualState>
                                                <VisualState x:Name="Disabled">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ActionRoot"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0.45"
                                                                         Duration="0"/>
                                                    </Storyboard>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFE86C4F" Offset="0" />
                                <GradientStop Color="#FFD34D34" Offset="1" />
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFB7422E" />
                            <SolidColorBrush x:Key="PlayerAccentGlyphBrush" Color="#FFFFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <LinearGradientBrush x:Key="PlayerAccentBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFE86C4F" Offset="0" />
                                <GradientStop Color="#FFD34D34" Offset="1" />
                            </LinearGradientBrush>
                            <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFFF9B82" />
                            <SolidColorBrush x:Key="PlayerAccentGlyphBrush" Color="#FFFFFFFF" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="HighContrast">
                            <SolidColorBrush x:Key="PlayerAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                            <SolidColorBrush x:Key="PlayerAccentGlyphBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Border.Resources>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled">
                <Grid Padding="0,0,6,0" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="MoreButton"
                        AutomationProperties.Name="Menu applicazione"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Visibility="Collapsed">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="15"
                                Glyph="&#xE712;" />
                            <Button.Flyout>
                            <Flyout Opened="MoreMenu_Opened"
                                    Placement="TopEdgeAlignedRight"
                                    ShouldConstrainToRootBounds="False">
                                <Flyout.SystemBackdrop>
                                        <DesktopAcrylicBackdrop />
                                    </Flyout.SystemBackdrop>
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="10" />
                                            <Setter Property="CornerRadius" Value="12" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>
                                <StackPanel Width="252"
                                            Spacing="2">
                                    <StackPanel.Resources>
                                        <Style x:Key="OverflowMenuButtonStyle"
                                               TargetType="Button">
                                            <Setter Property="MinHeight"
                                                    Value="40"/>
                                            <Setter Property="Padding"
                                                    Value="10,6"/>
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Stretch"/>
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Left"/>
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                            <Setter Property="CornerRadius"
                                                    Value="10"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="MenuItemSurface"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="{TemplateBinding CornerRadius}">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="PointerOver">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                        Value="#0DFFFFFF"/>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="MenuItemSurface"
                                                                                                           Storyboard.TargetProperty="Background">
                                                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                                                        Value="#18FFFFFF"/>
                                                                            </ObjectAnimationUsingKeyFrames>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled">
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="MenuItemSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="0.45"
                                                                                             Duration="0"/>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                              ContentTransitions="{TemplateBinding ContentTransitions}"
                                                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Padding="{TemplateBinding Padding}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style x:Key="OverflowMenuIconChipStyle"
                                               TargetType="Border">
                                            <Setter Property="Width"
                                                    Value="22"/>
                                            <Setter Property="Height"
                                                    Value="22"/>
                                            <Setter Property="CornerRadius"
                                                    Value="0"/>
                                            <Setter Property="Padding"
                                                    Value="0"/>
                                            <Setter Property="Background"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderBrush"
                                                    Value="Transparent"/>
                                            <Setter Property="BorderThickness"
                                                    Value="0"/>
                                        </Style>
                                        <Style x:Key="OverflowMenuIconStyle"
                                               TargetType="FontIcon">
                                            <Setter Property="FontFamily"
                                                    Value="Segoe Fluent Icons"/>
                                            <Setter Property="FontSize"
                                                    Value="15"/>
                                            <Setter Property="HorizontalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="VerticalAlignment"
                                                    Value="Center"/>
                                            <Setter Property="AutomationProperties.AccessibilityView"
                                                    Value="Raw"/>
                                        </Style>
                                    </StackPanel.Resources>
                                    <Button
                                        AutomationProperties.Name="Open reports"
                                        Click="ReportsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF7D9FF8"
                                                          Glyph="&#xE787;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Reports.Title"
                                                       VerticalAlignment="Center"
                                                       Text="Reports"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Open captured moments"
                                        Click="ScreenshotsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF71CBB7"
                                                          Glyph="&#xE722;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Screenshots.Caption"
                                                       VerticalAlignment="Center"
                                                       Text="Captured moments"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="Open snapshot schedule"
                                        Click="ScheduleScreenshotMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF85A8DB"
                                                          Glyph="&#xE823;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="Schedule.Snapshots"
                                                       VerticalAlignment="Center"
                                                       Text="Snapshot schedule"/>
                                        </Grid>
                                    </Button>
                                    <Button
                                        AutomationProperties.Name="App options"
                                        Click="OptionsMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFE5B06A"
                                                          Glyph="&#xE713;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuTitleOptions"
                                                       VerticalAlignment="Center"
                                                       Text="App options"/>
                                        </Grid>
                                    </Button>
                                    <Border MinHeight="44"
                                            Padding="10,4"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFA97BEA"
                                                          Glyph="&#xE945;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuToggleOpenAi"
                                                       VerticalAlignment="Center"
                                                       Text="OpenAI integration"/>
                                            <ToggleSwitch x:Name="OpenAiMenuToggle"
                                                          Grid.Column="2"
                                                          MinWidth="0"
                                                          IsEnabled="{x:Bind AiState.CanToggle, Mode=OneWay}"
                                                          IsOn="{x:Bind AiState.Enabled, Mode=OneWay}"
                                                          OffContent=""
                                                          OnContent=""
                                                          Toggled="OpenAiMenuToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <Border MinHeight="44"
                                            Padding="10,4"
                                            CornerRadius="6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FFE88F6B"
                                                          Glyph="&#xE7ED;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuToggleScreenshot"
                                                       VerticalAlignment="Center"
                                                       Text="Screenshot"/>
                                            <ToggleSwitch x:Name="ScreenshotsMenuToggle"
                                                          Grid.Column="2"
                                                          MinWidth="0"
                                                          OffContent=""
                                                          OnContent=""
                                                          Toggled="ScreenshotsMenuToggle_Toggled"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="1"
                                            Margin="0,5"
                                            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                    <Button
                                        AutomationProperties.Name="About"
                                        Click="AboutMenuItem_Click"
                                        Style="{StaticResource OverflowMenuButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource OverflowMenuIconChipStyle}">
                                                <FontIcon Style="{StaticResource OverflowMenuIconStyle}"
                                                          Foreground="#FF85A8DB"
                                                          Glyph="&#xE946;"/>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Tag="MenuTitleAbout"
                                                       VerticalAlignment="Center"
                                                       Text="About"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid
                            x:Name="OutsideActiveHoursBanner"
                            Grid.Row="0"
                            Margin="0,4,0,12"
                            Padding="0,2"
                            ColumnSpacing="8"
                            Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                Glyph="&#xE7BA;" />
                            <RichTextBlock
                                Grid.Column="1"
                                FontSize="11"
                                IsTextSelectionEnabled="False"
                                TextWrapping="Wrap">
                                <Paragraph>
                                    <Run x:Name="OutsideActiveHoursMessageRun" Text="Outside active hours, scheduled snapshots are not recorded." />
                                    <Run Text=" " />
                                    <Hyperlink Click="OutsideActiveHoursSettingsLink_Click">
                                        <Run x:Name="OutsideActiveHoursLinkRun" Text="Configure hours" />
                                    </Hyperlink>
                                </Paragraph>
                            </RichTextBlock>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CaptureActionsPanel"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="9">
                            <Button
                                x:Name="TrackingButton"
                                Width="80"
                                Height="80"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Avvia il monitoraggio"
                                Background="{ThemeResource PlayerAccentBrush}"
                                BorderBrush="#D9FFFFFF"
                                BorderThickness="1"
                                Click="TrackingButton_Click"
                                CornerRadius="40"
                                Style="{StaticResource CircularActionButtonStyle}"
                                Translation="0,0,3">
                                <Button.Shadow>
                                    <ThemeShadow/>
                                </Button.Shadow>
                                <FontIcon
                                    x:Name="PlayPauseIcon"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="28"
                                    Foreground="{ThemeResource PlayerAccentGlyphBrush}"
                                    Glyph="&#xE768;"/>
                            </Button>
                            <StackPanel
                                VerticalAlignment="Center"
                                Spacing="6">
                                <Button
                                    x:Name="TakeScreenshotButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Scatta uno snapshot"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="TakeScreenshotButton_Click"
                                    CornerRadius="16"
                                    Style="{StaticResource CircularActionButtonStyle}"
                                    ToolTipService.ToolTip="Take snapshot">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{ThemeResource PlayerAccentTextBrush}"
                                        Glyph="&#xE722;"/>
                                </Button>
                                <Button
                                    x:Name="DeleteSnapshotButton"
                                    Width="32"
                                    Height="32"
                                    Padding="0"
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="Delete snapshot"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Click="DeleteSnapshotButton_Click"
                                    CornerRadius="16"
                                    Style="{StaticResource CircularActionButtonStyle}"
                                    ToolTipService.ToolTip="Delete snapshot"
                                    Visibility="Collapsed">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="14"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE74D;"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="TrackingStateText"
                                AutomationProperties.LiveSetting="Polite"
                                CharacterSpacing="100"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource PlayerAccentTextBrush}"
                                Text="IN PAUSA" />
                            <TextBlock
                                x:Name="ElapsedText"
                                FontSize="36"
                                FontWeight="Light"
                                Text="00:00" />
                            <Grid
                                x:Name="PendingSnapshotPanel"
                                Margin="0,3,0,1"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock
                                        Tag="Snapshot.DeleteAvailable"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        MaxLines="1"
                                        Text="Delete available"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="·" />
                                    <TextBlock
                                        x:Name="SnapshotDeleteCountdownText"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="00:30" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                x:Name="CurrentContextText"
                                Margin="0,3,0,0"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="Pronto a misurare il tuo tempo"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Spacing="7">
                        <Grid x:Name="ActivityTrendChart"
                                Height="24"
                                Visibility="Collapsed">
                            <Border
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Opacity="0.45" />
                            <Path
                                x:Name="ActivityTrendPath"
                                Margin="0,2,0,3"
                                AutomationProperties.Name="Attività delle ultime 24 ore"
                                Stretch="Fill"
                                Stroke="{ThemeResource PlayerAccentTextBrush}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                        </Grid>
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid Margin="0,4,4,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE765;" />
                                <StackPanel>
                                    <TextBlock Tag="KeysLabel" CharacterSpacing="80" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="KEYS" />
                                    <TextBlock x:Name="KeyCountText" FontSize="19" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="1" Width="1" Height="30" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE962;" />
                                <StackPanel>
                                    <TextBlock Tag="ClicksLabel" CharacterSpacing="80" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CLICKS" />
                                    <TextBlock x:Name="ClickCountText" FontSize="19" FontWeight="SemiBold" Text="0" />
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Grid.Column="3" Width="1" Height="30" VerticalAlignment="Center" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE823;" />
                                <StackPanel>
                                    <TextBlock Tag="ActiveLabel" CharacterSpacing="80" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ACTIVE" />
                                    <TextBlock x:Name="ActiveTimeText" FontSize="19" FontWeight="SemiBold" Text="0 min" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button
                        x:Name="DetailsButton"
                        Grid.Row="2"
                        MinHeight="36"
                        Margin="0,2,0,0"
                        Padding="2,8"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Mostra ultima sessione"
                        Background="Transparent"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Click="DetailsButton_Click"
                        CornerRadius="0"
                        ToolTipService.ToolTip="Ultima sessione">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Tag="LastSessionTitle"
                                VerticalAlignment="Center"
                                CharacterSpacing="100"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="LAST SESSION" />
                            <FontIcon
                                x:Name="DetailsChevron"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <Grid x:Name="DetailsPanel" Grid.Row="3" RowSpacing="8" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Height="92" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="104" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,12,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="28"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE7F4;" />
                            <Grid Grid.Column="1" Height="92">
                                <StackPanel Margin="0,12,0,0" Spacing="2">
                                    <TextBlock
                                        x:Name="LastSessionAppText"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        MaxLines="1"
                                        Text="No session recorded"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="LastSessionDetailText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="ScreenshotStatusText"
                                    Margin="0,0,0,2"
                                    VerticalAlignment="Bottom"
                                    Tag="Screenshot.Status.Off"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    MaxLines="1"
                                    Text="Screenshot off"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Button
                                x:Name="ScreenshotPreviewButton"
                                Grid.Column="2"
                                Width="104"
                                Height="92"
                                Padding="0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Apri galleria screenshot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Click="ScreenshotPreviewButton_Click"
                                PointerEntered="ScreenshotPreviewButton_PointerEntered"
                                PointerExited="ScreenshotPreviewButton_PointerExited"
                                ToolTipService.ToolTip="Apri galleria screenshot">
                                <Border
                                    Width="104"
                                    Height="92"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border CornerRadius="8">
                                        <Grid>
                                            <Image
                                                x:Name="ScreenshotPlaceholderImage"
                                                AutomationProperties.Name="Snapshot placeholder"
                                                Source="ms-appx:///Assets/TrackMeUpSnapshotPlaceholder.png"
                                                Stretch="UniformToFill" />
                                            <Image
                                                x:Name="LastScreenshotImage"
                                                AutomationProperties.Name="Latest snapshot"
                                                ImageFailed="LastScreenshotImage_ImageFailed"
                                                Stretch="UniformToFill"
                                                Visibility="Collapsed" />
                                            <Border
                                                x:Name="ScreenshotOpenOverlay"
                                                Width="27"
                                                Height="27"
                                                Margin="0,0,6,6"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                IsHitTestVisible="False"
                                                Opacity="0">
                                                <FontIcon
                                                    AutomationProperties.AccessibilityView="Raw"
                                                    FontFamily="Segoe Fluent Icons"
                                                    FontSize="13"
                                                    Glyph="&#xE8A7;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Border>
                            </Button>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="LocalTimeText"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Local time"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="0.82"
                                    Text="Local time --:--:--" />
                                <TextBlock
                                    x:Name="UtcTimeText"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.Name="UTC time"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="0.82"
                                    Text="UTC --:--:--" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="OptionsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OptionsControl x:Name="OptionsControl" BackRequested="OptionsControl_BackRequested" />
        </Border>

        <Border
            x:Name="OperationsPanel"
            Grid.Row="1"
            Margin="12"
            Padding="16"
            Background="Transparent"
            Visibility="Collapsed">
            <controls:OperationsControl x:Name="OperationsControl" BackRequested="OperationsControl_BackRequested" />
        </Border>

        <Border
            x:Name="AboutPanel"
            Grid.Row="1"
            Margin="12"
            Padding="22"
            Background="Transparent"
            Visibility="Collapsed">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <StackPanel Padding="0,0,6,0" Spacing="12">
                    <Button
                        MinWidth="44"
                        MinHeight="44"
                        Padding="8"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Torna al player"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="AboutBackButton_Click"
                        >
                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                    </Button>
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="TRACK ME UP" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Personal activity player" TextWrapping="Wrap" />
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Tag="About.Description" Style="{StaticResource BodyTextBlockStyle}" Text="A local activity player for understanding time, applications and work rhythm. Typed content is never recorded; snapshots and OpenAI are always opt-in." TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="MVP · MIT License" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border
            x:Name="TrackingStatusToast"
            Grid.Row="1"
            Margin="0,18,18,0"
            Padding="10,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.LiveSetting="Polite"
            AutomationProperties.Name="Stato monitoraggio"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Canvas.ZIndex="10"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Border.Background>
                <AcrylicBrush FallbackColor="#E0173148" TintColor="#FF173148" TintLuminosityOpacity="0.46" TintOpacity="0.72" />
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="9">
                <Image Width="28" Height="28" AutomationProperties.AccessibilityView="Raw" Source="ms-appx:///Assets/TrackMeUpSquare44Logo.png" />
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="TrackingStatusToastText" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock FontSize="9" Foreground="#D9FFFFFF" Text="Local activity player" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
