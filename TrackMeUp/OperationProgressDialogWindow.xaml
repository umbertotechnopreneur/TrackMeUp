<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.OperationProgressDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleDragRegion" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource TrackMeUpTitleBarLogoStyle}" />
            <TextBlock
                x:Name="DialogTitleText"
                Grid.Column="2"
                Margin="10,0,12,0"
                AutomationProperties.AccessibilityView="Raw"
                Style="{StaticResource TrackMeUpTitleBarLabelStyle}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" Padding="28,20,28,28" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    x:Name="DescriptionText"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="15"
                    LineHeight="22"
                    TextWrapping="WrapWholeWords" />
            </ScrollViewer>
            <ProgressBar
                x:Name="OperationProgress"
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                IsIndeterminate="True" />
        </Grid>
    </Grid>
</Window>
