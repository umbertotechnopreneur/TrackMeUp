<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.QuickSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp Quick Setup">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
        <Style x:Key="ProfileCardToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="174" />
            <Setter Property="Padding" Value="22,18" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="CardRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                                <ContentPresenter
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <FontIcon
                                x:Name="CheckGlyph"
                                Margin="0,17,17,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="18"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                Glyph="&#xE73E;"
                                Visibility="Collapsed" />

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="CardRoot.Opacity" Value="0.48" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="CardRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Target="CardRoot.BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}" />
                                            <Setter Target="CardRoot.BorderThickness" Value="2" />
                                            <Setter Target="CheckGlyph.Visibility" Value="Visible" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProfileFeatureTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Grid.Column="1"
                Margin="24,0,12,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="15"
                    Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                    Glyph="&#xE9D9;" />
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    CharacterSpacing="90"
                    FontSize="13"
                    FontWeight="SemiBold"
                    IsHitTestVisible="False"
                    Text="TRACK ME UP" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="34,14,34,24" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock
                    Tag="QuickSetup.Eyebrow"
                    CharacterSpacing="80"
                    FontSize="12"
                    Opacity="0.64"
                    Text="INITIAL SETUP" />
                <TextBlock
                    Tag="QuickSetup.Heading"
                    FontSize="32"
                    FontWeight="SemiBold"
                    Text="Choose your privacy level"
                    TextWrapping="WrapWholeWords" />
                <TextBlock
                    Tag="QuickSetup.Subtitle"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Four ready-to-use profiles. You can change your mind at any time."
                    TextWrapping="WrapWholeWords" />
            </StackPanel>

            <ScrollViewer
                Grid.Row="1"
                Margin="0,22,0,0"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ToggleButton
                        x:Name="CompleteProfileButton"
                        Tag="complete"
                        Click="ProfileButton_Click"
                        IsChecked="True"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Margin="0,3,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="38"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                Glyph="&#xE83D;" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Tag="QuickSetup.Profile.Complete.Title" FontSize="22" FontWeight="SemiBold" Text="Complete" />
                                    <Border
                                        Padding="8,3"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorSecondaryBrush}"
                                        CornerRadius="4">
                                        <TextBlock
                                            Tag="QuickSetup.Recommended"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                            Text="RECOMMENDED" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    Tag="QuickSetup.Profile.Complete.Subtitle"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="All features available"
                                    TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Ai" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Screenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="Automatic screenshots" />
                                    </Grid>
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                        <TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NetworkWhenNeeded" Style="{StaticResource ProfileFeatureTextStyle}" Text="Connection when needed" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="AssistedProfileButton"
                        Tag="assisted"
                        Grid.Column="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE945;" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Tag="QuickSetup.Profile.Assisted.Title" FontSize="22" FontWeight="SemiBold" Text="Assisted" />
                                <TextBlock Tag="QuickSetup.Profile.Assisted.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="AI without recording the screen" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Ai" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoScreenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="No screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NetworkWhenNeeded" Style="{StaticResource ProfileFeatureTextStyle}" Text="Connection when needed" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="LocalRecordProfileButton"
                        Tag="local-record"
                        Grid.Row="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE958;" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Tag="QuickSetup.Profile.LocalRecord.Title" FontSize="22" FontWeight="SemiBold" Text="Local record" />
                                <TextBlock Tag="QuickSetup.Profile.LocalRecord.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="A visual history only on this PC" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoAi" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features disabled" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.Screenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="Automatic screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.AlwaysOffline" Style="{StaticResource ProfileFeatureTextStyle}" Text="Always offline" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>

                    <ToggleButton
                        x:Name="EssentialOfflineProfileButton"
                        Tag="essential-offline"
                        Grid.Row="1"
                        Grid.Column="1"
                        Click="ProfileButton_Click"
                        Style="{StaticResource ProfileCardToggleButtonStyle}">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE708;" />
                            <StackPanel Grid.Column="1" Spacing="7">
                                <TextBlock Tag="QuickSetup.Profile.EssentialOffline.Title" FontSize="22" FontWeight="SemiBold" Text="Essential offline" />
                                <TextBlock Tag="QuickSetup.Profile.EssentialOffline.Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="The minimum to get started" TextWrapping="WrapWholeWords" />
                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <StackPanel Spacing="7">
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoAi" Style="{StaticResource ProfileFeatureTextStyle}" Text="AI features disabled" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.NoScreenshots" Style="{StaticResource ProfileFeatureTextStyle}" Text="No screenshots" /></Grid>
                                    <Grid ColumnSpacing="9"><Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="13" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" /><TextBlock Grid.Column="1" Tag="QuickSetup.Feature.AlwaysOffline" Style="{StaticResource ProfileFeatureTextStyle}" Text="Always offline" /></Grid>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ToggleButton>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,18,0,0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Rectangle Fill="{ThemeResource SystemControlHighlightAccentBrush}" RadiusX="2" RadiusY="2" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="SelectedProfileLabelText" FontWeight="SemiBold" Text="Selected profile:" />
                        <TextBlock x:Name="SelectedProfileNameText" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" Text="Complete" />
                    </StackPanel>
                    <TextBlock
                        x:Name="SelectedProfileDescriptionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="AI and screenshots enabled. Content is sent to the AI provider only when an AI feature is used."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="ApplyInfoBar"
                Grid.Row="3"
                Margin="0,12,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Grid Grid.Row="4" Margin="0,18,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="StartWithWindowsCheckBox"
                    Tag="QuickSetup.StartWithWindows"
                    VerticalAlignment="Center"
                    Content="Start TrackMeUp when I sign in to Windows" />
                <Button
                    x:Name="CancelButton"
                    Tag="QuickSetup.Back"
                    Grid.Column="1"
                    MinWidth="126"
                    MinHeight="42"
                    Click="CancelButton_Click"
                    Content="Back" />
                <Button
                    x:Name="PrimaryButton"
                    Grid.Column="2"
                    MinWidth="148"
                    MinHeight="42"
                    Click="PrimaryButton_Click"
                    Content="Start"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
