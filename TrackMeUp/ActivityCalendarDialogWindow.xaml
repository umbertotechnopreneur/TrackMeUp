<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ActivityCalendarDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Grid.Column="1"
                Margin="22,0"
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            x:Name="DialogBody"
            Grid.Row="1"
            Padding="34,12,34,26"
            RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Margin="0,4,0,0"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="22"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="&#xE787;" />
                <StackPanel
                    Grid.Column="1"
                    Spacing="5">
                    <TextBlock
                        x:Name="DialogEyebrowText"
                        CharacterSpacing="150"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        FontSize="11"
                        FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="DialogTitleText"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="28"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="DialogSubtitleText"
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="14"
                        LineHeight="22"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="11*" />
                    <ColumnDefinition Width="9*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="CalendarPanel"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CalendarView
                        x:Name="ActivityCalendarView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Activity calendar"
                        CalendarViewDayItemChanging="ActivityCalendarView_CalendarViewDayItemChanging"
                        DoubleTapped="ActivityCalendarView_DoubleTapped"
                        IsGroupLabelVisible="True"
                        IsDoubleTapEnabled="True"
                        IsOutOfScopeEnabled="False"
                        IsTodayHighlighted="True"
                        NumberOfWeeksInView="6"
                        SelectedDatesChanged="ActivityCalendarView_SelectedDatesChanged"
                        SelectionMode="Single" />
                    <StackPanel
                        Grid.Row="1"
                        Margin="12,10,12,0"
                        Spacing="3">
                        <TextBlock
                            x:Name="CalendarLegendText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="CalendarHintText"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            FontSize="12"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                </Grid>

                <Border
                    x:Name="DayDetailsBorder"
                    Grid.Column="1"
                    Padding="30,4,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <StackPanel Spacing="14">
                        <TextBlock
                            x:Name="SelectedDateText"
                            FontSize="21"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="DayStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel
                            x:Name="DayMetricsPanel"
                            Spacing="14"
                            Visibility="Collapsed">
                            <StackPanel Spacing="7">
                                <TextBlock
                                    x:Name="ScoreLabelText"
                                    CharacterSpacing="90"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        x:Name="ScoreValueText"
                                        FontFamily="Consolas"
                                        FontSize="46"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,7"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="16"
                                        Text="/ 100" />
                                </StackPanel>
                                <ProgressBar
                                    x:Name="ScoreProgressBar"
                                    Height="4"
                                    Maximum="100"
                                    Minimum="0" />
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid
                                ColumnSpacing="12"
                                RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ActiveTimeLabelText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveTimeValueText" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="IdleTimeLabelText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="IdleTimeValueText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrackedTimeLabelText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TrackedTimeValueText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="KeyPressesLabelText" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="KeyPressesValueText" Grid.Row="3" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="MouseClicksLabelText" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MouseClicksValueText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="SamplesLabelText" Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SamplesValueText" Grid.Row="5" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                            </Grid>

                            <StackPanel
                                x:Name="InstallationLegendSection"
                                Spacing="7">
                                <TextBlock
                                    x:Name="InstallationLegendTitleText"
                                    CharacterSpacing="90"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <ScrollViewer
                                    MaxHeight="112"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="InstallationLegendItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid
                                                    Margin="0,2,0,5"
                                                    AutomationProperties.Name="{Binding AccessibleName}"
                                                    ColumnSpacing="9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="24"
                                                        Height="24"
                                                        VerticalAlignment="Center"
                                                        Background="{Binding AccentBrush}"
                                                        CornerRadius="12">
                                                        <FontIcon
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="12"
                                                            Foreground="White"
                                                            Glyph="{Binding IconGlyph}" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="0">
                                                        <TextBlock
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Text="{Binding FriendlyName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            FontSize="11"
                                                            Text="{Binding MachineName}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>

                        <Border
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0" />

                        <Button
                            x:Name="OpenGalleryButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OpenGalleryButton_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="&#xE8B9;" />
                                <TextBlock
                                    x:Name="OpenGalleryButtonText"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ReprocessAiButton"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="ReprocessAiButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="15"
                                    Glyph="&#xE895;" />
                                <TextBlock
                                    x:Name="ReprocessAiButtonText"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="StatusPanel"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Spacing="12">
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        IsActive="True" />
                    <FontIcon
                        x:Name="StatusIcon"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="28"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="CloseButton"
                    MinWidth="96"
                    Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
