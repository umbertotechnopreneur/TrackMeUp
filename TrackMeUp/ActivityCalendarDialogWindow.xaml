<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ActivityCalendarDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0"
            Padding="22,0">
            <TextBlock
                VerticalAlignment="Center"
                CharacterSpacing="150"
                FontSize="12"
                FontWeight="SemiBold"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            x:Name="DialogBody"
            Grid.Row="1"
            Padding="26,8,26,24"
            RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Width="38"
                    Height="38"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="20"
                    Foreground="#FF7D9FF8"
                    Glyph="&#xE787;" />
                <StackPanel
                    Grid.Column="1"
                    Spacing="3">
                    <TextBlock
                        x:Name="DialogTitleText"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="22"
                        FontWeight="SemiBold"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="DialogSubtitleText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        LineHeight="20"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="1"
                ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="CalendarPanel"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CalendarView
                        x:Name="ActivityCalendarView"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Activity calendar"
                        CalendarViewDayItemChanging="ActivityCalendarView_CalendarViewDayItemChanging"
                        IsGroupLabelVisible="True"
                        IsOutOfScopeEnabled="False"
                        IsTodayHighlighted="True"
                        NumberOfWeeksInView="6"
                        SelectedDatesChanged="ActivityCalendarView_SelectedDatesChanged"
                        SelectionMode="Single" />
                    <TextBlock
                        x:Name="CalendarLegendText"
                        Grid.Row="1"
                        Margin="12,8,12,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12"
                        TextWrapping="WrapWholeWords" />
                </Grid>

                <Border
                    x:Name="DayDetailsBorder"
                    Grid.Column="1"
                    Padding="24,2,0,0"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="SelectedDateText"
                            FontSize="18"
                            FontWeight="SemiBold"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            x:Name="DayStatusText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="20"
                            TextWrapping="WrapWholeWords" />

                        <StackPanel
                            x:Name="DayMetricsPanel"
                            Spacing="14"
                            Visibility="Collapsed">
                            <StackPanel Spacing="6">
                                <TextBlock
                                    x:Name="ScoreLabelText"
                                    CharacterSpacing="90"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold" />
                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <TextBlock
                                        x:Name="ScoreValueText"
                                        FontFamily="Consolas"
                                        FontSize="42"
                                        FontWeight="SemiBold" />
                                    <TextBlock
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,0,7"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        FontSize="16"
                                        Text="/ 100" />
                                </StackPanel>
                                <ProgressBar
                                    x:Name="ScoreProgressBar"
                                    Height="4"
                                    Maximum="100"
                                    Minimum="0" />
                            </StackPanel>

                            <Border
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" />

                            <Grid
                                ColumnSpacing="12"
                                RowSpacing="11">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ActiveTimeLabelText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ActiveTimeValueText" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="IdleTimeLabelText" Grid.Row="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="IdleTimeValueText" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="TrackedTimeLabelText" Grid.Row="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="TrackedTimeValueText" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="KeyPressesLabelText" Grid.Row="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="KeyPressesValueText" Grid.Row="3" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="MouseClicksLabelText" Grid.Row="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="MouseClicksValueText" Grid.Row="4" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                                <TextBlock x:Name="SamplesLabelText" Grid.Row="5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="SamplesValueText" Grid.Row="5" Grid.Column="1" FontFamily="Consolas" FontWeight="SemiBold" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel
                    x:Name="StatusPanel"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="420"
                    Spacing="12">
                    <ProgressRing
                        x:Name="LoadingRing"
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        IsActive="True" />
                    <FontIcon
                        x:Name="StatusIcon"
                        HorizontalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="28"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Glyph="&#xEA39;"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Grid>

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="CloseButton"
                    MinWidth="96"
                    Click="CloseButton_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
