<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="TrackMeUp.Controls.ScreenshotCoverFlowControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	MinHeight="340"
	AutomationProperties.Name="Screenshot cover flow"
	IsTabStop="True"
	UseSystemFocusVisuals="True">
	<UserControl.Resources>
		<Style x:Key="CoverFlowSlotButtonStyle" TargetType="Button">
			<Setter Property="Padding" Value="5" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
			<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="UseSystemFocusVisuals" Value="True" />
		</Style>
		<Style x:Key="CoverFlowNavigationButtonStyle" TargetType="Button">
			<Setter Property="Width" Value="52" />
			<Setter Property="Height" Value="52" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
			<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="26" />
			<Setter Property="UseSystemFocusVisuals" Value="True" />
		</Style>
	</UserControl.Resources>

	<Grid
		x:Name="InteractionSurface"
		Background="Transparent"
		SizeChanged="InteractionSurface_SizeChanged">
		<Grid
			x:Name="SlotsHost"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch" />
		<Button
			x:Name="PreviousButton"
			Margin="22,0,0,0"
			HorizontalAlignment="Left"
			VerticalAlignment="Center"
			AutomationProperties.Name="Previous screenshot"
			Canvas.ZIndex="200"
			Click="PreviousButton_Click"
			Style="{StaticResource CoverFlowNavigationButtonStyle}">
			<FontIcon
				AutomationProperties.AccessibilityView="Raw"
				FontFamily="Segoe Fluent Icons"
				FontSize="18"
				Glyph="&#xE72B;" />
		</Button>
		<Button
			x:Name="NextButton"
			Margin="0,0,22,0"
			HorizontalAlignment="Right"
			VerticalAlignment="Center"
			AutomationProperties.Name="Next screenshot"
			Canvas.ZIndex="200"
			Click="NextButton_Click"
			Style="{StaticResource CoverFlowNavigationButtonStyle}">
			<FontIcon
				AutomationProperties.AccessibilityView="Raw"
				FontFamily="Segoe Fluent Icons"
				FontSize="18"
				Glyph="&#xE72A;" />
		</Button>
	</Grid>
</UserControl>
