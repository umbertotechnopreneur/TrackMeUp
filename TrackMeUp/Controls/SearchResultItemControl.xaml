<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.SearchResultItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">
    <UserControl.Resources>
        <SolidColorBrush x:Key="SearchResultAccentBrush" Color="#FFFF8C78" />
        <SolidColorBrush x:Key="SearchResultHighlightBrush" Color="#FFFFC7BA" />
        <SolidColorBrush x:Key="SearchResultHighlightTextBrush" Color="#FF2E1712" />
    </UserControl.Resources>

    <Border
        MinHeight="180"
        Padding="12,12,14,12"
        AutomationProperties.Name="{Binding ActiveWindowDisplay}"
        Background="Transparent"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,0,1">
        <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SnapshotThumbnailFrame"
                Width="260"
                Height="146"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="8"
                PointerEntered="SnapshotThumbnailFrame_PointerEntered"
                PointerExited="SnapshotThumbnailFrame_PointerExited"
                Translation="0,0,4">
                <Border.TranslationTransition>
                    <Vector3Transition Duration="0:0:0.16" />
                </Border.TranslationTransition>
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <Grid>
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="30"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xEB9F;" />
                    <Image
                        AutomationProperties.AccessibilityView="Raw"
                        Source="{Binding ScreenshotUri}"
                        Stretch="Uniform" />
                </Grid>
            </Border>

            <Grid
                Grid.Column="1"
                VerticalAlignment="Center"
                ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="3"
                    Height="64"
                    VerticalAlignment="Top"
                    Background="{StaticResource SearchResultAccentBrush}"
                    CornerRadius="2" />

                <Grid Grid.Column="1" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="SnippetText"
                        MaxLines="2"
                        FontSize="16"
                        LineHeight="22"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <StackPanel Grid.Row="1" Spacing="3">
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding CapturedAtDisplay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding ActiveWindowDisplay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="13"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{Binding TelemetryDisplay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>

            <FontIcon
                Grid.Column="2"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe Fluent Icons"
                FontSize="18"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE76C;" />
        </Grid>
    </Border>
</UserControl>
