<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.WorldClockRailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls">
    <Grid
        x:Name="RailRoot"
        Margin="0"
        AutomationProperties.LandmarkType="Custom"
        Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AddClockHost" Margin="2,0,3,7">
                <Button
                    x:Name="AddClockButton"
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Add clock"
                    Background="#14FFFFFF"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    Click="AddClockButton_Click"
                    CornerRadius="18"
                    FocusVisualPrimaryBrush="#A0FF9B82"
                    FocusVisualPrimaryThickness="1"
                    FocusVisualSecondaryBrush="Transparent"
                    FocusVisualSecondaryThickness="0"
                    Padding="0"
                    ToolTipService.ToolTip="Add clock">
                    <Grid Width="16" Height="16" AutomationProperties.AccessibilityView="Raw">
                        <Rectangle Width="16" Height="1.8" Fill="White" RadiusX="0.9" RadiusY="0.9" />
                        <Rectangle Width="1.8" Height="16" Fill="White" RadiusX="0.9" RadiusY="0.9" />
                    </Grid>
                </Button>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Enabled">
                <ItemsControl x:Name="ClockItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ClockCard"
                                MinHeight="{Binding MinimumHeight}"
                                BorderThickness="0"
                                CornerRadius="0"
                                PointerEntered="ClockCard_PointerEntered"
                                PointerExited="ClockCard_PointerExited">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding SkylineImage}" Stretch="UniformToFill" />
                                </Border.Background>
                                <Grid>
                                    <Border CornerRadius="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F216181B" Offset="0" />
                                                <GradientStop Color="#D6171A1E" Offset="0.55" />
                                                <GradientStop Color="#9A101317" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Ellipse
                                        Width="150"
                                        Height="150"
                                        Margin="0,-64,-58,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Fill="{Binding AmbientGlowBrush}"
                                        IsHitTestVisible="False"
                                        Opacity="0.46" />

                                    <StackPanel Padding="0,12,0,13" Spacing="8">
                                        <Grid Margin="14,0,14,0" MinHeight="150" Visibility="{Binding HeroVisibility}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="118" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock
                                                    MaxWidth="155"
                                                    CharacterSpacing="80"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F3FFFFFF"
                                                    HorizontalAlignment="Left"
                                                    Text="{Binding CityName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel
                                                    x:Name="HeroClockActions"
                                                    Margin="0,1,1,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False"
                                                    Opacity="0"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        Width="30"
                                                        Height="30"
                                                        AutomationProperties.Name="{Binding DetailAccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DetailButton_Click"
                                                        CornerRadius="15"
                                                        GotFocus="ClockActionButton_GotFocus"
                                                        LostFocus="ClockActionButton_LostFocus"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="{Binding DetailAccessibleName}">
                                                        <FontIcon
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="16"
                                                            Foreground="#E8FFFFFF"
                                                            Glyph="&#xE946;" />
                                                    </Button>
                                                    <Button
                                                        Width="30"
                                                        Height="30"
                                                        AutomationProperties.Name="{Binding RemoveAccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="RemoveButton_Click"
                                                        CornerRadius="15"
                                                        GotFocus="ClockActionButton_GotFocus"
                                                        LostFocus="ClockActionButton_LostFocus"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="{Binding RemoveAccessibleName}">
                                                        <SymbolIcon Foreground="#E8FFFFFF" Symbol="Delete" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock
                                                        FontFamily="Segoe UI Variable Display"
                                                        FontSize="36"
                                                        FontWeight="Light"
                                                        Foreground="White"
                                                        Text="{Binding LocalTimeText}" />
                                                    <TextBlock
                                                        CharacterSpacing="90"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding DayStateBrush}"
                                                        Text="{Binding DayStateText}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1" Width="120" Height="118">
                                                    <Ellipse
                                                        Width="116"
                                                        Height="116"
                                                        Stroke="#48FFFFFF"
                                                        StrokeDashArray="1.2,5"
                                                        StrokeThickness="1" />
                                                    <Ellipse
                                                        Width="96"
                                                        Height="96"
                                                        Stroke="#24FFFFFF"
                                                        StrokeThickness="1" />
                                                    <Ellipse
                                                        Width="7"
                                                        Height="7"
                                                        Margin="0,10,2,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Fill="{Binding DayStateBrush}" />
                                                    <controls:CelestialPhaseControl
                                                        Width="116"
                                                        Height="116"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IsDaylight="{Binding IsDaylight}"
                                                        MoonPhaseAngleDegrees="{Binding MoonPhaseAngleDegrees}" />
                                                </Grid>
                                            </Grid>

                                            <Grid Grid.Row="2" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontSize="10" Foreground="#C8FFFFFF" Text="{Binding SunTimesText}" />
                                                <TextBlock Grid.Column="1" FontSize="10" Foreground="#AFCBD6E6" Text="{Binding MoonSummaryText}" />
                                            </Grid>
                                        </Grid>

                                        <Grid Margin="14,0,14,0" MinHeight="86" Visibility="{Binding CompactVisibility}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="82" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    MaxWidth="150"
                                                    CharacterSpacing="70"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#F2FFFFFF"
                                                    Text="{Binding CityName}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontFamily="Segoe UI Variable Display"
                                                    FontSize="31"
                                                    FontWeight="Light"
                                                    Foreground="White"
                                                    Text="{Binding LocalTimeText}" />
                                                <TextBlock
                                                    CharacterSpacing="80"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding DayStateBrush}"
                                                    Text="{Binding DayStateText}" />
                                            </StackPanel>
                                            <Grid Grid.Column="1" Width="82" Height="82">
                                                <Ellipse
                                                    Width="78"
                                                    Height="78"
                                                    Stroke="#42FFFFFF"
                                                    StrokeDashArray="1,4"
                                                    StrokeThickness="1" />
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    Margin="0,7,1,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Fill="{Binding DayStateBrush}" />
                                                <controls:CelestialPhaseControl
                                                    Width="70"
                                                    Height="70"
                                                    IsDaylight="{Binding IsDaylight}"
                                                    MoonPhaseAngleDegrees="{Binding MoonPhaseAngleDegrees}" />
                                                <StackPanel
                                                    x:Name="CompactClockActions"
                                                    Margin="0,1,1,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    IsHitTestVisible="False"
                                                    Opacity="0"
                                                    Orientation="Horizontal"
                                                    Spacing="3">
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        AutomationProperties.Name="{Binding DetailAccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DetailButton_Click"
                                                        CornerRadius="14"
                                                        GotFocus="ClockActionButton_GotFocus"
                                                        LostFocus="ClockActionButton_LostFocus"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="{Binding DetailAccessibleName}">
                                                        <FontIcon
                                                            AutomationProperties.AccessibilityView="Raw"
                                                            FontFamily="Segoe Fluent Icons"
                                                            FontSize="15"
                                                            Foreground="#E8FFFFFF"
                                                            Glyph="&#xE946;" />
                                                    </Button>
                                                    <Button
                                                        Width="28"
                                                        Height="28"
                                                        AutomationProperties.Name="{Binding RemoveAccessibleName}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="RemoveButton_Click"
                                                        CornerRadius="14"
                                                        GotFocus="ClockActionButton_GotFocus"
                                                        LostFocus="ClockActionButton_LostFocus"
                                                        Padding="0"
                                                        ToolTipService.ToolTip="{Binding RemoveAccessibleName}">
                                                        <SymbolIcon Foreground="#E8FFFFFF" Symbol="Delete" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>

                                        <StackPanel
                                            Padding="0,9,0,8"
                                            Spacing="5"
                                            Visibility="{Binding DetailsVisibility}">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="2">
                                                    <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#FFFF9B82" Text="{Binding SunDetailTitle}" />
                                                    <TextBlock FontSize="9" Foreground="#D8FFFFFF" Text="{Binding SunriseText}" />
                                                    <TextBlock FontSize="9" Foreground="#D8FFFFFF" Text="{Binding SunsetText}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="#FF9B94FF" Text="{Binding MoonDetailTitle}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="9" Foreground="#D8FFFFFF" Text="{Binding MoonriseText}" />
                                                    <TextBlock FontSize="9" Foreground="#D8FFFFFF" Text="{Binding MoonsetText}" />
                                                </StackPanel>
                                            </Grid>
                                            <controls:DaylightArcControl
                                                CurrentHour="{Binding CurrentHour}"
                                                IsDaylight="{Binding IsDaylight}"
                                                SunriseHour="{Binding SunriseHour}"
                                                SunsetHour="{Binding SunsetHour}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

    </Grid>
</UserControl>
