<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.TimedInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrackMeUp"
    MaxWidth="620"
    HorizontalAlignment="Stretch"
    VerticalContentAlignment="Top"
    Visibility="Collapsed">
    <Grid
        x:Name="BannerSurface"
        Opacity="0"
        VerticalAlignment="Top">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>
        <InfoBar
            x:Name="BannerInfoBar"
            AutomationProperties.LiveSetting="Polite"
            Closing="BannerInfoBar_Closing"
            CornerRadius="14"
            IsClosable="True"
            IsOpen="False"
            MinHeight="82"
            Padding="6,4,6,10"
            local:InfoBarElevationBehavior.IsEnabled="False" />
        <ProgressBar
            x:Name="CountdownProgress"
            Canvas.ZIndex="1"
            Height="2"
            Margin="16,0,16,8"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            AutomationProperties.AccessibilityView="Raw"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            CornerRadius="1"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Maximum="100"
            Minimum="0"
            Opacity="0.72"
            Value="0" />
    </Grid>
</UserControl>
