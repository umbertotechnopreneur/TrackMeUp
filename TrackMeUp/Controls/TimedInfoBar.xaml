<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.TimedInfoBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrackMeUp"
    MaxWidth="620"
    HorizontalAlignment="Stretch"
    VerticalContentAlignment="Top"
    Visibility="Collapsed">
    <Grid
        x:Name="BannerSurface"
        MaxWidth="620"
        Opacity="0"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Top">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>
        <Border
            x:Name="BannerFrame"
            BorderBrush="{ThemeResource ToastBorderBrush}"
            BorderThickness="1"
            CornerRadius="16">
            <Grid>
                <InfoBar
                    x:Name="BannerInfoBar"
                    AutomationProperties.LiveSetting="Polite"
                    BorderThickness="0"
                    Closing="BannerInfoBar_Closing"
                    CornerRadius="15"
                    IsClosable="True"
                    IsOpen="False"
                    MinHeight="82"
                    Padding="6,4,6,14"
                    local:InfoBarElevationBehavior.IsEnabled="False" />
                <Border
                    x:Name="CountdownTrack"
                    Margin="18,0,18,9"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource ToastCountdownTrackBrush}"
                    CornerRadius="2"
                    IsHitTestVisible="False">
                    <ProgressBar
                        x:Name="CountdownProgress"
                        Height="3"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AccessibilityView="Raw"
                        Background="Transparent"
                        CornerRadius="2"
                        Foreground="{ThemeResource ToastCountdownForegroundBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="0" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
