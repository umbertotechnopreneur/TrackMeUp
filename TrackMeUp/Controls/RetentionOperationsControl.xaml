<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.RetentionOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid>
        <ProgressRing x:Name="Progress" Canvas.ZIndex="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />

        <StackPanel x:Name="SectionBody" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock Tag="Operations.Retention" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Data retention" />
                <TextBlock Tag="Operations.Retention.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Review local retention rules, preview eligible items, then choose whether to permanently delete them. Preview never deletes data; deletion always asks for confirmation." TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Tag="Operations.Retention.Policy" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="1 · Current criteria" />
                    <TextBlock
                        Tag="Operations.Retention.Policy.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Loads the configured retention periods and local screen-capture folder."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button Tag="Operations.Retention.LoadPolicyAction" Click="RetentionStatusButton_Click" Content="Load current criteria" HorizontalAlignment="Left" />
                <TextBlock x:Name="RetentionStatusText" Tag="Operations.Initial.Retention" IsTextSelectionEnabled="True" Text="Policy not loaded yet." TextWrapping="Wrap" />
                <StackPanel Spacing="2">
                    <TextBlock Tag="Operations.Retention.Directory" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Screen-capture folder" />
                    <TextBlock
                        x:Name="RetentionDirectoryText"
                        Tag="Operations.Initial.RetentionDirectory"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="1"
                        Text="Load the criteria to see the folder."
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Tag="Operations.Retention.Preview" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="2 · Cleanup preview" />
                    <TextBlock
                        Tag="Operations.Retention.Preview.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Lists records and files eligible under the current criteria. This step never deletes anything."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button Tag="Operations.Retention.PreviewAction" Click="RetentionPreviewButton_Click" Content="Preview eligible deletions" HorizontalAlignment="Left" />
                <TextBlock x:Name="RetentionPreviewText" Tag="Operations.Initial.RetentionPreview" IsTextSelectionEnabled="True" Text="Preview not calculated yet." TextWrapping="Wrap" />
                <ListView
                    x:Name="RetentionPathsList"
                    MaxHeight="160"
                    AutomationProperties.Name="Eligible cleanup paths"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                AutomationProperties.Name="{Binding}"
                                FontFamily="Cascadia Mono"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                MaxLines="1"
                                Text="{Binding}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock Tag="Operations.Retention.Cleanup" AutomationProperties.HeadingLevel="Level3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="3 · Permanent deletion" />
                    <TextBlock
                        Tag="Operations.Retention.Cleanup.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Refreshes the preview, then asks for confirmation. Nothing is deleted unless you approve."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button Tag="Operations.Retention.CleanupAction" Click="RunRetentionButton_Click" Content="Review and permanently delete…" HorizontalAlignment="Left" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
