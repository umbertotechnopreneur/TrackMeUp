<UserControl x:Class="TrackMeUp.Controls.SensorTrackControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="#FFA34910"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="#FF7F399A"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="#FF007376"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="#FF1966AD"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="#FF29742F"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="#FFFFAB5E"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="#FFD594E9"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="#FF58DCD8"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="#FF6FB9FF"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="#FF8BE184"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="SensorCpuBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorMemoryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorGpuBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorStorageBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="SensorBatteryBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="Track" Padding="0,8" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" ColumnSpacing="14" RowSpacing="4" SizeChanged="Track_SizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="IconColumn" Width="32"/>
            <ColumnDefinition x:Name="NameColumn" Width="155"/>
            <ColumnDefinition x:Name="ValueColumn" Width="108"/>
            <ColumnDefinition x:Name="ChartColumn" Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="*"/><RowDefinition x:Name="GraphRow" Height="0"/></Grid.RowDefinitions>
        <FontIcon x:Name="DeviceIcon" FontFamily="Segoe Fluent Icons" FontSize="27" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
        <StackPanel x:Name="IdentityPanel" Grid.Column="1" Spacing="3" VerticalAlignment="Center">
            <TextBlock x:Name="CategoryText" FontSize="12" CharacterSpacing="80" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="NameText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel x:Name="Values" Grid.Column="2" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="ValueText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MetricDetailText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
        <StackPanel x:Name="GraphPanel" Grid.Column="3" VerticalAlignment="Center" Spacing="4">
            <Grid x:Name="TraceHost" Height="64">
                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Margin="0,0,30,0"/>
                <Canvas x:Name="TraceCanvas" Margin="0,0,30,0" SizeChanged="TraceCanvas_SizeChanged" AutomationProperties.AccessibilityView="Raw"/>
                <TextBlock Text="100%" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="0%" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="NoTraceText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
            <Border x:Name="LevelBarTrack" Height="6" CornerRadius="3" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Visibility="Collapsed" SizeChanged="LevelBarTrack_SizeChanged" AutomationProperties.AccessibilityView="Raw">
                <Border x:Name="LevelBarFill" HorizontalAlignment="Left" CornerRadius="3"/>
            </Border>
            <TextBlock x:Name="CapacityText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="SecondaryText" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
