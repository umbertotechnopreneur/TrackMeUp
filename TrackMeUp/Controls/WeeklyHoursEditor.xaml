<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.WeeklyHoursEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Day" />
            <Grid Grid.Column="1" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="00" />
                <TextBlock Grid.Column="1" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="06" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="12" />
                <TextBlock Grid.Column="3" HorizontalAlignment="Left" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="18" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="24" />
            </Grid>
        </Grid>
        <ScrollViewer
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <StackPanel x:Name="DaysHost" Spacing="4" />
        </ScrollViewer>
        <TextBlock
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Click or drag across 30-minute blocks. Selected blocks are active hours; gaps inside an active period are breaks."
            TextWrapping="Wrap" />
    </StackPanel>
</UserControl>