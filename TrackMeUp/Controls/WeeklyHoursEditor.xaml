<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.WeeklyHoursEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ScheduleCardBackgroundBrush" Color="#08000000" />
                    <SolidColorBrush x:Key="ScheduleCardBorderBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="ScheduleCellBorderBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="ScheduleCellHoverBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="ScheduleCellPressedBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="ScheduleSummaryTextBrush" Color="#FF007C91" />
                    <SolidColorBrush x:Key="ScheduleWeekendCardBackgroundBrush" Color="#0EDB4B32" />
                    <SolidColorBrush x:Key="ScheduleWeekendCardBorderBrush" Color="#42B43B2C" />
                    <SolidColorBrush x:Key="ScheduleWeekendTextBrush" Color="#FF9A3328" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ScheduleCardBackgroundBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCardBorderBrush" Color="#2EFFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellBorderBrush" Color="#2BFFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellHoverBrush" Color="#16FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleCellPressedBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="ScheduleSummaryTextBrush" Color="#FF58D2E8" />
                    <SolidColorBrush x:Key="ScheduleWeekendCardBackgroundBrush" Color="#16FF6B4F" />
                    <SolidColorBrush x:Key="ScheduleWeekendCardBorderBrush" Color="#56FF7964" />
                    <SolidColorBrush x:Key="ScheduleWeekendTextBrush" Color="#FFFF806C" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ScheduleCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScheduleCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScheduleCellBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScheduleCellHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleCellPressedBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleSummaryTextBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="ScheduleWeekendCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScheduleWeekendCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScheduleWeekendTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScheduleDayCardStyle" TargetType="Border">
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="8,10,8,8" />
                <Setter Property="Background" Value="{ThemeResource ScheduleCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style
                x:Key="ScheduleWeekendDayCardStyle"
                BasedOn="{StaticResource ScheduleDayCardStyle}"
                TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ScheduleWeekendCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleWeekendCardBorderBrush}" />
            </Style>
            <Style x:Key="ScheduleDayLabelStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>
            <Style
                x:Key="ScheduleWeekendDayLabelStyle"
                BasedOn="{StaticResource ScheduleDayLabelStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ScheduleWeekendTextBrush}" />
            </Style>
            <Style x:Key="ScheduleTimeLabelStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="ScheduleSummaryFooterStyle" TargetType="Border">
                <Setter Property="Margin" Value="-8,8,-8,-8" />
                <Setter Property="Padding" Value="8,8" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <Style
                x:Key="ScheduleWeekendSummaryFooterStyle"
                BasedOn="{StaticResource ScheduleSummaryFooterStyle}"
                TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource ScheduleWeekendCardBorderBrush}" />
            </Style>
            <Style x:Key="ScheduleSummaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ScheduleSummaryTextBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style
                x:Key="ScheduleWeekendSummaryTextStyle"
                BasedOn="{StaticResource ScheduleSummaryTextStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource ScheduleWeekendTextBrush}" />
            </Style>
            <Style x:Key="ScheduleSlotStyle" TargetType="ToggleButton">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid Background="Transparent">
                                <Border
                                    x:Name="SelectionIndicator"
                                    Margin="1"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource ScheduleCellBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleCellHoverBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource ScheduleCellPressedBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                        <VisualState x:Name="Checked">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionIndicator" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource AccentFillColorDisabledBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer
            x:Name="DaysScrollViewer"
            MinHeight="0"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalAlignment="Top"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Enabled">
            <Grid
                x:Name="DaysHost"
                MinHeight="0"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                SizeChanged="DaysHost_SizeChanged" />
        </ScrollViewer>

        <TextBlock
            Grid.Row="1"
            Margin="5,0"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Tag="Schedule.Week.Instructions"
            Text="Click or drag across 15-minute blocks. Selected blocks are active hours; gaps inside an active period are breaks."
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
