<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.PrivacyOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="520"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <InfoBar x:Name="StatusInfoBar" AutomationProperties.LiveSetting="Polite" IsClosable="True" IsOpen="False" />
            <ProgressRing x:Name="Progress" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />
        </Grid>

        <StackPanel x:Name="SectionBody" Grid.Row="1" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Tag="Operations.Privacy" Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy" />
                <TextBlock Tag="Operations.Privacy.Description" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Define local rules that prevent sensitive app, window, or context details from being captured." TextWrapping="Wrap" />
            </StackPanel>

            <ComboBox x:Name="PrivacyRuleTypeBox" Tag="Operations.PrivacyType" HorizontalAlignment="Stretch" Header="Rule type" SelectedIndex="0">
                <ComboBoxItem Content="Process" Tag="process" />
                <ComboBoxItem Content="Window title" Tag="title" />
                <ComboBoxItem Content="Context" Tag="hint" />
            </ComboBox>
            <TextBox x:Name="PrivacyRuleValueBox" Tag="Operations.PrivacyValue" Header="Value" PlaceholderText="Value to block" />
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Button Tag="Operations.Add" Click="AddPrivacyRuleButton_Click" Content="Add" HorizontalAlignment="Stretch" />
                <Button Tag="Operations.Refresh" Grid.Column="1" Click="ListPrivacyRulesButton_Click" Content="Refresh" HorizontalAlignment="Stretch" />
                <Button Tag="Operations.Remove" Grid.Row="1" Click="RemovePrivacyRuleButton_Click" Content="Remove selected" HorizontalAlignment="Stretch" />
                <Button Tag="Operations.TestContext" Grid.Row="1" Grid.Column="1" Click="TestPrivacyButton_Click" Content="Test context" HorizontalAlignment="Stretch" />
            </Grid>
            <ListView x:Name="PrivacyRulesList" Height="180" AutomationProperties.Name="Configured privacy rules" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="2,5" Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Type}" />
                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="PrivacyTestText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
