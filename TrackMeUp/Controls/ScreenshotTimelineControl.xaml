<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="TrackMeUp.Controls.ScreenshotTimelineControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<LinearGradientBrush x:Key="ScreenshotTimelineSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#40FFFFFF" Offset="0" />
						<GradientStop Color="#20EAF4FF" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotTimelineBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#8CFFFFFF" Offset="0" />
						<GradientStop Color="#40FFFFFF" Offset="1" />
					</LinearGradientBrush>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<LinearGradientBrush x:Key="ScreenshotTimelineSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#5918273A" Offset="0" />
						<GradientStop Color="#3013355D" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotTimelineBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#59FFFFFF" Offset="0" />
						<GradientStop Color="#26FFFFFF" Offset="1" />
					</LinearGradientBrush>
				</ResourceDictionary>
				<ResourceDictionary x:Key="Default">
					<LinearGradientBrush x:Key="ScreenshotTimelineSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#40FFFFFF" Offset="0" />
						<GradientStop Color="#20EAF4FF" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotTimelineBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#8CFFFFFF" Offset="0" />
						<GradientStop Color="#40FFFFFF" Offset="1" />
					</LinearGradientBrush>
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<Style x:Key="TimelineNavigationButtonStyle" TargetType="Button">
				<Setter Property="Width" Value="36" />
				<Setter Property="Height" Value="36" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="18" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
			</Style>

			<Style x:Key="TimelineItemContainerStyle" TargetType="ListViewItem">
				<Setter Property="MinWidth" Value="118" />
				<Setter Property="Margin" Value="3,0" />
				<Setter Property="Padding" Value="6,5" />
				<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				<Setter Property="CornerRadius" Value="10" />
				<Setter Property="UseSystemFocusVisuals" Value="True" />
			</Style>

			<DataTemplate x:Key="ScreenshotTimelineItemTemplate">
				<StackPanel
					AutomationProperties.Name="{Binding AutomationName}"
					Spacing="3">
					<Border
						Width="106"
						Height="64"
						Padding="2"
						Background="{ThemeResource ControlFillColorDefaultBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="8">
						<Image
							x:Name="TimelineImage"
							DataContextChanged="TimelineImage_DataContextChanged"
							Loaded="TimelineImage_Loaded"
							Stretch="Uniform"
							Unloaded="TimelineImage_Unloaded" />
					</Border>
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock
							FontSize="10"
							LineHeight="14"
							Opacity="0.68"
							Text="{Binding DateText}" />
						<TextBlock
							FontSize="11"
							FontWeight="SemiBold"
							LineHeight="14"
							Text="{Binding TimeText}" />
					</StackPanel>
				</StackPanel>
			</DataTemplate>
		</ResourceDictionary>
	</UserControl.Resources>
	<StackPanel
		x:Name="FilmstripStrip"
		HorizontalAlignment="Stretch"
		Spacing="0"
		Visibility="Collapsed">
		<TextBlock
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Style="{StaticResource CaptionTextBlockStyle}"
			Tag="Screenshots.Timeline"
			Text="Timeline"
			Visibility="Collapsed" />
		<Border
			Padding="12,10"
			HorizontalAlignment="Stretch"
			Background="{ThemeResource ScreenshotTimelineSurfaceBrush}"
			BorderBrush="{ThemeResource ScreenshotTimelineBorderBrush}"
			BorderThickness="1"
			CornerRadius="12">
			<Grid x:Name="TimelineNavigationRail">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<Button
					x:Name="PreviousTimelineButton"
					Margin="0,0,8,0"
					VerticalAlignment="Center"
					AutomationProperties.Name="Scroll screenshots left"
					Click="PreviousTimelineButton_Click"
					Style="{StaticResource TimelineNavigationButtonStyle}"
					Visibility="Collapsed">
					<FontIcon
						AutomationProperties.AccessibilityView="Raw"
						FontFamily="Segoe Fluent Icons"
						FontSize="14"
						Glyph="&#xE76B;" />
				</Button>
				<ListView
					x:Name="FilmstripList"
					Grid.Column="1"
					HorizontalAlignment="Stretch"
					IsItemClickEnabled="False"
					ItemContainerStyle="{StaticResource TimelineItemContainerStyle}"
					ItemTemplate="{StaticResource ScreenshotTimelineItemTemplate}"
					Loaded="FilmstripList_Loaded"
					SelectionChanged="FilmstripList_SelectionChanged"
					SelectionMode="Single"
					ScrollViewer.HorizontalScrollBarVisibility="Hidden"
					ScrollViewer.HorizontalScrollMode="Enabled"
					ScrollViewer.VerticalScrollBarVisibility="Disabled"
					ScrollViewer.VerticalScrollMode="Disabled"
					SingleSelectionFollowsFocus="False"
					SizeChanged="FilmstripList_SizeChanged"
					TabNavigation="Once"
					Unloaded="FilmstripList_Unloaded">
					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel
								AreStickyGroupHeadersEnabled="False"
								Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>
				</ListView>
				<Button
					x:Name="NextTimelineButton"
					Grid.Column="2"
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					AutomationProperties.Name="Scroll screenshots right"
					Click="NextTimelineButton_Click"
					Style="{StaticResource TimelineNavigationButtonStyle}"
					Visibility="Collapsed">
					<FontIcon
						AutomationProperties.AccessibilityView="Raw"
						FontFamily="Segoe Fluent Icons"
						FontSize="14"
						Glyph="&#xE76C;" />
				</Button>
			</Grid>
		</Border>
		<Button
			x:Name="FilmstripToggleButton"
			Width="1"
			Height="1"
			Padding="0"
			AutomationProperties.Name="Show screenshot strip"
			Background="Transparent"
			BorderBrush="Transparent"
			Visibility="Collapsed">
			<FontIcon
				x:Name="FilmstripChevronIcon"
				AutomationProperties.AccessibilityView="Raw"
				FontFamily="Segoe Fluent Icons"
				FontSize="12"
				Glyph="&#xE70E;" />
		</Button>
	</StackPanel>
</UserControl>
