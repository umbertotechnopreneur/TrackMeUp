<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotTimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="TimelineNavigationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="TimelineItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Margin" Value="3,0" />
                <Setter Property="Padding" Value="5,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <DataTemplate x:Key="ScreenshotTimelineItemTemplate">
                <StackPanel
                    AutomationProperties.Name="{Binding AutomationName}"
                    Spacing="4">
                    <Border
                        Width="110"
                        Height="66"
                        Background="Transparent"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image
                            x:Name="TimelineImage"
                            DataContextChanged="TimelineImage_DataContextChanged"
                            Loaded="TimelineImage_Loaded"
                            Stretch="Uniform"
                            Unloaded="TimelineImage_Unloaded" />
                    </Border>
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="14"
                            Text="{Binding DateText}" />
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            LineHeight="14"
                            Text="{Binding TimeText}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        x:Name="FilmstripStrip"
        HorizontalAlignment="Stretch"
        Spacing="0"
        Visibility="Collapsed">
        <Border
            Padding="24,11,24,14"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid x:Name="TimelineNavigationRail">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousTimelineButton"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Scroll screenshots left"
                    Click="PreviousTimelineButton_Click"
                    Style="{StaticResource TimelineNavigationButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE76B;" />
                </Button>
                <ListView
                    x:Name="FilmstripList"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource TimelineItemContainerStyle}"
                    ItemTemplate="{StaticResource ScreenshotTimelineItemTemplate}"
                    Loaded="FilmstripList_Loaded"
                    SelectionChanged="FilmstripList_SelectionChanged"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SingleSelectionFollowsFocus="False"
                    SizeChanged="FilmstripList_SizeChanged"
                    TabNavigation="Once"
                    Unloaded="FilmstripList_Unloaded">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel
                                AreStickyGroupHeadersEnabled="False"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <Button
                    x:Name="NextTimelineButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Scroll screenshots right"
                    Click="NextTimelineButton_Click"
                    Style="{StaticResource TimelineNavigationButtonStyle}"
                    Visibility="Collapsed">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </Border>
        <Button
            x:Name="FilmstripToggleButton"
            Width="1"
            Height="1"
            Padding="0"
            AutomationProperties.Name="Show screenshot strip"
            Background="Transparent"
            BorderBrush="Transparent"
            Visibility="Collapsed">
            <FontIcon
                x:Name="FilmstripChevronIcon"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE70E;" />
        </Button>
    </StackPanel>
</UserControl>
