<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotTimelineControl"
    x:Name="TimelineControlRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style
                x:Key="TimelineNavigationButtonStyle"
                BasedOn="{StaticResource ScreenshotToolbarButtonStyle}"
                TargetType="Button">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="CornerRadius" Value="20" />
            </Style>

            <Style x:Key="TimelineItemContainerStyle" TargetType="ListViewItem">
                <Setter Property="MinWidth" Value="184" />
                <Setter Property="MinHeight" Value="136" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid
                                x:Name="TimelineContainerRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <ContentPresenter
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Background" Value="{ThemeResource ScreenshotChromeHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Background" Value="{ThemeResource ScreenshotChromePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected" />
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Background" Value="{ThemeResource ScreenshotChromeHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Background" Value="{ThemeResource ScreenshotChromePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Opacity" Value="0.40" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="DisabledSelected">
                                            <VisualState.Setters>
                                                <Setter Target="TimelineContainerRoot.Opacity" Value="0.40" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ScreenshotTimelineItemTemplate">
                <Grid
                    x:Name="TimelineCardRoot"
                    Width="176"
                    MinHeight="136"
                    AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="114" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="TimelineThumbnailVisual"
                        Width="142"
                        Height="90"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CenterPoint="71,45,0">
                        <Grid.ScaleTransition>
                            <Vector3Transition Duration="0:0:0.2" />
                        </Grid.ScaleTransition>
                        <Border
                            x:Name="TimelineSelectionGlow"
                            Background="{ThemeResource ScreenshotSelectionFillBrush}"
                            BorderBrush="{ThemeResource ScreenshotSelectionBorderBrush}"
                            BorderThickness="3"
                            CornerRadius="11"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16" />
                            </Border.OpacityTransition>
                        </Border>
                        <Border
                            x:Name="TimelineSelectionChrome"
                            BorderBrush="{ThemeResource ScreenshotSelectionBorderBrush}"
                            BorderThickness="2"
                            CornerRadius="9"
                            IsHitTestVisible="False"
                            Opacity="0">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.16" />
                            </Border.OpacityTransition>
                        </Border>
                        <Border
                            Width="132"
                            Height="80"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Image
                                x:Name="TimelineImage"
                                DataContextChanged="TimelineImage_DataContextChanged"
                                Loaded="TimelineImage_Loaded"
                                Stretch="Uniform"
                                Unloaded="TimelineImage_Unloaded" />
                        </Border>
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="5">
                        <Border
                            x:Name="TimelineInstallationBadge"
                            Width="18"
                            Height="18"
                            Background="{Binding InstallationBrush}"
                            CornerRadius="9">
                            <FontIcon
                                x:Name="TimelineInstallationIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="8"
                                Foreground="White"
                                Glyph="{Binding InstallationGlyph}" />
                        </Border>
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE823;" />
                        <TextBlock
                            FontSize="12"
                            FontWeight="Normal"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            LineHeight="16"
                            Text="{Binding TimeText}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        x:Name="FilmstripStrip"
        Height="168"
        HorizontalAlignment="Stretch"
        Opacity="1"
        Spacing="0"
        Visibility="Collapsed">
        <Border
            Padding="24,14,24,16"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource AcrylicInAppFillColorBaseBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid x:Name="TimelineNavigationRail">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="PreviousTimelineButton"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Previous screenshots"
                    Click="PreviousTimelineButton_Click"
                    Style="{StaticResource TimelineNavigationButtonStyle}"
                    Tag="Screenshots.Timeline.Previous"
                    ToolTipService.ToolTip="Previous screenshots"
                    Visibility="Collapsed">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE76B;" />
                </Button>
                <ListView
                    x:Name="FilmstripList"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    ContainerContentChanging="FilmstripList_ContainerContentChanging"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource TimelineItemContainerStyle}"
                    ItemTemplate="{StaticResource ScreenshotTimelineItemTemplate}"
                    Loaded="FilmstripList_Loaded"
                    SelectionChanged="FilmstripList_SelectionChanged"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SingleSelectionFollowsFocus="False"
                    SizeChanged="FilmstripList_SizeChanged"
                    TabNavigation="Once"
                    Unloaded="FilmstripList_Unloaded">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel
                                AreStickyGroupHeadersEnabled="False"
                                Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                </ListView>
                <Button
                    x:Name="NextTimelineButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Next screenshots"
                    Click="NextTimelineButton_Click"
                    Style="{StaticResource TimelineNavigationButtonStyle}"
                    Tag="Screenshots.Timeline.Next"
                    ToolTipService.ToolTip="Next screenshots"
                    Visibility="Collapsed">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xE76C;" />
                </Button>
            </Grid>
        </Border>
        <Button
            x:Name="FilmstripToggleButton"
            Width="1"
            Height="1"
            Padding="0"
            AutomationProperties.Name="Hide screenshot strip"
            Background="Transparent"
            BorderBrush="Transparent"
            Tag="Screenshots.Timeline.Hide"
            ToolTipService.ToolTip="Hide screenshot strip"
            Visibility="Collapsed">
            <FontIcon
                x:Name="FilmstripChevronIcon"
                AutomationProperties.AccessibilityView="Raw"
                FontFamily="Segoe Fluent Icons"
                FontSize="12"
                Glyph="&#xE70E;" />
        </Button>
    </StackPanel>
</UserControl>
