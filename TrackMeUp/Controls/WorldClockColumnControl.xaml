<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.WorldClockColumnControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls">
    <Grid
        x:Name="ColumnRoot"
        MinWidth="0"
        Background="Transparent"
        AutomationProperties.LandmarkType="Custom">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="WorldClockDayAccentBrush" Color="#FFE34A2C" />
                        <SolidColorBrush x:Key="WorldClockNightAccentBrush" Color="#FF6C63B7" />
                        <SolidColorBrush x:Key="WorldClockMarkerBrush" Color="#FFE34A2C" />
                        <SolidColorBrush x:Key="WorldClockCloudBrush" Color="#E8F7F8FA" />
                        <x:Double x:Key="WorldClockBackdropOpacity">0.12</x:Double>
                        <x:Double x:Key="WorldClockSkylineOpacity">0.20</x:Double>
                        <x:Double x:Key="WorldClockForegroundOpacity">0.16</x:Double>
                        <LinearGradientBrush x:Key="WorldClockSceneFadeBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#18FFFFFF" Offset="0.58" />
                            <GradientStop Color="#A8FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WorldClockDayAccentBrush" Color="#FFFF7357" />
                        <SolidColorBrush x:Key="WorldClockNightAccentBrush" Color="#FF958BEE" />
                        <SolidColorBrush x:Key="WorldClockMarkerBrush" Color="#FFFF7357" />
                        <SolidColorBrush x:Key="WorldClockCloudBrush" Color="#E6F0F3F8" />
                        <x:Double x:Key="WorldClockBackdropOpacity">0.20</x:Double>
                        <x:Double x:Key="WorldClockSkylineOpacity">0.30</x:Double>
                        <x:Double x:Key="WorldClockForegroundOpacity">0.24</x:Double>
                        <LinearGradientBrush x:Key="WorldClockSceneFadeBrush" StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00151619" Offset="0" />
                            <GradientStop Color="#18151619" Offset="0.58" />
                            <GradientStop Color="#A0151619" Offset="1" />
                        </LinearGradientBrush>
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="WorldClockDayAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                        <StaticResource x:Key="WorldClockNightAccentBrush" ResourceKey="SystemColorHighlightColorBrush" />
                        <StaticResource x:Key="WorldClockMarkerBrush" ResourceKey="SystemColorHighlightColorBrush" />
                        <StaticResource x:Key="WorldClockCloudBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <x:Double x:Key="WorldClockBackdropOpacity">0</x:Double>
                        <x:Double x:Key="WorldClockSkylineOpacity">0</x:Double>
                        <x:Double x:Key="WorldClockForegroundOpacity">0</x:Double>
                        <SolidColorBrush x:Key="WorldClockSceneFadeBrush" Color="Transparent" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="DayAccentResource"
            Background="{ThemeResource WorldClockDayAccentBrush}"
            Visibility="Collapsed" />
        <Border
            x:Name="NightAccentResource"
            Background="{ThemeResource WorldClockNightAccentBrush}"
            Visibility="Collapsed" />

        <Grid AutomationProperties.AccessibilityView="Raw">
            <Rectangle
                Width="1"
                Height="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Fill="{ThemeResource WorldClockMarkerBrush}" />
            <Ellipse
                Width="8"
                Height="8"
                Margin="0,-4,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Fill="{ThemeResource WorldClockMarkerBrush}" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,6,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                x:Name="CityNameText"
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                CharacterSpacing="80"
                FontSize="20"
                FontWeight="SemiBold"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis" />

            <TextBlock
                x:Name="LocalTimeText"
                Grid.Row="1"
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="58"
                FontWeight="Light"
                Text="00:00"
                TextAlignment="Center" />

            <TextBlock
                x:Name="OffsetText"
                Grid.Row="2"
                HorizontalAlignment="Center"
                CharacterSpacing="70"
                FontSize="12"
                FontWeight="SemiBold"
                TextAlignment="Center" />

            <TextBlock
                x:Name="DateRelationText"
                Grid.Row="3"
                Margin="0"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                Visibility="Collapsed" />

            <TextBlock
                x:Name="DayStateText"
                Grid.Row="4"
                Margin="0"
                HorizontalAlignment="Center"
                CharacterSpacing="60"
                FontSize="13"
                FontWeight="SemiBold"
                TextAlignment="Center" />

            <Grid
                x:Name="SceneGrid"
                Grid.Row="5"
                MinHeight="220"
                Margin="-24,8,-24,0"
                Background="Transparent">
                <Grid
                    x:Name="BackdropLayerHost"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="{ThemeResource WorldClockBackdropOpacity}" />
                <Image
                    x:Name="SkylineImage"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="{ThemeResource WorldClockSkylineOpacity}"
                    Stretch="Uniform" />
                <Border
                    Background="{ThemeResource WorldClockSceneFadeBrush}"
                    IsHitTestVisible="False" />
                <controls:CelestialPhaseControl
                    x:Name="CelestialPhase"
                    Width="138"
                    Height="138"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw" />
                <Grid
                    x:Name="WeatherAdornmentHost"
                    Width="58"
                    Height="32"
                    Margin="74,84,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="28"
                        Height="24"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Fill="{ThemeResource WorldClockCloudBrush}" />
                    <Ellipse
                        Width="34"
                        Height="30"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource WorldClockCloudBrush}" />
                    <Border
                        Height="18"
                        Margin="5,14,0,0"
                        Background="{ThemeResource WorldClockCloudBrush}"
                        CornerRadius="9" />
                </Grid>
                <Grid
                    x:Name="ForegroundLayerHost"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="{ThemeResource WorldClockForegroundOpacity}" />
                <StackPanel
                    x:Name="WeatherPanel"
                    MinHeight="62"
                    Margin="0,156,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Spacing="0">
                    <TextBlock
                        x:Name="WeatherTemperatureText"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="38"
                        FontWeight="Light"
                        TextAlignment="Center" />
                    <TextBlock
                        x:Name="WeatherConditionText"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid
                Grid.Row="6"
                Height="68"
                Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid HorizontalAlignment="Center" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="28"
                        Height="24"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <FontIcon
                            x:Name="SunriseIcon"
                            Margin="0,-3,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xE706;" />
                        <Rectangle
                            x:Name="SunriseHorizon"
                            Width="28"
                            Height="1"
                            VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            x:Name="SunriseLabelText"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Name="SunriseTimeText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextAlignment="Left" />
                    </StackPanel>
                </Grid>
                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    Height="40"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Grid Grid.Column="2" HorizontalAlignment="Center" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="28"
                        Height="24"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <FontIcon
                            x:Name="SunsetIcon"
                            Margin="0,-3,0,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Glyph="&#xE706;" />
                        <Rectangle
                            x:Name="SunsetHorizon"
                            Width="28"
                            Height="1"
                            VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            x:Name="SunsetLabelText"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextAlignment="Left" />
                        <TextBlock
                            x:Name="SunsetTimeText"
                            FontSize="13"
                            FontWeight="SemiBold"
                            TextAlignment="Left" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
