<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.WorldClockColumnControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls">
    <Grid
        x:Name="ColumnRoot"
        MinWidth="0"
        Background="Transparent"
        AutomationProperties.LandmarkType="Custom">
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Rectangle
            x:Name="ReferenceMarker"
            Width="28"
            Height="3"
            HorizontalAlignment="Center"
            AutomationProperties.AccessibilityView="Raw"
            Fill="#FFE85B42"
            RadiusX="1.5"
            RadiusY="1.5" />

        <Grid Grid.Row="1" Padding="24,24,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="CityNameText"
                    Grid.ColumnSpan="3"
                    Margin="0,0,68,0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    CharacterSpacing="80"
                    FontSize="18"
                    FontWeight="SemiBold"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="ReferenceButton"
                    Grid.Column="1"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Set as reference city"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ReferenceButton_Click"
                    CornerRadius="17"
                    ToolTipService.ToolTip="Set as reference city">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE718;" />
                </Button>
                <Button
                    x:Name="RemoveButton"
                    Grid.Column="2"
                    Width="34"
                    Height="34"
                    Padding="0"
                    AutomationProperties.Name="Remove city"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="RemoveButton_Click"
                    CornerRadius="17"
                    ToolTipService.ToolTip="Remove city">
                    <SymbolIcon
                        AutomationProperties.AccessibilityView="Raw"
                        Symbol="Delete" />
                </Button>
            </Grid>

            <TextBlock
                x:Name="LocalTimeText"
                Grid.Row="1"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="58"
                FontWeight="Light"
                TextAlignment="Center"
                Text="00:00" />
            <StackPanel
                Grid.Row="2"
                Margin="0,0,0,0"
                HorizontalAlignment="Center"
                Spacing="6">
                <TextBlock
                    x:Name="OffsetText"
                    CharacterSpacing="70"
                    FontSize="12"
                    FontWeight="SemiBold"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="DateRelationText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center"
                    Visibility="Collapsed" />
            </StackPanel>
            <TextBlock
                x:Name="DayStateText"
                Grid.Row="3"
                Margin="0,18,0,0"
                HorizontalAlignment="Center"
                CharacterSpacing="60"
                FontSize="13"
                FontWeight="SemiBold"
                TextAlignment="Center" />

            <Grid
                Grid.Row="4"
                MinHeight="230"
                Margin="-24,8,-24,0"
                Background="#04FFFFFF">
                <Grid
                    x:Name="BackdropLayerHost"
                    IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw"
                    Opacity="0.11" />
                <Image
                    x:Name="SkylineImage"
                    Height="210"
                    VerticalAlignment="Bottom"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    Opacity="0.19"
                    Stretch="Uniform" />
                <Grid
                    x:Name="ForegroundLayerHost"
                    IsHitTestVisible="False"
                    AutomationProperties.AccessibilityView="Raw"
                    Opacity="0.22" />
                <controls:CelestialPhaseControl
                    x:Name="CelestialPhase"
                    Width="122"
                    Height="122"
                    Margin="0,8,0,42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw" />
            </Grid>

            <StackPanel
                x:Name="WeatherPanel"
                Grid.Row="5"
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Spacing="0"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="WeatherTemperatureText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="34"
                    FontWeight="Light"
                    TextAlignment="Center" />
                <TextBlock
                    x:Name="WeatherConditionText"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="6" Margin="0,8,0,0" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel HorizontalAlignment="Center" Spacing="3">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="#FFE85B42"
                        Glyph="&#xE706;" />
                    <TextBlock
                        x:Name="SunriseText"
                        FontSize="11"
                        TextAlignment="Center" />
                </StackPanel>
                <Rectangle
                    Grid.Column="1"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="3">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="#FF746ECF"
                        Glyph="&#xE708;" />
                    <TextBlock
                        x:Name="SunsetText"
                        FontSize="11"
                        TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
