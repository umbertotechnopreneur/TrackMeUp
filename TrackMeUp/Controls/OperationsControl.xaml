<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.OperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OperationsMetricLabelStyle" TargetType="TextBlock">
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="OperationsMetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiLight" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="OperationsMetricDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <InfoBar x:Name="OperationInfoBar" AutomationProperties.LiveSetting="Polite" IsClosable="True" IsOpen="False" />
            <ProgressRing
                x:Name="OperationProgress"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Operation in progress"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <ScrollViewer x:Name="OperationsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <Grid x:Name="OperationsBody" Padding="0,0,28,20" RowSpacing="24">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OperationsBody.ColumnSpacing" Value="32" />
                                <Setter Target="SecondaryColumn.Width" Value="*" />
                                <Setter Target="SecondarySections.(Grid.Row)" Value="0" />
                                <Setter Target="SecondarySections.(Grid.Column)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SecondaryColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <StackPanel x:Name="PrimarySections" Spacing="24">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Runtime" Style="{StaticResource SubtitleTextBlockStyle}" Text="Runtime and system" />
                            <TextBlock Tag="Operations.Runtime.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Inspect runtime health and capture a current system snapshot." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.Health" AutomationProperties.Name="Health" Click="RuntimeHealthButton_Click" Content="Health" />
                            <Button Tag="Operations.SystemSnapshot" AutomationProperties.Name="System snapshot" Click="SystemSnapshotButton_Click" Content="System snapshot" />
                        </StackPanel>
                        <TextBlock x:Name="RuntimeHealthEmptyText" Tag="Operations.Initial.Health" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Health not acquired yet." TextWrapping="Wrap" />
                        <StackPanel x:Name="RuntimeHealthSummary" Spacing="14" Visibility="Collapsed">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Tag="Operations.Runtime.Version" Style="{StaticResource OperationsMetricLabelStyle}" Text="VERSION" />
                                    <TextBlock x:Name="RuntimeVersionValue" Style="{StaticResource OperationsMetricValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Tag="Operations.Runtime.Protocol" Style="{StaticResource OperationsMetricLabelStyle}" Text="PROTOCOL" />
                                    <TextBlock x:Name="RuntimeProtocolValue" Style="{StaticResource OperationsMetricValueStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Tag="Operations.Runtime.Role" Style="{StaticResource OperationsMetricLabelStyle}" Text="ROLE" />
                                    <TextBlock x:Name="RuntimeRoleValue" Style="{StaticResource OperationsMetricValueStyle}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Tag="Operations.Runtime.Capabilities" Style="{StaticResource OperationsMetricLabelStyle}" Text="CAPABILITIES" />
                                <ItemsControl x:Name="RuntimeCapabilitiesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,14,6" FontFamily="Cascadia Mono" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Border Height="1" Opacity="0.6" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <StackPanel Spacing="8">
                                <TextBlock Tag="Operations.Runtime.Observability" Style="{StaticResource OperationsMetricLabelStyle}" Text="OBSERVABILITY" />
                                <Grid ColumnSpacing="18" RowSpacing="10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Spacing="1"><TextBlock Tag="Operations.Runtime.Console" Style="{StaticResource OperationsMetricDetailStyle}" Text="Console logging" /><TextBlock x:Name="RuntimeConsoleValue" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="1"><TextBlock Tag="Operations.Runtime.File" Style="{StaticResource OperationsMetricDetailStyle}" Text="File logging" /><TextBlock x:Name="RuntimeFileValue" FontWeight="SemiBold" /></StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="1"><TextBlock Text="Sentry" Style="{StaticResource OperationsMetricDetailStyle}" /><TextBlock x:Name="RuntimeSentryValue" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1"><TextBlock Tag="Operations.Runtime.DefaultPii" Style="{StaticResource OperationsMetricDetailStyle}" Text="Default PII" /><TextBlock x:Name="RuntimePiiValue" FontWeight="SemiBold" /></StackPanel>
                                </Grid>
                                <TextBlock x:Name="ObservabilityUnavailableText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock x:Name="SystemSnapshotEmptyText" Tag="Operations.Initial.SystemSnapshot" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="System snapshot not acquired yet." TextWrapping="Wrap" />
                        <StackPanel x:Name="SystemSnapshotSummary" Spacing="12" Visibility="Collapsed">
                            <TextBlock Tag="Operations.System.Live" Style="{StaticResource OperationsMetricLabelStyle}" Text="LIVE SYSTEM" />
                            <Grid ColumnSpacing="18" RowSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <StackPanel Spacing="1"><TextBlock Text="CPU" Style="{StaticResource OperationsMetricDetailStyle}" /><TextBlock x:Name="SystemCpuValue" Style="{StaticResource OperationsMetricValueStyle}" /><TextBlock x:Name="SystemCpuDetail" Style="{StaticResource OperationsMetricDetailStyle}" /></StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1"><TextBlock Text="GPU" Style="{StaticResource OperationsMetricDetailStyle}" /><TextBlock x:Name="SystemGpuValue" Style="{StaticResource OperationsMetricValueStyle}" /><TextBlock x:Name="SystemGpuDetail" Style="{StaticResource OperationsMetricDetailStyle}" /></StackPanel>
                                <StackPanel Grid.Row="1" Spacing="1"><TextBlock Tag="Operations.System.Memory" Style="{StaticResource OperationsMetricDetailStyle}" Text="Memory" /><TextBlock x:Name="SystemMemoryValue" FontSize="17" FontWeight="SemiLight" IsTextSelectionEnabled="True" TextWrapping="Wrap" /></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1"><TextBlock Tag="Operations.System.Network" Style="{StaticResource OperationsMetricDetailStyle}" Text="Network" /><TextBlock x:Name="SystemNetworkValue" FontSize="15" FontWeight="SemiLight" IsTextSelectionEnabled="True" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <StackPanel Spacing="6">
                                <TextBlock Tag="Operations.System.Storage" Style="{StaticResource OperationsMetricLabelStyle}" Text="STORAGE" />
                                <ItemsControl x:Name="SystemDisksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Margin="0,1" FontFamily="Cascadia Mono" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.SnapshotAi" Style="{StaticResource SubtitleTextBlockStyle}" Text="Snapshots and AI analysis" />
                            <TextBlock Tag="Operations.SnapshotAi.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Capture the current context or request an AI analysis." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" HorizontalAlignment="Stretch" Header="Capture mode" SelectedIndex="0">
                            <ComboBoxItem Content="All displays" Tag="all-screens" />
                            <ComboBoxItem Content="Active window" Tag="active-window" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="KeepScreenshotBox" Tag="Operations.Keep" Content="Keep" IsChecked="True" />
                            <CheckBox x:Name="WatermarkScreenshotBox" Tag="Operations.Watermark" Content="Watermark" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.TakeSnapshotNow" AutomationProperties.Name="Take snapshot now" Click="CaptureScreenshotButton_Click" Content="Take snapshot now" />
                            <Button Tag="Operations.LatestSnapshot" AutomationProperties.Name="Latest snapshot" Click="LatestScreenshotButton_Click" Content="Latest snapshot" />
                            <Button Tag="Operations.OpenFolder" AutomationProperties.Name="Open folder" Click="OpenScreenshotFolderButton_Click" Content="Open folder" />
                        </StackPanel>
                        <TextBlock x:Name="ScreenshotResultText" Tag="Operations.Initial.Snapshot" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No snapshot captured." TextWrapping="Wrap" />
                        <CheckBox x:Name="AllowAiCaptureBox" Tag="Operations.AllowCapture" Content="Allow a new snapshot when required" IsChecked="True" />
                        <Button Tag="Operations.Analyze" AutomationProperties.Name="Analyze current context" Click="AnalyzeButton_Click" Content="Analyze current context" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AiAnalysisText" Tag="Operations.Initial.Analysis" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No analysis performed." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Reports" Style="{StaticResource SubtitleTextBlockStyle}" Text="Reports and digest" />
                            <TextBlock Tag="Operations.Reports.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Generate local reports from the current data store." TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OpenGeneratedReportBox" Tag="Operations.OpenGenerated" Content="Open the report after generation" />
                        <Button Tag="Operations.TodayReport" Click="TodayReportButton_Click" Content="Generate today's report" HorizontalAlignment="Left" />
                        <CalendarDatePicker x:Name="DigestDatePicker" Tag="Operations.DigestDate" HorizontalAlignment="Stretch" Header="Digest date" PlaceholderText="Select a date" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.GenerateDigest" Click="DigestButton_Click" Content="Generate digest" />
                            <Button Tag="Operations.OpenFolder" Click="OpenReportsFolderButton_Click" Content="Open folder" />
                        </StackPanel>
                        <TextBlock x:Name="ReportResultText" Tag="Operations.Initial.Report" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No report generated." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SecondarySections" Grid.Row="1" Spacing="16">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ToggleButton x:Name="PrivacySectionButton" Tag="Operations.Section.Privacy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsChecked="True" Click="PrivacySectionButton_Click" Content="Privacy" />
                        <ToggleButton x:Name="RetentionSectionButton" Tag="Operations.Section.Retention" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="RetentionSectionButton_Click" Content="Data retention" />
                        <ToggleButton x:Name="PluginsSectionButton" Tag="Operations.Section.Plugins" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="PluginsSectionButton_Click" Content="Plugins" />
                    </Grid>
                    <controls:PrivacyOperationsControl x:Name="PrivacySection" />
                    <controls:RetentionOperationsControl x:Name="RetentionSection" Visibility="Collapsed" />
                    <controls:PluginOperationsControl x:Name="PluginsSection" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
