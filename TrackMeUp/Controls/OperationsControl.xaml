<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.OperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TrackMeUp.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="420"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{ThemeResource FlyoutSoftBrush}" />
        </Style>
        <Style x:Key="ResultTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{ThemeResource FlyoutMutedBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootLayout" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                MinWidth="44"
                MinHeight="44"
                Padding="8"
                AutomationProperties.Name="Torna al player"
                Background="{ThemeResource FlyoutSoftBrush}"
                BorderBrush="Transparent"
                Click="BackButton_Click"
                CornerRadius="16">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    Foreground="#FF80B9AA"
                    Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    CharacterSpacing="70"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource FlyoutTextBrush}"
                    Text="STRUMENTI E DIAGNOSTICA"
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource FlyoutMutedBrush}"
                    Text="Tutte le operazioni usano il runtime condiviso dell'app."
                    TextWrapping="Wrap" />
            </StackPanel>
            <ProgressRing
                x:Name="OperationProgress"
                Grid.Column="2"
                Width="24"
                Height="24"
                VerticalAlignment="Center"
                AutomationProperties.Name="Operazione in corso"
                IsActive="False" />
        </Grid>

        <InfoBar
            x:Name="OperationInfoBar"
            Grid.Row="1"
            AutomationProperties.LiveSetting="Polite"
            IsClosable="True"
            IsOpen="False" />

        <ScrollViewer
            x:Name="OperationsScroll"
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <Grid x:Name="OperationsBody" Padding="0,0,6,0" ColumnSpacing="0" RowSpacing="12">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="700" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OperationsBody.ColumnSpacing" Value="14" />
                                <Setter Target="SecondaryColumn.Width" Value="*" />
                                <Setter Target="SecondarySections.(Grid.Row)" Value="0" />
                                <Setter Target="SecondarySections.(Grid.Column)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="PrimarySections" Spacing="10">
                    <Expander
                        Header="Runtime e sistema"
                        IsExpanded="True"
                        Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    AutomationProperties.Name="Controlla runtime e osservabilità"
                                    Click="RuntimeHealthButton_Click"
                                    Content="Health"
                                    HorizontalAlignment="Stretch" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Acquisisci snapshot del sistema"
                                    Click="SystemSnapshotButton_Click"
                                    Content="Snapshot sistema"
                                    HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Name="RuntimeHealthText" Style="{StaticResource ResultTextStyle}" Text="Health non ancora acquisita." />
                            <TextBlock x:Name="ObservabilityHealthText" Style="{StaticResource ResultTextStyle}" />
                            <TextBlock x:Name="SystemSnapshotText" Style="{StaticResource ResultTextStyle}" Text="Snapshot non ancora acquisito." />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Screenshot e analisi AI" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <ComboBox
                                x:Name="ScreenshotModeBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Modalità acquisizione screenshot"
                                Header="Modalità"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Tutti gli schermi" Tag="all-screens" />
                                <ComboBoxItem Content="Finestra attiva" Tag="active-window" />
                            </ComboBox>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="KeepScreenshotBox" Content="Conserva" IsChecked="True" />
                                <CheckBox x:Name="WatermarkScreenshotBox" Grid.Column="1" Content="Watermark" IsChecked="True" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button AutomationProperties.Name="Cattura screenshot" Click="CaptureScreenshotButton_Click" Content="Cattura" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Mostra ultimo screenshot" Click="LatestScreenshotButton_Click" Content="Ultimo" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" AutomationProperties.Name="Apri cartella screenshot" Click="OpenScreenshotFolderButton_Click" Content="Apri cartella" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Name="ScreenshotResultText" Style="{StaticResource ResultTextStyle}" Text="Nessuno screenshot acquisito." />
                            <Rectangle Height="1" Fill="{ThemeResource FlyoutBorderBrush}" />
                            <CheckBox x:Name="AllowAiCaptureBox" Content="Consenti una nuova cattura se necessaria" IsChecked="True" />
                            <Button
                                AutomationProperties.Name="Analizza ora il contesto corrente con AI"
                                Click="AnalyzeButton_Click"
                                Content="Analizza contesto corrente"
                                HorizontalAlignment="Stretch" />
                            <TextBlock x:Name="AiAnalysisText" Style="{StaticResource ResultTextStyle}" Text="Nessuna analisi eseguita." />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Sessione focus" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <TextBox
                                x:Name="FocusObjectiveBox"
                                AutomationProperties.Name="Obiettivo sessione focus"
                                Header="Obiettivo"
                                PlaceholderText="Es. completare la revisione" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button AutomationProperties.Name="Avvia sessione focus" Click="StartFocusButton_Click" Content="Avvia" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Aggiorna stato sessione focus" Click="FocusStatusButton_Click" Content="Stato" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" AutomationProperties.Name="Ferma sessione focus" Click="StopFocusButton_Click" Content="Ferma" HorizontalAlignment="Stretch" />
                            </Grid>
                            <CheckBox x:Name="SummarizeFocusBox" Content="Genera riepilogo alla chiusura" IsChecked="True" />
                            <TextBlock x:Name="FocusStatusText" Style="{StaticResource ResultTextStyle}" Text="Nessuna sessione focus attiva." />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Report e digest" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <CheckBox x:Name="OpenGeneratedReportBox" Content="Apri il report dopo la generazione" />
                            <Button
                                AutomationProperties.Name="Genera report di oggi"
                                Click="TodayReportButton_Click"
                                Content="Genera report di oggi"
                                HorizontalAlignment="Stretch" />
                            <CalendarDatePicker
                                x:Name="DigestDatePicker"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Data del digest"
                                Header="Data digest"
                                PlaceholderText="Seleziona una data" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button AutomationProperties.Name="Genera digest per la data selezionata" Click="DigestButton_Click" Content="Genera digest" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Apri cartella report" Click="OpenReportsFolderButton_Click" Content="Apri cartella" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Name="ReportResultText" Style="{StaticResource ResultTextStyle}" Text="Nessun report generato." />
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel x:Name="SecondarySections" Grid.Row="1" Spacing="10">
                    <Expander Header="Privacy" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <ComboBox
                                x:Name="PrivacyRuleTypeBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Tipo regola privacy"
                                Header="Tipo"
                                SelectedIndex="0">
                                <ComboBoxItem Content="Processo" Tag="process" />
                                <ComboBoxItem Content="Titolo finestra" Tag="title" />
                                <ComboBoxItem Content="Contesto" Tag="hint" />
                            </ComboBox>
                            <TextBox
                                x:Name="PrivacyRuleValueBox"
                                AutomationProperties.Name="Valore regola privacy"
                                Header="Valore"
                                PlaceholderText="Valore da bloccare" />
                            <Grid ColumnSpacing="6" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button AutomationProperties.Name="Aggiungi regola privacy" Click="AddPrivacyRuleButton_Click" Content="Aggiungi" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Aggiorna regole privacy" Click="ListPrivacyRulesButton_Click" Content="Aggiorna" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" AutomationProperties.Name="Rimuovi regola privacy selezionata" Click="RemovePrivacyRuleButton_Click" Content="Rimuovi selezionata" HorizontalAlignment="Stretch" />
                                <Button Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Testa contesto corrente contro le regole privacy" Click="TestPrivacyButton_Click" Content="Test contesto" HorizontalAlignment="Stretch" />
                            </Grid>
                            <ListView
                                x:Name="PrivacyRulesList"
                                Height="148"
                                AutomationProperties.Name="Regole privacy configurate"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="2,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Type}" />
                                            <TextBlock FontSize="11" Text="{Binding Value}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="9" Foreground="{ThemeResource FlyoutMutedBrush}" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="PrivacyTestText" Style="{StaticResource ResultTextStyle}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Conservazione dati" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button AutomationProperties.Name="Mostra stato conservazione" Click="RetentionStatusButton_Click" Content="Stato" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Anteprima pulizia conservazione" Click="RetentionPreviewButton_Click" Content="Anteprima" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" AutomationProperties.Name="Esegui pulizia conservazione con conferma" Click="RunRetentionButton_Click" Content="Esegui" HorizontalAlignment="Stretch" />
                            </Grid>
                            <TextBlock x:Name="RetentionStatusText" Style="{StaticResource ResultTextStyle}" Text="Policy non ancora caricata." />
                            <TextBlock x:Name="RetentionPreviewText" Style="{StaticResource ResultTextStyle}" Text="Anteprima non ancora calcolata." />
                            <ListView
                                x:Name="RetentionPathsList"
                                Height="120"
                                AutomationProperties.Name="Elementi candidati alla pulizia"
                                SelectionMode="None" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Plugin di contesto" Style="{StaticResource SectionExpanderStyle}">
                        <StackPanel Padding="12,6,12,12" Spacing="9">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button AutomationProperties.Name="Aggiorna elenco plugin" Click="ListPluginsButton_Click" Content="Aggiorna" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1" AutomationProperties.Name="Abilita plugin selezionato" Click="EnablePluginButton_Click" Content="Abilita" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" AutomationProperties.Name="Disabilita plugin selezionato" Click="DisablePluginButton_Click" Content="Disabilita" HorizontalAlignment="Stretch" />
                            </Grid>
                            <ListView
                                x:Name="PluginsList"
                                Height="190"
                                AutomationProperties.Name="Plugin configurati"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="2,4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock FontSize="11" Text="{Binding Description}" TextWrapping="Wrap" />
                                            <TextBlock FontSize="10" Foreground="{ThemeResource FlyoutMutedBrush}" Text="{Binding Enabled}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
