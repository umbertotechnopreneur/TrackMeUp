<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.OperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="720"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <InfoBar x:Name="OperationInfoBar" AutomationProperties.LiveSetting="Polite" IsClosable="True" IsOpen="False" />
            <ProgressRing
                x:Name="OperationProgress"
                Width="24"
                Height="24"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.Name="Operation in progress"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <ScrollViewer x:Name="OperationsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
            <Grid x:Name="OperationsBody" Padding="0,0,8,20" RowSpacing="24">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="WidthStates">
                        <VisualState x:Name="Narrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
                        <VisualState x:Name="Wide">
                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="OperationsBody.ColumnSpacing" Value="32" />
                                <Setter Target="SecondaryColumn.Width" Value="*" />
                                <Setter Target="SecondarySections.(Grid.Row)" Value="0" />
                                <Setter Target="SecondarySections.(Grid.Column)" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SecondaryColumn" Width="0" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <StackPanel x:Name="PrimarySections" Spacing="24">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Runtime" Style="{StaticResource SubtitleTextBlockStyle}" Text="Runtime and system" />
                            <TextBlock Tag="Operations.Runtime.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Inspect runtime health and capture a current system snapshot." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.Health" AutomationProperties.Name="Health" Click="RuntimeHealthButton_Click" Content="Health" />
                            <Button Tag="Operations.SystemSnapshot" AutomationProperties.Name="System snapshot" Click="SystemSnapshotButton_Click" Content="System snapshot" />
                        </StackPanel>
                        <TextBlock x:Name="RuntimeHealthText" Tag="Operations.Initial.Health" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="Health not acquired yet." TextWrapping="Wrap" />
                        <TextBlock x:Name="ObservabilityHealthText" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SystemSnapshotText" Tag="Operations.Initial.SystemSnapshot" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="System snapshot not acquired yet." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.SnapshotAi" Style="{StaticResource SubtitleTextBlockStyle}" Text="Snapshots and AI analysis" />
                            <TextBlock Tag="Operations.SnapshotAi.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Capture the current context or request an AI analysis." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" HorizontalAlignment="Stretch" Header="Capture mode" SelectedIndex="0">
                            <ComboBoxItem Content="All displays" Tag="all-screens" />
                            <ComboBoxItem Content="Active window" Tag="active-window" />
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="KeepScreenshotBox" Tag="Operations.Keep" Content="Keep" IsChecked="True" />
                            <CheckBox x:Name="WatermarkScreenshotBox" Tag="Operations.Watermark" Content="Watermark" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.TakeSnapshotNow" AutomationProperties.Name="Take snapshot now" Click="CaptureScreenshotButton_Click" Content="Take snapshot now" />
                            <Button Tag="Operations.LatestSnapshot" AutomationProperties.Name="Latest snapshot" Click="LatestScreenshotButton_Click" Content="Latest snapshot" />
                            <Button Tag="Operations.OpenFolder" AutomationProperties.Name="Open folder" Click="OpenScreenshotFolderButton_Click" Content="Open folder" />
                        </StackPanel>
                        <TextBlock x:Name="ScreenshotResultText" Tag="Operations.Initial.Snapshot" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No snapshot captured." TextWrapping="Wrap" />
                        <CheckBox x:Name="AllowAiCaptureBox" Tag="Operations.AllowCapture" Content="Allow a new snapshot when required" IsChecked="True" />
                        <Button Tag="Operations.Analyze" AutomationProperties.Name="Analyze current context" Click="AnalyzeButton_Click" Content="Analyze current context" HorizontalAlignment="Left" />
                        <TextBlock x:Name="AiAnalysisText" Tag="Operations.Initial.Analysis" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No analysis performed." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Focus" Style="{StaticResource SubtitleTextBlockStyle}" Text="Focus session" />
                            <TextBlock Tag="Operations.Focus.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Start, inspect or stop a measured focus session." TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="FocusObjectiveBox" Tag="Operations.FocusObjective" Header="Objective" PlaceholderText="For example: finish the review" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.Start" Click="StartFocusButton_Click" Content="Start" />
                            <Button Tag="Operations.Status" Click="FocusStatusButton_Click" Content="Status" />
                            <Button Tag="Operations.Stop" Click="StopFocusButton_Click" Content="Stop" />
                        </StackPanel>
                        <CheckBox x:Name="SummarizeFocusBox" Tag="Operations.Summarize" Content="Generate a summary when stopping" IsChecked="True" />
                        <TextBlock x:Name="FocusStatusText" Tag="Operations.Initial.Focus" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No focus session is active." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Reports" Style="{StaticResource SubtitleTextBlockStyle}" Text="Reports and digest" />
                            <TextBlock Tag="Operations.Reports.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Generate local reports from the current data store." TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox x:Name="OpenGeneratedReportBox" Tag="Operations.OpenGenerated" Content="Open the report after generation" />
                        <Button Tag="Operations.TodayReport" Click="TodayReportButton_Click" Content="Generate today's report" HorizontalAlignment="Left" />
                        <CalendarDatePicker x:Name="DigestDatePicker" Tag="Operations.DigestDate" HorizontalAlignment="Stretch" Header="Digest date" PlaceholderText="Select a date" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.GenerateDigest" Click="DigestButton_Click" Content="Generate digest" />
                            <Button Tag="Operations.OpenFolder" Click="OpenReportsFolderButton_Click" Content="Open folder" />
                        </StackPanel>
                        <TextBlock x:Name="ReportResultText" Tag="Operations.Initial.Report" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="No report generated." TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SecondarySections" Grid.Row="1" Spacing="24">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Privacy" Style="{StaticResource SubtitleTextBlockStyle}" Text="Privacy" />
                            <TextBlock Tag="Operations.Privacy.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Block sensitive processes, window titles or context hints." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="PrivacyRuleTypeBox" Tag="Operations.PrivacyType" HorizontalAlignment="Stretch" Header="Rule type" SelectedIndex="0">
                            <ComboBoxItem Content="Process" Tag="process" />
                            <ComboBoxItem Content="Window title" Tag="title" />
                            <ComboBoxItem Content="Context" Tag="hint" />
                        </ComboBox>
                        <TextBox x:Name="PrivacyRuleValueBox" Tag="Operations.PrivacyValue" Header="Value" PlaceholderText="Value to block" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Tag="Operations.Add" Click="AddPrivacyRuleButton_Click" Content="Add" HorizontalAlignment="Stretch" />
                            <Button Tag="Operations.Refresh" Grid.Column="1" Click="ListPrivacyRulesButton_Click" Content="Refresh" HorizontalAlignment="Stretch" />
                            <Button Tag="Operations.Remove" Grid.Row="1" Click="RemovePrivacyRuleButton_Click" Content="Remove selected" HorizontalAlignment="Stretch" />
                            <Button Tag="Operations.TestContext" Grid.Row="1" Grid.Column="1" Click="TestPrivacyButton_Click" Content="Test context" HorizontalAlignment="Stretch" />
                        </Grid>
                        <ListView x:Name="PrivacyRulesList" Height="148" AutomationProperties.Name="Configured privacy rules" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate><StackPanel Padding="2,4"><TextBlock FontWeight="SemiBold" Text="{Binding Type}" /><TextBlock Text="{Binding Value}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Id}" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="PrivacyTestText" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Retention" Style="{StaticResource SubtitleTextBlockStyle}" Text="Data retention" />
                            <TextBlock Tag="Operations.Retention.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Review the policy before running a confirmed cleanup." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.Status" Click="RetentionStatusButton_Click" Content="Status" />
                            <Button Tag="Operations.Preview" Click="RetentionPreviewButton_Click" Content="Preview" />
                            <Button Tag="Operations.Run" Click="RunRetentionButton_Click" Content="Run" />
                        </StackPanel>
                        <TextBlock x:Name="RetentionStatusText" Tag="Operations.Initial.Retention" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="Policy not loaded yet." TextWrapping="Wrap" />
                        <TextBlock x:Name="RetentionPreviewText" Tag="Operations.Initial.RetentionPreview" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}" Text="Preview not calculated yet." TextWrapping="Wrap" />
                        <ListView x:Name="RetentionPathsList" Height="120" AutomationProperties.Name="Cleanup candidates" SelectionMode="None" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock Tag="Operations.Plugins" Style="{StaticResource SubtitleTextBlockStyle}" Text="Context plugins" />
                            <TextBlock Tag="Operations.Plugins.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Enable or disable supported application context providers." TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="Operations.Refresh" Click="ListPluginsButton_Click" Content="Refresh" />
                            <Button Tag="Operations.Enable" Click="EnablePluginButton_Click" Content="Enable" />
                            <Button Tag="Operations.Disable" Click="DisablePluginButton_Click" Content="Disable" />
                        </StackPanel>
                        <ListView x:Name="PluginsList" Height="190" AutomationProperties.Name="Configured plugins" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate><StackPanel Padding="2,4"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Enabled}" /></StackPanel></DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
