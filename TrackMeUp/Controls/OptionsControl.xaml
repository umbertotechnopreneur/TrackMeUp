<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.OptionsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="720" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="GeneralPositionColumn.Width" Value="*" />
                        <Setter Target="GeneralTaskbarColumn.Width" Value="*" />
                        <Setter Target="PositionBox.(Grid.Row)" Value="0" />
                        <Setter Target="PositionBox.(Grid.Column)" Value="1" />
                        <Setter Target="TaskbarWidgetPositionBox.(Grid.Row)" Value="0" />
                        <Setter Target="TaskbarWidgetPositionBox.(Grid.Column)" Value="2" />
                        <Setter Target="ScreenshotHintColumn.Width" Value="*" />
                        <Setter Target="ScreenshotModeHintBox.(Grid.Row)" Value="0" />
                        <Setter Target="ScreenshotModeHintBox.(Grid.Column)" Value="1" />
                        <Setter Target="AiEndpointColumn.Width" Value="*" />
                        <Setter Target="AiKeyNameColumn.Width" Value="*" />
                        <Setter Target="AiEndpointBox.(Grid.Row)" Value="0" />
                        <Setter Target="AiEndpointBox.(Grid.Column)" Value="1" />
                        <Setter Target="AiApiKeyNameBox.(Grid.Row)" Value="0" />
                        <Setter Target="AiApiKeyNameBox.(Grid.Column)" Value="2" />
                        <Setter Target="SecondaryActionColumn.Width" Value="*" />
                        <Setter Target="SaveOptionsButton.(Grid.Row)" Value="0" />
                        <Setter Target="SaveOptionsButton.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel Padding="0,0,8,20" Spacing="20">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Width="40"
                        Height="40"
                        Padding="8"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Click="BackButton_Click">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" />
                    </Button>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Tag="Options.Title" Style="{StaticResource TitleTextBlockStyle}" Text="App options" TextWrapping="Wrap" />
                        <TextBlock Tag="Options.Subtitle" Style="{StaticResource BodyTextBlockStyle}" Text="Your data stays on this PC" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="GeneralSettingsGrid" ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="GeneralPositionColumn" Width="0" />
                        <ColumnDefinition x:Name="GeneralTaskbarColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="ThemeBox" Tag="Options.Theme" HorizontalAlignment="Stretch" Header="Theme">
                        <ComboBoxItem Content="System" Tag="system" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                    <ComboBox x:Name="PositionBox" Tag="Options.Position" Grid.Row="1" HorizontalAlignment="Stretch" Header="Player position">
                        <ComboBoxItem Content="Bottom center" Tag="bottom-center" />
                        <ComboBoxItem Content="Bottom left" Tag="bottom-left" />
                        <ComboBoxItem Content="Bottom right" Tag="bottom-right" />
                        <ComboBoxItem Content="Top left" Tag="top-left" />
                        <ComboBoxItem Content="Top right" Tag="top-right" />
                    </ComboBox>
                    <ComboBox x:Name="TaskbarWidgetPositionBox" Tag="Options.TaskbarPosition" Grid.Row="2" HorizontalAlignment="Stretch" Header="Taskbar control position">
                        <ComboBoxItem Content="Left" Tag="left" />
                        <ComboBoxItem Content="Center" Tag="center" />
                        <ComboBoxItem Content="Right" Tag="right" />
                    </ComboBox>
                </Grid>

                <ComboBox x:Name="LanguageBox" Tag="Options.Language" HorizontalAlignment="Stretch" Header="Interface language">
                    <ComboBoxItem Content="System" Tag="system" />
                    <ComboBoxItem Content="English" Tag="en" />
                    <ComboBoxItem Content="Italiano" Tag="it" />
                    <ComboBoxItem Content="Français" Tag="fr" />
                    <ComboBoxItem Content="Deutsch" Tag="de" />
                    <ComboBoxItem Content="Español" Tag="es" />
                    <ComboBoxItem Content="Tiếng Việt" Tag="vi" />
                </ComboBox>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Tag="Options.Section.Startup" Style="{StaticResource SubtitleTextBlockStyle}" Text="Startup" />
                        <TextBlock Tag="Options.Section.Startup.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Choose how TrackMeUp behaves after Windows sign-in." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="StartWithWindowsSwitch" Tag="Options.StartWithWindows" Header="Start with Windows" OffContent="Off" OnContent="On" />
                    <ToggleSwitch x:Name="StartTrackingOnLaunchSwitch" Tag="Options.StartTracking" Header="Start tracking on launch" OffContent="Wait for Play" OnContent="Start immediately" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Tag="Options.Section.Snapshots" Style="{StaticResource SubtitleTextBlockStyle}" Text="Snapshots" />
                        <TextBlock Tag="Options.Section.Snapshots.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Control local WebP captures and retention." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="ScreenshotsEnabledSwitch" Tag="Options.SnapshotsEnabled" Header="Enable snapshots" OffContent="Off" OnContent="On" />
                    <TextBox x:Name="ScreenshotFolderBox" Tag="Options.SnapshotFolder" Header="Snapshot folder" PlaceholderText="WebP folder" />
                    <Grid x:Name="ScreenshotModeGrid" ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ScreenshotHintColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" HorizontalAlignment="Stretch" Header="Capture mode" SelectionChanged="ScreenshotModeBox_SelectionChanged">
                            <ComboBoxItem Content="All displays" Tag="all-screens" />
                            <ComboBoxItem Content="Active window" Tag="active-window" />
                        </ComboBox>
                        <TextBox x:Name="ScreenshotModeHintBox" Tag="Options.SnapshotResult" Grid.Row="1" Header="Result" IsReadOnly="True" IsTabStop="False" TextWrapping="Wrap" />
                    </Grid>
                    <ToggleSwitch x:Name="KeepScreenshotsSwitch" Tag="Options.KeepSnapshots" Header="Keep snapshots" OffContent="Delete after analysis" OnContent="Store locally" />
                    <ToggleSwitch x:Name="WatermarkSwitch" Tag="Options.Watermark" Header="Snapshot watermark" OffContent="None" OnContent="Add host, date and ID" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Tag="Options.Section.Ai" Style="{StaticResource SubtitleTextBlockStyle}" Text="AI" />
                        <TextBlock Tag="Options.Section.Ai.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Configure the provider, model and analysis behavior." TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch x:Name="OpenAiEnabledSwitch" Tag="Options.OpenAi" Header="OpenAI integration" OffContent="Off" OnContent="On" />
                    <Grid x:Name="AiFieldsGrid" ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="AiEndpointColumn" Width="0" />
                            <ColumnDefinition x:Name="AiKeyNameColumn" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ComboBox x:Name="AiProviderBox" Tag="Options.AiProvider" HorizontalAlignment="Stretch" Header="AI provider" SelectionChanged="AiProviderBox_SelectionChanged">
                            <ComboBoxItem Content="OpenAI" Tag="openai" />
                            <ComboBoxItem Content="OpenRouter" Tag="openrouter" />
                            <ComboBoxItem Content="Anthropic" Tag="anthropic" />
                        </ComboBox>
                        <TextBox x:Name="AiEndpointBox" Tag="Options.AiEndpoint" Grid.Row="1" Header="Endpoint" />
                        <TextBox x:Name="AiApiKeyNameBox" Tag="Options.AiKeyVariable" Grid.Row="2" Header="API key variable name" />
                    </Grid>
                    <PasswordBox x:Name="ApiKeyBox" Tag="Options.ApiKey" Header="Temporary API key" PlaceholderText="API key (not stored in settings)" />
                    <TextBox x:Name="ModelBox" Tag="Options.Model" Header="Model" />
                    <ComboBox x:Name="AiOutputDetailBox" Tag="Options.OutputDetail" Header="Snapshot analysis detail">
                        <ComboBoxItem Content="Compact · lowest usage" Tag="compact" />
                        <ComboBoxItem Content="Balanced" Tag="balanced" />
                        <ComboBoxItem Content="Detailed · larger budget" Tag="detailed" />
                    </ComboBox>
                    <ComboBox x:Name="AiReasoningEffortBox" Tag="Options.Reasoning" Header="Reasoning effort">
                        <ComboBoxItem Content="Automatic" Tag="auto" />
                        <ComboBoxItem Content="None" Tag="none" />
                        <ComboBoxItem Content="Low" Tag="low" />
                        <ComboBoxItem Content="Medium" Tag="medium" />
                        <ComboBoxItem Content="High" Tag="high" />
                        <ComboBoxItem Content="Very high" Tag="xhigh" />
                        <ComboBoxItem Content="Maximum" Tag="max" />
                    </ComboBox>
                    <TextBox x:Name="AiCustomPromptBox" Tag="Options.CustomPrompt" AcceptsReturn="True" Header="Additional AI instruction (optional)" MinHeight="80" PlaceholderText="Example: Prioritize concise, factual descriptions." TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="IncludeDeviceLocationSwitch" Tag="Options.DeviceLocation" Header="Include device location in AI snapshots" OffContent="Off" OnContent="Windows Location" />
                    <ToggleSwitch x:Name="AutomaticAnalysisSwitch" Tag="Options.AutomaticAnalysis" Header="Automatic analysis" OffContent="On demand only" OnContent="Every 15 minutes" />
                    <Button Tag="Options.SaveApiKey" Click="SetApiKeyButton_Click" Content="Save API key" HorizontalAlignment="Left" />
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <StackPanel Spacing="10">
                    <StackPanel Spacing="2">
                        <TextBlock Tag="Options.Section.ActiveHours" Style="{StaticResource SubtitleTextBlockStyle}" Text="Active hours" />
                        <TextBlock Tag="Options.Section.ActiveHours.Description" Style="{StaticResource BodyTextBlockStyle}" Text="Informational context for AI snapshots only. Use HH:mm-HH:mm and commas between breaks." TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Tag="Options.ActiveHours" Style="{StaticResource CaptionTextBlockStyle}" Text="Active hours" />
                        <TextBlock Grid.Column="2" Tag="Options.Breaks" Style="{StaticResource CaptionTextBlockStyle}" Text="Breaks" />
                    </Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.monday" VerticalAlignment="Center" Text="Monday" /><TextBox x:Name="MondayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="MondayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.tuesday" VerticalAlignment="Center" Text="Tuesday" /><TextBox x:Name="TuesdayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="TuesdayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.wednesday" VerticalAlignment="Center" Text="Wednesday" /><TextBox x:Name="WednesdayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="WednesdayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.thursday" VerticalAlignment="Center" Text="Thursday" /><TextBox x:Name="ThursdayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="ThursdayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.friday" VerticalAlignment="Center" Text="Friday" /><TextBox x:Name="FridayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="FridayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.saturday" VerticalAlignment="Center" Text="Saturday" /><TextBox x:Name="SaturdayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="SaturdayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Tag="Options.Day.sunday" VerticalAlignment="Center" Text="Sunday" /><TextBox x:Name="SundayActiveHoursBox" Grid.Column="1" PlaceholderText="09:00-18:00" /><TextBox x:Name="SundayBreaksBox" Grid.Column="2" PlaceholderText="13:00-14:00" /></Grid>
                </StackPanel>

                <Grid x:Name="ActionsGrid" ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SecondaryActionColumn" Width="0" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Button Tag="Options.ExportReport" Click="ExportReportButton_Click" Content="Export HTML report" HorizontalAlignment="Stretch" />
                    <Button x:Name="SaveOptionsButton" Tag="Options.Save" Grid.Row="1" Click="SaveButton_Click" Content="Save options" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
