<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.InstallationTransferOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="760"
    d:DesignWidth="560"
    mc:Ignorable="d">
    <Grid>
        <ProgressRing
            x:Name="Progress"
            Canvas.ZIndex="1"
            Width="22"
            Height="22"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsActive="False"
            Visibility="Collapsed" />

        <StackPanel x:Name="SectionBody" Spacing="22">
            <StackPanel Spacing="4">
                <TextBlock
                    Tag="Operations.InstallationTransfer.Title"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Installations and data transfer" />
                <TextBlock
                    Tag="Operations.InstallationTransfer.Description"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Identify where activity came from, export local data and screenshots, or preview and merge an archive from another TrackMeUp installation."
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Installations.Title"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Installation identity" />
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Installations.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="The installation ID is the durable source, while the machine name identifies the originating PC. Choose a friendly name, color, and icon to recognize its activity throughout TrackMeUp."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ListView
                    x:Name="InstallationsList"
                    MaxHeight="240"
                    AutomationProperties.Name="Known installations"
                    SelectionChanged="InstallationsList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="52" Padding="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}"
                                    CornerRadius="16">
                                    <FontIcon
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontFamily="Segoe Fluent Icons"
                                        FontSize="15"
                                        Foreground="White"
                                        Glyph="{Binding Glyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding MachineLabel}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    x:Name="NoInstallationsText"
                    Tag="Operations.InstallationTransfer.Installations.Empty"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No installation profiles are available."
                    TextWrapping="Wrap" />

                <StackPanel x:Name="ProfileEditor" Spacing="10" Visibility="Collapsed">
                    <TextBlock
                        x:Name="MachineNameText"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBox
                        x:Name="FriendlyNameBox"
                        Tag="Operations.InstallationTransfer.FriendlyName"
                        Header="Friendly name"
                        MaxLength="64"
                        PlaceholderText="For example: Office laptop"
                        TextChanged="FriendlyNameBox_TextChanged" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="ColorBox"
                            Tag="Operations.InstallationTransfer.Color"
                            HorizontalAlignment="Stretch"
                            Header="Color"
                            SelectionChanged="AppearanceBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="12" Height="12" Background="{Binding AccentBrush}" CornerRadius="6" />
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox
                            x:Name="IconBox"
                            Grid.Column="1"
                            Tag="Operations.InstallationTransfer.Icon"
                            HorizontalAlignment="Stretch"
                            Header="Icon"
                            SelectionChanged="AppearanceBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="{Binding Glyph}" />
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Button
                        x:Name="SaveProfileButton"
                        Tag="Operations.InstallationTransfer.SaveProfile"
                        HorizontalAlignment="Left"
                        Click="SaveProfileButton_Click"
                        Content="Save installation identity"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Export.Title"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Export" />
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Export.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Create one portable .tmuarchive containing the local database and retained screenshots."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="ExportArchiveButton"
                    Tag="Operations.InstallationTransfer.Export.Action"
                    HorizontalAlignment="Left"
                    Click="ExportArchiveButton_Click"
                    Content="Choose destination and export…" />
                <StackPanel x:Name="ExportResultPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock x:Name="ExportResultSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ExportResultPathText"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Spacing="10">
                <StackPanel Spacing="3">
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Import.Title"
                        AutomationProperties.HeadingLevel="Level3"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Import and merge" />
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Import.Description"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Select an archive to validate it and review its installations and record counts. Nothing is changed until you confirm the merge."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="PreviewImportButton"
                    Tag="Operations.InstallationTransfer.Import.PreviewAction"
                    HorizontalAlignment="Left"
                    Click="PreviewImportButton_Click"
                    Content="Choose archive and preview…" />

                <StackPanel x:Name="ImportPreviewPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock
                        x:Name="ImportArchivePathText"
                        FontFamily="Cascadia Mono"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ImportPreviewSummaryText" TextWrapping="Wrap" />
                    <TextBlock
                        Tag="Operations.InstallationTransfer.Import.Installations"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        FontWeight="SemiBold"
                        Text="Installations in this archive" />
                    <ItemsControl x:Name="ImportInstallationsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="36" Margin="0,2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="24" Height="24" Background="{Binding AccentBrush}" CornerRadius="12">
                                        <FontIcon
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontFamily="Segoe Fluent Icons"
                                            FontSize="12"
                                            Foreground="White"
                                            Glyph="{Binding Glyph}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding MachineLabel}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                        x:Name="AlreadyImportedText"
                        Tag="Operations.InstallationTransfer.Import.AlreadyImported"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Text="This archive was already imported on this installation."
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="MergeImportButton"
                        Tag="Operations.InstallationTransfer.Import.MergeAction"
                        HorizontalAlignment="Left"
                        Click="MergeImportButton_Click"
                        Content="Confirm and merge data"
                        IsEnabled="False"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <TextBlock
                    x:Name="ImportResultText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
