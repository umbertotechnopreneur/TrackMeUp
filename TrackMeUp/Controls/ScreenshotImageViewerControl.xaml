<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="360"
    AutomationProperties.Name="Screenshot viewer">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="ScreenshotViewerOverlayBrush"
                        FallbackColor="#EAF7F8FA"
                        TintColor="#FFFFFFFF"
                        TintLuminosityOpacity="0.18"
                        TintOpacity="0.05" />
                    <LinearGradientBrush x:Key="ScreenshotViewerOverlayBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A8FFFFFF" Offset="0" />
                        <GradientStop Color="#28717A84" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ScreenshotFrameBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6FFFFFF" Offset="0" />
                        <GradientStop Color="#6A71808A" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="ScreenshotViewerOverlayBrush"
                        FallbackColor="#EA1B1E24"
                        TintColor="#FF15191F"
                        TintLuminosityOpacity="0.14"
                        TintOpacity="0.10" />
                    <LinearGradientBrush x:Key="ScreenshotViewerOverlayBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#62FFFFFF" Offset="0" />
                        <GradientStop Color="#16FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="ScreenshotFrameBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A8FFFFFF" Offset="0" />
                        <GradientStop Color="#3AFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ScreenshotViewerOverlayBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScreenshotViewerOverlayBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="ScreenshotFrameBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScreenshotZoomButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="ScreenshotZoomToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="ScreenshotZoomPercentButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="ViewerRoot"
        Background="Transparent"
        GotFocus="ViewerRoot_GotFocus"
        LostFocus="ViewerRoot_LostFocus"
        PointerEntered="ViewerRoot_PointerEntered"
        PointerExited="ViewerRoot_PointerExited">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OverlayVisibilityStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="OverlayHidden" To="OverlayVisible">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ZoomRail"
                                Storyboard.TargetProperty="Opacity"
                                BeginTime="0:0:0.08"
                                To="1"
                                Duration="0:0:0.20" />
                        </Storyboard>
                    </VisualTransition>
                    <VisualTransition From="OverlayVisible" To="OverlayHidden">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="ZoomRail"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.14" />
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="OverlayHidden">
                    <VisualState.Setters>
                        <Setter Target="ZoomRail.Opacity" Value="0" />
                        <Setter Target="ZoomRail.IsHitTestVisible" Value="False" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OverlayVisible">
                    <VisualState.Setters>
                        <Setter Target="ZoomRail.Opacity" Value="1" />
                        <Setter Target="ZoomRail.IsHitTestVisible" Value="True" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer
            x:Name="ImageScroller"
            Background="Transparent"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            MaxZoomFactor="5"
            MinZoomFactor="1"
            SizeChanged="ImageScroller_SizeChanged"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Auto"
            ViewChanged="ImageScroller_ViewChanged"
            ZoomMode="Enabled">
            <Grid
                x:Name="ImageHost"
                MinWidth="1"
                MinHeight="1"
                Background="Transparent"
                PointerWheelChanged="ImageHost_PointerWheelChanged">
                <Border
                    x:Name="ScreenshotFrame"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource ScreenshotFrameBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="4"
                    Padding="16"
                    Translation="0,0,10"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Image
                        x:Name="ScreenshotImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="No screenshot selected"
                        ImageOpened="ScreenshotImage_ImageOpened"
                        Stretch="Uniform" />
                </Border>
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ZoomRail"
            Margin="0,0,0,190"
            Padding="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource ScreenshotViewerOverlayBrush}"
            BorderBrush="{ThemeResource ScreenshotViewerOverlayBorderBrush}"
            BorderThickness="1"
            CornerRadius="25"
            IsHitTestVisible="False"
            Opacity="0"
            PointerWheelChanged="ImageHost_PointerWheelChanged">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button
                    x:Name="ZoomOutButton"
                    AutomationProperties.Name="Zoom out"
                    Click="ZoomOutButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.ZoomOut"
                    ToolTipService.ToolTip="Zoom out">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE71F;" />
                </Button>
                <Button
                    x:Name="ZoomResetButton"
                    AutomationProperties.Name="Reset zoom to 100 percent"
                    Click="ZoomResetButton_Click"
                    Style="{StaticResource ScreenshotZoomPercentButtonStyle}"
                    Tag="Screenshots.Toolbar.ZoomReset"
                    ToolTipService.ToolTip="Reset zoom to 100%">
                    <TextBlock
                        x:Name="ZoomPercentText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="100%" />
                </Button>
                <Button
                    x:Name="ZoomInButton"
                    AutomationProperties.Name="Zoom in"
                    Click="ZoomInButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.ZoomIn"
                    ToolTipService.ToolTip="Zoom in">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE8A3;" />
                </Button>
                <Border
                    Width="1"
                    Height="22"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <ToggleButton
                    x:Name="DetailsToggleButton"
                    AutomationProperties.Name="Show snapshot details"
                    Click="DetailsToggleButton_Click"
                    Style="{StaticResource ScreenshotZoomToggleButtonStyle}"
                    Tag="Screenshots.Details.Show"
                    ToolTipService.ToolTip="Show snapshot details">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8A0;" />
                </ToggleButton>
                <Border
                    Width="1"
                    Height="22"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Name="SaveButton"
                    AutomationProperties.Name="Save selected image"
                    Click="SaveButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.Save"
                    ToolTipService.ToolTip="Save selected image">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE74E;" />
                </Button>
                <Button
                    x:Name="ShareButton"
                    AutomationProperties.Name="Share with another app"
                    Click="ShareButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.Share"
                    ToolTipService.ToolTip="Share with another app">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE72D;" />
                </Button>
                <Button
                    x:Name="OpenFolderButton"
                    AutomationProperties.Name="Open containing folder"
                    Click="OpenFolderButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.OpenFolder"
                    ToolTipService.ToolTip="Open containing folder">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8B7;" />
                </Button>
                <Border
                    Width="1"
                    Height="22"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Name="DeleteScreenshotButton"
                    AutomationProperties.Name="Delete screenshot"
                    Click="DeleteScreenshotButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.DeleteScreenshot"
                    ToolTipService.ToolTip="Delete screenshot">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="#FFE98A5B"
                        Glyph="&#xE74D;" />
                </Button>
                <Button
                    x:Name="DeleteSnapshotButton"
                    AutomationProperties.Name="Delete snapshot"
                    Click="DeleteSnapshotButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    Tag="Screenshots.Toolbar.DeleteSnapshot"
                    ToolTipService.ToolTip="Delete snapshot">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Foreground="#FF7FA8D9"
                        Glyph="&#xE823;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
