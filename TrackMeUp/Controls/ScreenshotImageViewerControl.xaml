<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="340"
    AutomationProperties.Name="Screenshot viewer">
    <Grid x:Name="ViewerRoot" Background="Transparent">
        <ScrollViewer
            x:Name="ImageScroller"
            Background="Transparent"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            MaxZoomFactor="5"
            MinZoomFactor="1"
            SizeChanged="ImageScroller_SizeChanged"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Auto"
            ViewChanged="ImageScroller_ViewChanged"
            ZoomMode="Enabled">
            <Grid
                x:Name="ImageHost"
                MinWidth="1"
                MinHeight="1"
                Background="Transparent"
                PointerWheelChanged="ImageHost_PointerWheelChanged">
                <Border
                    x:Name="ScreenshotFrame"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Translation="0,0,32"
                    Visibility="Collapsed">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                    <Image
                        x:Name="ScreenshotImage"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="No screenshot selected"
                        ImageOpened="ScreenshotImage_ImageOpened"
                        Stretch="Uniform" />
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
