<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="360"
    AutomationProperties.Name="Screenshot viewer">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style x:Key="ScreenshotZoomButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>

            <Style x:Key="ScreenshotZoomPercentButtonStyle" TargetType="Button">
                <Setter Property="MinWidth" Value="64" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ViewerRoot" Background="Transparent">
        <ScrollViewer
            x:Name="ImageScroller"
            Background="Transparent"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Auto"
            MaxZoomFactor="5"
            MinZoomFactor="1"
            SizeChanged="ImageScroller_SizeChanged"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Auto"
            ViewChanged="ImageScroller_ViewChanged"
            ZoomMode="Enabled">
            <Grid
                x:Name="ImageHost"
                MinWidth="1"
                MinHeight="1"
                Background="Transparent">
                <Image
                    x:Name="ScreenshotImage"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="No screenshot selected"
                    ImageOpened="ScreenshotImage_ImageOpened"
                    Stretch="Uniform" />
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="ZoomRail"
            Margin="0,0,0,190"
            Padding="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="25">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button
                    x:Name="ZoomOutButton"
                    AutomationProperties.Name="Zoom out"
                    Click="ZoomOutButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    ToolTipService.ToolTip="Zoom out">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE71F;" />
                </Button>
                <Button
                    x:Name="ZoomResetButton"
                    AutomationProperties.Name="Reset zoom to 100 percent"
                    Click="ZoomResetButton_Click"
                    Style="{StaticResource ScreenshotZoomPercentButtonStyle}"
                    ToolTipService.ToolTip="Reset zoom to 100%">
                    <TextBlock
                        x:Name="ZoomPercentText"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="100%" />
                </Button>
                <Button
                    x:Name="ZoomInButton"
                    AutomationProperties.Name="Zoom in"
                    Click="ZoomInButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    ToolTipService.ToolTip="Zoom in">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE8A3;" />
                </Button>
                <Border
                    Width="1"
                    Height="22"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Button
                    x:Name="SaveButton"
                    AutomationProperties.Name="Save screenshot"
                    Click="SaveButton_Click"
                    Style="{StaticResource ScreenshotZoomButtonStyle}"
                    ToolTipService.ToolTip="Save screenshot">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="15"
                        Glyph="&#xE74E;" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
