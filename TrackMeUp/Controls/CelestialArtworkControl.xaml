<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.CelestialArtworkControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">
    <Viewbox Stretch="Uniform">
        <Border x:Name="ThumbnailFrame" Width="96" Height="96" CornerRadius="18">
            <Border.Background>
                <!-- One atlas cell is selected by a normalized visual transform; the asset remains unmodified. -->
                <ImageBrush ImageSource="ms-appx:///Assets/Celestial/Artwork/celestial-atlas-v1.png" Stretch="Fill">
                    <ImageBrush.RelativeTransform>
                        <CompositeTransform x:Name="AtlasTransform" ScaleX="4" ScaleY="3" />
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Border.Background>
        </Border>
    </Viewbox>
</UserControl>
