<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.SnapshotAiOperationsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="520"
    mc:Ignorable="d">
    <Grid>
        <ProgressRing x:Name="Progress" Canvas.ZIndex="1" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" IsActive="False" Visibility="Collapsed" />

        <StackPanel x:Name="SectionBody" Spacing="14">
            <StackPanel Spacing="4">
                <TextBlock Tag="Operations.SnapshotAi" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" Text="Screen captures and AI" />
                <TextBlock
                    Tag="Operations.SnapshotAi.Description"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Capture all displays or the active window, decide whether to retain and label the images, inspect the latest capture, or ask the configured AI provider to describe the current context."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ComboBox x:Name="ScreenshotModeBox" Tag="Options.SnapshotMode" HorizontalAlignment="Stretch" Header="Capture mode" SelectedIndex="0">
                <ComboBoxItem Content="All displays" Tag="all-screens" />
                <ComboBoxItem Content="Active window" Tag="active-window" />
            </ComboBox>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="KeepScreenshotBox" Tag="Operations.Keep" Content="Keep" IsChecked="True" />
                <CheckBox x:Name="WatermarkScreenshotBox" Tag="Operations.Watermark" Content="Watermark" IsChecked="True" />
            </StackPanel>
            <Grid ColumnSpacing="8" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Button Tag="Operations.TakeSnapshotNow" AutomationProperties.Name="Capture screen now" Click="CaptureScreenshotButton_Click" Content="Capture screen now" HorizontalAlignment="Stretch" />
                <Button Tag="Operations.LatestSnapshot" Grid.Column="1" AutomationProperties.Name="Latest screen capture" Click="LatestScreenshotButton_Click" Content="Latest screen capture" HorizontalAlignment="Stretch" />
                <Button Tag="Operations.OpenFolder" Grid.Row="1" AutomationProperties.Name="Open folder" Click="OpenScreenshotFolderButton_Click" Content="Open folder" HorizontalAlignment="Stretch" />
            </Grid>
            <TextBlock x:Name="ScreenshotResultText" Tag="Operations.Initial.Snapshot" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="No screen capture yet." TextWrapping="Wrap" />

            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <CheckBox x:Name="AllowAiCaptureBox" Tag="Operations.AllowCapture" Content="Allow a new screen capture for this action" IsChecked="True" />
            <Button Tag="Operations.Analyze" AutomationProperties.Name="Describe current context" Click="AnalyzeButton_Click" Content="Describe current context" HorizontalAlignment="Left" />
            <TextBlock x:Name="AiAnalysisText" Tag="Operations.Initial.Analysis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" Text="No AI description yet." TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
