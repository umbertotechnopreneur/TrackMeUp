<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="TrackMeUp.Controls.ScreenshotGalleryViewControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<AcrylicBrush x:Key="ScreenshotSurfaceBrush"
								  TintColor="#FFF7FBFF"
								  TintOpacity="0.34"
								  TintLuminosityOpacity="0.73"
								  FallbackColor="#CCEEF7FF" />
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotNavigationBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotPreviewBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#1F000000" />
					<SolidColorBrush x:Key="ScreenshotMetadataBackgroundBrush" Color="#73FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBorderBrush" Color="#73FFFFFF" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<AcrylicBrush x:Key="ScreenshotSurfaceBrush"
								  TintColor="#FF0F1826"
								  TintOpacity="0.60"
								  TintLuminosityOpacity="0.78"
								  FallbackColor="#D90F1826" />
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#40FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotNavigationBackgroundBrush" Color="#4D1A2332" />
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#4DFFFFFF" />
					<SolidColorBrush x:Key="ScreenshotPreviewBackgroundBrush" Color="#33223342" />
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#3A000000" />
					<SolidColorBrush x:Key="ScreenshotMetadataBackgroundBrush" Color="#331B2739" />
					<SolidColorBrush x:Key="ScreenshotMetadataBorderBrush" Color="#40FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBackgroundBrush" Color="#2B1B2739" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBorderBrush" Color="#33FFFFFF" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Default">
					<AcrylicBrush x:Key="ScreenshotSurfaceBrush"
								  TintColor="#FFF7FBFF"
								  TintOpacity="0.34"
								  TintLuminosityOpacity="0.73"
								  FallbackColor="#CCEEF7FF" />
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotNavigationBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotPreviewBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#1F000000" />
					<SolidColorBrush x:Key="ScreenshotMetadataBackgroundBrush" Color="#73FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataBorderBrush" Color="#80FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBackgroundBrush" Color="#66FFFFFF" />
					<SolidColorBrush x:Key="ScreenshotMetadataCardBorderBrush" Color="#73FFFFFF" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<Style x:Key="NavigationButtonStyle" TargetType="Button">
				<Setter Property="Width" Value="52" />
				<Setter Property="Height" Value="70" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="CornerRadius" Value="16" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotNavigationBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotNavigationBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
			</Style>

			<Style x:Key="ScreenshotPreviewFrameStyle" TargetType="Border">
				<Setter Property="Width" Value="170" />
				<Setter Property="Height" Value="220" />
				<Setter Property="HorizontalAlignment" Value="Center" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotPreviewBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotShellBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="16" />
				<Setter Property="Padding" Value="5" />
			</Style>

			<Style x:Key="ScreenshotMetadataCardStyle" TargetType="Border">
				<Setter Property="Padding" Value="10,8" />
				<Setter Property="CornerRadius" Value="10" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotMetadataCardBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotMetadataCardBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
			</Style>

			<Style x:Key="ScreenshotInfoLabelTextStyle" TargetType="TextBlock">
				<Setter Property="Style" Value="{StaticResource CaptionTextBlockStyle}" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			</Style>

			<Style x:Key="ScreenshotInfoValueTextStyle" TargetType="TextBlock">
				<Setter Property="Style" Value="{StaticResource BodyStrongTextBlockStyle}" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
				<Setter Property="MaxLines" Value="1" />
			</Style>

			<Style x:Key="ScreenshotInfoIconStyle" TargetType="FontIcon">
				<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
				<Setter Property="FontSize" Value="13" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
				<Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<Border
		Padding="18,18,18,16"
		Background="{ThemeResource ScreenshotSurfaceBrush}"
		BorderBrush="{ThemeResource ScreenshotShellBorderBrush}"
		BorderThickness="1"
		CornerRadius="24">
		<Grid x:Name="GallerySurface" MinHeight="320">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid x:Name="CoverFlowPanel" Grid.Row="0" ColumnSpacing="18">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="188" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="188" />
				</Grid.ColumnDefinitions>
				<Border
					x:Name="PreviousPreviewFrame"
					Grid.Column="0"
					Opacity="0.62"
					RenderTransformOrigin="0.5,0.5"
					Style="{StaticResource ScreenshotPreviewFrameStyle}">
					<Border.RenderTransform>
						<CompositeTransform Rotation="-7" TranslateX="-12" />
					</Border.RenderTransform>
					<Grid>
						<Image x:Name="PreviousImage" Stretch="UniformToFill" />
						<Rectangle Fill="{ThemeResource ScreenshotPreviewShadowOverlayBrush}" />
					</Grid>
				</Border>
				<Border
					x:Name="GalleryImageFrame"
					Grid.Column="1"
					MaxWidth="780"
					MaxHeight="470"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Background="{ThemeResource ScreenshotPreviewBackgroundBrush}"
					BorderBrush="{ThemeResource ScreenshotShellBorderBrush}"
					BorderThickness="1"
					CornerRadius="20"
					Padding="9">
					<Image x:Name="CurrentImage" Stretch="Uniform" />
				</Border>
				<Border
					x:Name="NextPreviewFrame"
					Grid.Column="2"
					Opacity="0.62"
					RenderTransformOrigin="0.5,0.5"
					Style="{StaticResource ScreenshotPreviewFrameStyle}">
					<Border.RenderTransform>
						<CompositeTransform Rotation="7" TranslateX="12" />
					</Border.RenderTransform>
					<Grid>
						<Image x:Name="NextImage" Stretch="UniformToFill" />
						<Rectangle Fill="{ThemeResource ScreenshotPreviewShadowOverlayBrush}" />
					</Grid>
				</Border>
			</Grid>

			<Button
				x:Name="PreviousButton"
				Grid.Row="0"
				Margin="8,0,0,0"
				HorizontalAlignment="Left"
				VerticalAlignment="Center"
				AutomationProperties.Name="Previous screenshot"
				Opacity="1"
				Style="{StaticResource NavigationButtonStyle}">
				<FontIcon FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE72B;" />
			</Button>
			<Button
				x:Name="NextButton"
				Grid.Row="0"
				Margin="0,0,8,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				AutomationProperties.Name="Next screenshot"
				Opacity="1"
				Style="{StaticResource NavigationButtonStyle}">
				<FontIcon FontFamily="Segoe Fluent Icons" FontSize="20" Glyph="&#xE72A;" />
			</Button>

			<Border
				x:Name="MetadataPanel"
				Grid.Row="1"
				Margin="18,18,18,0"
				Padding="16,14"
				Background="{ThemeResource ScreenshotMetadataBackgroundBrush}"
				BorderBrush="{ThemeResource ScreenshotMetadataBorderBrush}"
				BorderThickness="1"
				CornerRadius="14"
				Visibility="Collapsed">
				<Grid ColumnSpacing="12">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1.25*" />
						<ColumnDefinition Width="1.05*" />
						<ColumnDefinition Width="2.15*" />
						<ColumnDefinition Width="1.25*" />
					</Grid.ColumnDefinitions>
					<Border Style="{StaticResource ScreenshotMetadataCardStyle}">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<FontIcon Glyph="&#xE787;" Style="{StaticResource ScreenshotInfoIconStyle}" />
								<TextBlock Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.DateLabel" Text="Date" />
							</StackPanel>
							<TextBlock x:Name="MetadataDateValueText" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
						</StackPanel>
					</Border>
					<Border Grid.Column="1" Style="{StaticResource ScreenshotMetadataCardStyle}">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<FontIcon Glyph="&#xE823;" Style="{StaticResource ScreenshotInfoIconStyle}" />
								<TextBlock Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.TimeLabel" Text="Time" />
							</StackPanel>
							<TextBlock x:Name="MetadataTimeValueText" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
						</StackPanel>
					</Border>
					<Border Grid.Column="2" Style="{StaticResource ScreenshotMetadataCardStyle}">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<FontIcon Glyph="&#xE7F4;" Style="{StaticResource ScreenshotInfoIconStyle}" />
								<TextBlock Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.ApplicationLabel" Text="Foreground app" />
							</StackPanel>
							<TextBlock x:Name="MetadataAppValueText" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
						</StackPanel>
					</Border>
					<Border Grid.Column="3" Style="{StaticResource ScreenshotMetadataCardStyle}">
						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="7">
								<FontIcon Glyph="&#xE7C3;" Style="{StaticResource ScreenshotInfoIconStyle}" />
								<TextBlock Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.OriginLabel" Text="Origin" />
							</StackPanel>
							<TextBlock x:Name="MetadataOriginValueText" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<Grid x:Name="EmptyGalleryPanel" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
				<Border
					MaxWidth="360"
					Padding="24,20"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Background="{ThemeResource ScreenshotMetadataBackgroundBrush}"
					BorderBrush="{ThemeResource ScreenshotMetadataBorderBrush}"
					BorderThickness="1"
					CornerRadius="16">
					<StackPanel HorizontalAlignment="Center" Spacing="10">
						<FontIcon
							HorizontalAlignment="Center"
							FontFamily="Segoe Fluent Icons"
							FontSize="36"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Glyph="&#xE722;" />
						<TextBlock
							x:Name="EmptyGalleryText"
							Style="{StaticResource BodyTextBlockStyle}"
							Tag="Screenshots.Empty"
							Text="No screenshots for this day."
							TextAlignment="Center" />
					</StackPanel>
				</Border>
			</Grid>

			<ProgressRing
				x:Name="GalleryProgressRing"
				Grid.RowSpan="2"
				Width="30"
				Height="30"
				HorizontalAlignment="Center"
				VerticalAlignment="Center"
				IsActive="False"
				Visibility="Collapsed" />
		</Grid>
	</Border>
</UserControl>
