<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotGalleryViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls">
    <Grid x:Name="GallerySurface" MinHeight="360" Background="Transparent">
        <controls:ScreenshotImageViewerControl
            x:Name="ImageViewer"
            MinHeight="340" />

        <Grid x:Name="EmptyGalleryPanel" Background="Transparent" Visibility="Collapsed">
            <StackPanel
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE722;" />
                <TextBlock
                    x:Name="EmptyGalleryText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Tag="Screenshots.Empty"
                    Text="No screenshots for this day."
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <ProgressRing
            x:Name="GalleryProgressRing"
            Width="30"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
