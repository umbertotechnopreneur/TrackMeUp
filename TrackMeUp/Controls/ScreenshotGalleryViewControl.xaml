<?xml version="1.0" encoding="utf-8"?>
<UserControl
	x:Class="TrackMeUp.Controls.ScreenshotGalleryViewControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:TrackMeUp.Controls">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#E6FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotNavigationBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#E6FFFFFF" Offset="0" />
						<GradientStop Color="#8CEAF4FF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#F2FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotPreviewBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#BFDCEEFF" Offset="0" />
						<GradientStop Color="#6AB6D7F3" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#146CAAF0" />
					<LinearGradientBrush x:Key="ScreenshotMetadataBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#66FFFFFF" Offset="0" />
						<GradientStop Color="#3DEAF4FF" Offset="0.55" />
						<GradientStop Color="#2BFFFFFF" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotMetadataBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#D9FFFFFF" Offset="0" />
						<GradientStop Color="#66FFFFFF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotAccentBrush" Color="#FF4E8DEB" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Dark">
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#66FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotNavigationBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#B31A2738" Offset="0" />
						<GradientStop Color="#73335F8F" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#73FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotPreviewBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#80335F8F" Offset="0" />
						<GradientStop Color="#66111D2D" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#59376FAE" />
					<LinearGradientBrush x:Key="ScreenshotMetadataBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#7318273A" Offset="0" />
						<GradientStop Color="#4D16355C" Offset="0.55" />
						<GradientStop Color="#40101B2A" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotMetadataBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#66FFFFFF" Offset="0" />
						<GradientStop Color="#2BFFFFFF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotAccentBrush" Color="#FF4E8DEB" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Default">
					<SolidColorBrush x:Key="ScreenshotShellBorderBrush" Color="#E6FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotNavigationBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#E6FFFFFF" Offset="0" />
						<GradientStop Color="#8CEAF4FF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotNavigationBorderBrush" Color="#F2FFFFFF" />
					<LinearGradientBrush x:Key="ScreenshotPreviewBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#BFDCEEFF" Offset="0" />
						<GradientStop Color="#6AB6D7F3" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotPreviewShadowOverlayBrush" Color="#146CAAF0" />
					<LinearGradientBrush x:Key="ScreenshotMetadataBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#66FFFFFF" Offset="0" />
						<GradientStop Color="#3DEAF4FF" Offset="0.55" />
						<GradientStop Color="#2BFFFFFF" Offset="1" />
					</LinearGradientBrush>
					<LinearGradientBrush x:Key="ScreenshotMetadataBorderBrush" StartPoint="0,0" EndPoint="1,1">
						<GradientStop Color="#D9FFFFFF" Offset="0" />
						<GradientStop Color="#66FFFFFF" Offset="1" />
					</LinearGradientBrush>
					<SolidColorBrush x:Key="ScreenshotAccentBrush" Color="#FF4E8DEB" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>

			<Style x:Key="NavigationButtonStyle" TargetType="Button">
				<Setter Property="Width" Value="54" />
				<Setter Property="Height" Value="54" />
				<Setter Property="Padding" Value="0" />
				<Setter Property="CornerRadius" Value="27" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotNavigationBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotNavigationBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
			</Style>

			<Style x:Key="ScreenshotPreviewFrameStyle" TargetType="Border">
				<Setter Property="Width" Value="248" />
				<Setter Property="Height" Value="326" />
				<Setter Property="HorizontalAlignment" Value="Center" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotPreviewBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotShellBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="18" />
				<Setter Property="Padding" Value="4" />
			</Style>

			<Style
				x:Key="ScreenshotInfoLabelTextStyle"
				BasedOn="{StaticResource CaptionTextBlockStyle}"
				TargetType="TextBlock">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
				<Setter Property="FontSize" Value="11" />
				<Setter Property="FontWeight" Value="Normal" />
				<Setter Property="LineHeight" Value="14" />
				<Setter Property="CharacterSpacing" Value="10" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			</Style>

			<Style x:Key="ScreenshotInfoValueTextStyle" TargetType="TextBlock">
				<Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
				<Setter Property="FontSize" Value="14" />
				<Setter Property="FontWeight" Value="Normal" />
				<Setter Property="LineHeight" Value="20" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
				<Setter Property="TextTrimming" Value="CharacterEllipsis" />
				<Setter Property="MaxLines" Value="1" />
			</Style>

			<Style x:Key="ScreenshotInfoIconStyle" TargetType="FontIcon">
				<Setter Property="FontFamily" Value="Segoe Fluent Icons" />
				<Setter Property="FontSize" Value="16" />
				<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
				<Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
			</Style>

			<Style x:Key="ScreenshotMetadataPillStyle" TargetType="Border">
				<Setter Property="Height" Value="52" />
				<Setter Property="Padding" Value="16,0" />
				<Setter Property="Background" Value="{ThemeResource ScreenshotMetadataBackgroundBrush}" />
				<Setter Property="BorderBrush" Value="{ThemeResource ScreenshotMetadataBorderBrush}" />
				<Setter Property="BorderThickness" Value="1" />
				<Setter Property="CornerRadius" Value="26" />
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid x:Name="GallerySurface" MinHeight="526" Background="Transparent">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<controls:ScreenshotCoverFlowControl
			x:Name="CoverFlowView"
			Grid.Row="0"
			MinHeight="438" />

		<Border
			x:Name="MetadataPanel"
			Grid.Row="1"
			MaxWidth="884"
			Margin="32,14,32,0"
			HorizontalAlignment="Stretch"
			Background="Transparent"
			BorderBrush="Transparent"
			BorderThickness="0"
			Visibility="Collapsed">
			<Grid ColumnSpacing="40">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1.35*" />
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="1.53*" />
					<ColumnDefinition Width="1.07*" />
				</Grid.ColumnDefinitions>
				<Border Style="{StaticResource ScreenshotMetadataPillStyle}">
					<Grid HorizontalAlignment="Center" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<FontIcon VerticalAlignment="Center" Glyph="&#xE787;" Style="{StaticResource ScreenshotInfoIconStyle}" />
						<TextBlock Grid.Column="1" Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.DateLabel" Text="Date" Visibility="Collapsed" />
						<TextBlock x:Name="MetadataDateValueText" Grid.Column="1" MaxWidth="148" VerticalAlignment="Center" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
					</Grid>
				</Border>
				<Border Grid.Column="1" Style="{StaticResource ScreenshotMetadataPillStyle}">
					<Grid HorizontalAlignment="Center" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<FontIcon VerticalAlignment="Center" Glyph="&#xE823;" Style="{StaticResource ScreenshotInfoIconStyle}" />
						<TextBlock Grid.Column="1" Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.TimeLabel" Text="Time" Visibility="Collapsed" />
						<TextBlock x:Name="MetadataTimeValueText" Grid.Column="1" MaxWidth="94" VerticalAlignment="Center" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
					</Grid>
				</Border>
				<Border Grid.Column="2" Style="{StaticResource ScreenshotMetadataPillStyle}">
					<Grid HorizontalAlignment="Center" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<FontIcon VerticalAlignment="Center" Glyph="&#xE7F4;" Style="{StaticResource ScreenshotInfoIconStyle}" />
						<TextBlock Grid.Column="1" Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.ApplicationLabel" Text="Foreground app" Visibility="Collapsed" />
						<TextBlock x:Name="MetadataAppValueText" Grid.Column="1" MaxWidth="176" VerticalAlignment="Center" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
					</Grid>
				</Border>
				<Border Grid.Column="3" Style="{StaticResource ScreenshotMetadataPillStyle}">
					<Grid HorizontalAlignment="Center" ColumnSpacing="12">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<FontIcon VerticalAlignment="Center" Glyph="&#xE7C3;" Style="{StaticResource ScreenshotInfoIconStyle}" />
						<TextBlock Grid.Column="1" Style="{StaticResource ScreenshotInfoLabelTextStyle}" Tag="Screenshots.OriginLabel" Text="Origin" Visibility="Collapsed" />
						<TextBlock x:Name="MetadataOriginValueText" Grid.Column="1" MaxWidth="105" VerticalAlignment="Center" Style="{StaticResource ScreenshotInfoValueTextStyle}" Text="--" />
					</Grid>
				</Border>
			</Grid>
		</Border>

		<Grid x:Name="EmptyGalleryPanel" Grid.RowSpan="2" Background="Transparent" Visibility="Collapsed">
				<Border
					MaxWidth="360"
					Padding="24,20"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Background="{ThemeResource ScreenshotMetadataBackgroundBrush}"
					BorderBrush="{ThemeResource ScreenshotMetadataBorderBrush}"
					BorderThickness="1"
					CornerRadius="16">
					<StackPanel HorizontalAlignment="Center" Spacing="10">
						<FontIcon
							HorizontalAlignment="Center"
							FontFamily="Segoe Fluent Icons"
							FontSize="36"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Glyph="&#xE722;" />
						<TextBlock
							x:Name="EmptyGalleryText"
							Style="{StaticResource BodyTextBlockStyle}"
							Tag="Screenshots.Empty"
							Text="No screenshots for this day."
							TextAlignment="Center" />
					</StackPanel>
				</Border>
		</Grid>

		<ProgressRing
			x:Name="GalleryProgressRing"
			Grid.RowSpan="2"
			Width="30"
			Height="30"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			IsActive="False"
			Visibility="Collapsed" />
	</Grid>
</UserControl>
