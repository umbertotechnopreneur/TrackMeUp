<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotGalleryViewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <AcrylicBrush
                        x:Key="ScreenshotMetadataBackdropBrush"
                        FallbackColor="#EAF7F8FA"
                        TintColor="#FFFFFFFF"
                        TintLuminosityOpacity="0.16"
                        TintOpacity="0.04" />
                    <LinearGradientBrush x:Key="ScreenshotMetadataBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#A8FFFFFF" Offset="0" />
                        <GradientStop Color="#28717A84" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <AcrylicBrush
                        x:Key="ScreenshotMetadataBackdropBrush"
                        FallbackColor="#EA1B1E24"
                        TintColor="#FF15191F"
                        TintLuminosityOpacity="0.12"
                        TintOpacity="0.09" />
                    <LinearGradientBrush x:Key="ScreenshotMetadataBorderBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#62FFFFFF" Offset="0" />
                        <GradientStop Color="#16FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="ScreenshotMetadataBackdropBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="ScreenshotMetadataBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScreenshotMetadataChipStyle"
                   BasedOn="{StaticResource SurfaceChipStyle}"
                   TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ScreenshotMetadataBackdropBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ScreenshotMetadataBorderBrush}" />
            </Style>

            <Style x:Key="ScreenshotMetadataIconStyle"
                   BasedOn="{StaticResource SurfaceChipIconStyle}"
                   TargetType="FontIcon" />

            <Style x:Key="ScreenshotMetadataValueStyle"
                   BasedOn="{StaticResource SurfaceChipTextStyle}"
                   TargetType="TextBlock" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="GallerySurface" MinHeight="500" Background="Transparent">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="OverlayVisibilityStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition From="OverlayHidden" To="OverlayVisible">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="MetadataPanel"
                                Storyboard.TargetProperty="Opacity"
                                To="1"
                                Duration="0:0:0.16" />
                        </Storyboard>
                    </VisualTransition>
                    <VisualTransition From="OverlayVisible" To="OverlayHidden">
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="MetadataPanel"
                                Storyboard.TargetProperty="Opacity"
                                BeginTime="0:0:0.04"
                                To="0"
                                Duration="0:0:0.16" />
                        </Storyboard>
                    </VisualTransition>
                </VisualStateGroup.Transitions>
                <VisualState x:Name="OverlayHidden">
                    <VisualState.Setters>
                        <Setter Target="MetadataPanel.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="OverlayVisible">
                    <VisualState.Setters>
                        <Setter Target="MetadataPanel.Opacity" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <controls:ScreenshotImageViewerControl
            x:Name="ImageViewer"
            MinHeight="400" />

        <Grid
            x:Name="MetadataPanel"
            MaxWidth="760"
            Margin="0,0,0,130"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            ColumnSpacing="26"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ScreenshotMetadataChipStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                    <FontIcon Glyph="&#xE787;" Style="{StaticResource ScreenshotMetadataIconStyle}" />
                    <TextBlock x:Name="MetadataDateValueText" Style="{StaticResource ScreenshotMetadataValueStyle}" Text="--" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource ScreenshotMetadataChipStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                    <FontIcon Glyph="&#xE823;" Style="{StaticResource ScreenshotMetadataIconStyle}" />
                    <TextBlock x:Name="MetadataTimeValueText" Style="{StaticResource ScreenshotMetadataValueStyle}" Text="--" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ScreenshotMetadataChipStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="11">
                    <FontIcon Glyph="&#xE7F4;" Style="{StaticResource ScreenshotMetadataIconStyle}" />
                    <TextBlock x:Name="MetadataAppValueText" Style="{StaticResource ScreenshotMetadataValueStyle}" Text="--" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EmptyGalleryPanel" Background="Transparent" Visibility="Collapsed">
            <StackPanel
                MaxWidth="360"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <FontIcon
                    HorizontalAlignment="Center"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="36"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE722;" />
                <TextBlock
                    x:Name="EmptyGalleryText"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Tag="Screenshots.Empty"
                    Text="No screenshots for this day."
                    TextAlignment="Center" />
            </StackPanel>
        </Grid>

        <ProgressRing
            x:Name="GalleryProgressRing"
            Width="30"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="False"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
