<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ScreenshotDetailLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="65" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="ScreenshotDetailValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Padding="20,2,4,18">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Tag="Screenshots.Details.Title"
                Text="Snapshot details" />
            <TextBlock
                x:Name="CapturedAtSummaryText"
                Margin="0,4,0,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="--" />

            <Rectangle
                Height="1"
                Margin="0,18,0,16"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Style="{StaticResource ScreenshotDetailLabelStyle}"
                        Tag="Screenshots.ActivityIndex"
                        Text="ACTIVITY INDEX" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Tag="Screenshots.ActivityIndex.Description"
                        Text="Input activity near this capture" />
                </StackPanel>
                <TextBlock
                    x:Name="ActivityIndexValueText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="30"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="--" />
            </Grid>

            <Rectangle
                Height="1"
                Margin="0,16"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock
                Style="{StaticResource ScreenshotDetailLabelStyle}"
                Tag="Screenshots.AiDescription"
                Text="AI DESCRIPTION" />
            <StackPanel
                x:Name="AiMarkdownHost"
                Margin="0,10,0,0"
                Spacing="8" />
            <TextBlock
                x:Name="NoAiDescriptionText"
                Margin="0,8,0,0"
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Tag="Screenshots.AiDescription.Empty"
                Text="No AI description is available for this capture."
                TextWrapping="Wrap" />
            <StackPanel
                x:Name="AnalysisTimePanel"
                Margin="0,10,0,0"
                Orientation="Horizontal"
                Spacing="5"
                Visibility="Collapsed">
                <TextBlock
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Tag="Screenshots.AiAnalyzedAt"
                    Text="Analyzed" />
                <TextBlock
                    x:Name="AnalysisTimeValueText"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="--" />
            </StackPanel>

            <Rectangle
                Height="1"
                Margin="0,18,0,16"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.ApplicationLabel" Text="FOREGROUND APP" />
            <TextBlock x:Name="ApplicationValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.CaptureKind" Text="CAPTURE" />
            <TextBlock x:Name="CaptureKindValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.OriginLabel" Text="ORIGIN" />
            <TextBlock x:Name="OriginValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.SpanLabels" Text="ACTIVITY LABELS" />
            <TextBlock x:Name="ActivityLabelsValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
