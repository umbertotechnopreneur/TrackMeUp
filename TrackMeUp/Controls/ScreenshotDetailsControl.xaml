<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotDetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FF4E8DEB" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FFFFA45E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ScreenshotDetailAccentBrush" Color="#FF4E8DEB" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="ScreenshotDetailSectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="25" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ScreenshotDetailLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="ScreenshotDetailValueStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,3,0,0" />
                <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ScreenshotDetailRowStyle" TargetType="Border">
                <Setter Property="MinHeight" Value="60" />
                <Setter Property="Padding" Value="0,12" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto">
        <StackPanel Padding="24,22,24,28" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Tag="Screenshots.Details.Title"
                    Text="Snapshot details" />
                <TextBlock
                    x:Name="CapturedAtSummaryText"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="--"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="22"
                        Foreground="{ThemeResource ScreenshotDetailAccentBrush}"
                        Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource ScreenshotDetailLabelStyle}"
                            Tag="Screenshots.ActivityIndex"
                            Text="ACTIVITY INDEX" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Tag="Screenshots.ActivityIndex.Description"
                            Text="Input activity near this capture"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        x:Name="ActivityIndexValueText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource ScreenshotDetailAccentBrush}"
                        Text="--" />
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock
                    Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                    Tag="Screenshots.Metadata"
                    Text="CAPTURE DETAILS" />

                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ScreenshotDetailRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.ApplicationLabel" Text="FOREGROUND APP" />
                            <TextBlock x:Name="ApplicationValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource ScreenshotDetailRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.CaptureKind" Text="CAPTURE" />
                            <TextBlock x:Name="CaptureKindValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource ScreenshotDetailRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.OriginLabel" Text="ORIGIN" />
                            <TextBlock x:Name="OriginValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ScreenshotDetailRowStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource ScreenshotDetailLabelStyle}" Tag="Screenshots.SpanLabels" Text="ACTIVITY LABELS" />
                            <TextBlock x:Name="ActivityLabelsValueText" Style="{StaticResource ScreenshotDetailValueStyle}" Text="--" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="9">
                <TextBlock
                    Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                    Tag="Screenshots.AiDescription"
                    Text="AI DESCRIPTION" />
                <StackPanel
                    x:Name="AiMarkdownHost"
                    Spacing="8" />
                <TextBlock
                    x:Name="NoAiDescriptionText"
                    FontSize="14"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Tag="Screenshots.AiDescription.Empty"
                    Text="No AI description is available for this capture."
                    TextWrapping="Wrap" />
                <StackPanel
                    x:Name="AnalysisTimePanel"
                    Orientation="Horizontal"
                    Spacing="5"
                    Visibility="Collapsed">
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Tag="Screenshots.AiAnalyzedAt"
                        Text="Analyzed" />
                    <TextBlock
                        x:Name="AnalysisTimeValueText"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="--" />
                </StackPanel>
            </StackPanel>

            <StackPanel
                x:Name="OcrTextSection"
                Spacing="6"
                Visibility="Collapsed">
                <TextBlock
                    Style="{StaticResource ScreenshotDetailSectionTitleStyle}"
                    Tag="Screenshots.OcrText.Details.Title"
                    Text="OCR TEXT" />
                <Button
                    x:Name="OpenOcrTextButton"
                    MinHeight="36"
                    Padding="0,6"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Open OCR text in a new window"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    Click="OpenOcrTextButton_Click"
                    Tag="Screenshots.OcrText.Details.Open"
                    ToolTipService.ToolTip="Open OCR text in a new window">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <TextBlock
                            Tag="Screenshots.OcrText.Details.Action"
                            Text="Open OCR text" />
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="13"
                            Glyph="&#xE8A7;" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
