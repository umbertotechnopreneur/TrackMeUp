<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="146" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center" Spacing="6">
            <TextBlock
                x:Name="ExtendedDateText"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                FontSize="34"
                FontWeight="SemiLight"
                LineHeight="42"
                MaxLines="1"
                Text="Sunday, 9 August 2026"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Glyph="&#xE8B9;" />
                <TextBlock
                    x:Name="GalleryCountText"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    LineHeight="18"
                    Text="0 captures" />
            </StackPanel>
            <Grid Width="104" Height="52" Margin="0,4,0,0" HorizontalAlignment="Left">
                <CalendarDatePicker
                    x:Name="SelectedDatePicker"
                    Width="1"
                    Height="1"
                    MinWidth="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Screenshot date"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    DateFormat="{}{dayofweek.abbreviated}, {day.integer} {month.full} {year.full}"
                    IsTabStop="False"
                    Opacity="0"
                    PlaceholderText="Select a day" />
                <Button
                    Width="104"
                    Height="52"
                    Padding="0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Choose screenshot date"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="OpenDatePickerButton_Click"
                    CornerRadius="8"
                    Tag="Screenshots.Date.Choose"
                    ToolTipService.ToolTip="Choose screenshot date">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <FontIcon
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Glyph="&#xE787;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            Tag="Screenshots.Date.Select"
                            Text="Select date" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
