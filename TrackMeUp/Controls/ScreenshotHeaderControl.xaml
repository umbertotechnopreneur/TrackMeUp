<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TrackMeUp.Controls.ScreenshotHeaderControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MinHeight="86" VerticalAlignment="Center" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Spacing="5">
            <TextBlock
                x:Name="ExtendedDateText"
                FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                FontSize="34"
                FontWeight="Light"
                LineHeight="42"
                MaxLines="1"
                Text="Sunday, 9 August 2026"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="7">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Glyph="&#xE8B9;" />
                <TextBlock
                    x:Name="GalleryCountText"
                    VerticalAlignment="Center"
                    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                    FontSize="12"
                    FontWeight="Normal"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    LineHeight="16"
                    Text="0 captures" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" Width="42" Height="42" VerticalAlignment="Center">
            <CalendarDatePicker
                x:Name="SelectedDatePicker"
                Width="1"
                Height="1"
                MinWidth="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="Screenshot date"
                Background="Transparent"
                BorderBrush="Transparent"
                DateFormat="{}{dayofweek.abbreviated}, {day.integer} {month.full} {year.full}"
                IsTabStop="False"
                Opacity="0"
                PlaceholderText="Select a day" />
            <Button
                Width="42"
                Height="42"
                Padding="0"
                AutomationProperties.Name="Choose screenshot date"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="OpenDatePickerButton_Click"
                CornerRadius="21"
                Tag="Screenshots.Date.Choose"
                ToolTipService.ToolTip="Choose screenshot date">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontFamily="Segoe Fluent Icons"
                    FontSize="17"
                    Glyph="&#xE787;" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
