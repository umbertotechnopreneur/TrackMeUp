<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Search snapshots">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <SolidColorBrush x:Key="SearchActivityStatusBrush" Color="#FF8A3E32" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
        </Grid>

        <Grid Grid.Row="1" Padding="28,8,28,18" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <AutoSuggestBox
                    x:Name="QueryBox"
                    MinHeight="48"
                    Tag="Search.Placeholder"
                    AutomationProperties.Name="Search snapshots"
                    CornerRadius="8"
                    FontSize="18"
                    GotFocus="QueryBox_GotFocus"
                    HorizontalContentAlignment="Stretch"
                    PlaceholderText="Search text in snapshots"
                    QuerySubmitted="QueryBox_QuerySubmitted"
                    TextChanged="QueryBox_TextChanged"
                    VerticalContentAlignment="Center">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Border
                    x:Name="SearchActivityGlow"
                    Height="3"
                    Margin="12,0,12,-1"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    CornerRadius="2"
                    Opacity="0.72"
                    Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFF8C78" />
                            <GradientStop Offset="0.5" Color="#FFA56EFF" />
                            <GradientStop Offset="1" Color="#FF46D4C8" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SearchAvailabilityText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="WrapWholeWords" />
                <StackPanel
                    x:Name="SearchActivityStatus"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                    <ProgressRing
                        x:Name="SearchActivityProgressRing"
                        Width="14"
                        Height="14"
                        IsActive="True"
                        IsHitTestVisible="False" />
                    <TextBlock
                        Tag="Search.Working"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource SearchActivityStatusBrush}"
                        Text="Searching the local index" />
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="SearchInfoBar"
                Grid.Row="2"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Grid Grid.Row="3">
                <ListView
                    x:Name="SearchResultsList"
                    Margin="0"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemClick="SearchResultsList_ItemClick"
                    ItemsSource="{Binding Results, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:SearchResultItemControl Result="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyStatePanel"
                    Margin="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Fill="{StaticResource SearchActivityStatusBrush}" />
                    <TextBlock
                        Tag="Search.NoResults"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No matching snapshots"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
