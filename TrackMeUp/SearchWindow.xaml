<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Search snapshots">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarDragRegion" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
        </Grid>

        <Grid x:Name="SearchQueryHost" Grid.Row="1" Margin="24,2,24,12">
            <AutoSuggestBox
                x:Name="QueryBox"
                MinHeight="48"
                Tag="Search.Placeholder"
                AutomationProperties.Name="Search snapshots"
                CornerRadius="10"
                FontSize="17"
                GotFocus="QueryBox_GotFocus"
                HorizontalContentAlignment="Stretch"
                PlaceholderText="Search text in snapshots"
                QuerySubmitted="QueryBox_QuerySubmitted"
                TextChanged="QueryBox_TextChanged"
                VerticalContentAlignment="Center">
                <AutoSuggestBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#D9FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#406F75B5" />
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
                </AutoSuggestBox.Resources>
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" />
                </AutoSuggestBox.KeyboardAccelerators>
            </AutoSuggestBox>
            <controls:SearchActivityLine
                x:Name="SearchActivityGlow"
                Height="2"
                Margin="12,0,12,0"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False"
                AutomationProperties.AccessibilityView="Raw" />
        </Grid>

        <InfoBar
            x:Name="SearchInfoBar"
            Grid.Row="2"
            Margin="24,0,24,8"
            IsClosable="True"
            IsOpen="False"
            Severity="Error" />

        <Grid x:Name="SearchStatusRow" Grid.Row="3" Margin="24,0,24,12" MinHeight="24" Visibility="Collapsed">
            <Grid x:Name="EmptyStatePanel" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;" FontSize="16" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Tag="Search.NoResults" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No matching snapshots" TextWrapping="WrapWholeWords" />
            </Grid>
            <Grid x:Name="SearchActivityStatus" ColumnSpacing="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ProgressRing x:Name="SearchActivityProgressRing" Width="18" Height="18" MinWidth="0" MinHeight="0" VerticalAlignment="Center" IsActive="False" IsHitTestVisible="False" />
                <TextBlock Grid.Column="1" Tag="Search.Working" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Searching the local index" TextWrapping="WrapWholeWords" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid x:Name="ResultsSurface" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ResultsListColumn" Width="2*" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ResultsListRow" Height="*" />
                    <RowDefinition x:Name="PreviewRow" Height="0" />
                </Grid.RowDefinitions>
                <Grid x:Name="SearchResultsPane" Padding="16,8,16,12" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="ResultCountText"
                        Margin="10,0,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="13"
                        TextWrapping="WrapWholeWords" />
                    <ListView
                        x:Name="SearchResultsList"
                        Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Results, Mode=OneWay}"
                        SelectionChanged="SearchResultsList_SelectionChanged"
                        KeyDown="SearchResultsList_KeyDown"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollMode="Disabled"
                        SelectionMode="Single"
                        IsItemClickEnabled="False">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel /></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate><controls:SearchResultItemControl Result="{Binding}" /></DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid
                    x:Name="PreviewPane"
                    Grid.Column="1"
                    Padding="24,12,24,16"
                    RowSpacing="16"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        x:Name="PreviewScroller"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Tag="Search.Preview.Title"
                                CharacterSpacing="50"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="TEXT PREVIEW"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="PreviewTitleText"
                                AutomationProperties.HeadingLevel="Level2"
                                FontSize="20"
                                FontWeight="SemiBold"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding SourceDisplay}"
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                x:Name="PreviewInstallationText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding InstallationDisplay}"
                                TextWrapping="WrapWholeWords"
                                Visibility="Collapsed" />
                            <Border
                                Margin="0,12,0,0"
                                Padding="12,0,0,0"
                                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                BorderThickness="2,0,0,0">
                                <TextBlock
                                    x:Name="PreviewBodyText"
                                    FontSize="15"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Button
                        x:Name="OpenSnapshotButton"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Click="OpenSnapshotButton_Click"
                        Content="Open snapshot"
                        Tag="Search.Preview.Open" />
                </Grid>
            </Grid>

        </Grid>

        <Grid
            x:Name="SearchFooter"
            Grid.Row="5"
            Padding="24,10"
            ColumnSpacing="16"
            BorderBrush="#14000000"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SearchAvailabilityText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
            <Grid Grid.Column="1" HorizontalAlignment="Right" ColumnSpacing="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse x:Name="TextReadingStatusDot" Width="6" Height="6" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                <TextBlock x:Name="TextReadingStatusText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="WrapWholeWords" />
            </Grid>
        </Grid>
    </Grid>
</Window>
