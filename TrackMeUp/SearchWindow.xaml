<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.SearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="Search snapshots">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <SolidColorBrush x:Key="SearchSuggestionAccentBrush" Color="#FFFF8C78" />
            <SolidColorBrush x:Key="SearchSuggestionBadgeBrush" Color="#20FF8C78" />
            <SolidColorBrush x:Key="SearchSuggestionBadgeTextBrush" Color="#FF8A3E32" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="40"
            Loaded="TitleBarDragRegion_Loaded"
            SizeChanged="TitleBarDragRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
        </Grid>

        <Grid Grid.Row="1" Padding="28,8,28,18" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <AutoSuggestBox
                    x:Name="QueryBox"
                    MinHeight="48"
                    Tag="Search.Placeholder"
                    AutomationProperties.Name="Search snapshots"
                    CornerRadius="8"
                    FontSize="18"
                    GotFocus="QueryBox_GotFocus"
                    HorizontalContentAlignment="Stretch"
                    MaxSuggestionListHeight="320"
                    PlaceholderText="Search text in snapshots"
                    QuerySubmitted="QueryBox_QuerySubmitted"
                    TextMemberPath="Text"
                    TextChanged="QueryBox_TextChanged"
                    VerticalContentAlignment="Center">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                MinHeight="46"
                                Padding="12,6"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="{Binding Text}"
                                AutomationProperties.HelpText="{Binding ConfidenceLabel}"
                                ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Fill="{StaticResource SearchSuggestionAccentBrush}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    MaxLines="1"
                                    Text="{Binding Text}"
                                    TextTrimming="CharacterEllipsis" />
                                <Border
                                    Grid.Column="2"
                                    MinWidth="48"
                                    Padding="9,3"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource SearchSuggestionBadgeBrush}"
                                    CornerRadius="10"
                                    ToolTipService.ToolTip="{Binding ConfidenceLabel}">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource SearchSuggestionBadgeTextBrush}"
                                        Text="{Binding ConfidenceDisplay}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                    <AutoSuggestBox.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </AutoSuggestBox.KeyboardAccelerators>
                </AutoSuggestBox>
                <Border
                    x:Name="SearchActivityGlow"
                    Height="9"
                    Margin="12,0,12,-1"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    SizeChanged="SearchActivityGlow_SizeChanged"
                    Visibility="Collapsed">
                    <Grid>
                        <Border
                            x:Name="SearchActivitySpectrum"
                            Height="3"
                            VerticalAlignment="Center"
                            CornerRadius="2"
                            Opacity="0.72"
                            Translation="0,0,12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00FF8C78" />
                                    <GradientStop x:Name="SearchActivityLeftFadeStop" Offset="0.055" Color="#FFFF8C78" />
                                    <GradientStop Offset="0.28" Color="#FFFFC15C" />
                                    <GradientStop Offset="0.5" Color="#FFA56EFF" />
                                    <GradientStop Offset="0.72" Color="#FF4F8DFF" />
                                    <GradientStop x:Name="SearchActivityRightFadeStop" Offset="0.945" Color="#FF46D4C8" />
                                    <GradientStop Offset="1" Color="#0046D4C8" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                        </Border>
                        <ProgressBar
                            x:Name="SearchActivityBar"
                            AutomationProperties.Name="Searching the local index"
                            IsHitTestVisible="False"
                            IsIndeterminate="True"
                            IsTabStop="False"
                            Opacity="0" />
                    </Grid>
                </Border>
            </Grid>

            <TextBlock
                x:Name="SearchAvailabilityText"
                Grid.Row="1"
                Margin="4,0"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="WrapWholeWords" />

            <InfoBar
                x:Name="SearchInfoBar"
                Grid.Row="2"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />

            <Grid Grid.Row="3">
                <ListView
                    x:Name="SearchResultsList"
                    Margin="0"
                    HorizontalContentAlignment="Stretch"
                    IsItemClickEnabled="True"
                    ItemClick="SearchResultsList_ItemClick"
                    ItemsSource="{Binding Results, Mode=OneWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    SelectionMode="None"
                    Visibility="Collapsed">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <controls:SearchResultItemControl Result="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    x:Name="EmptyStatePanel"
                    Margin="4,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="8"
                    Visibility="Collapsed">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Fill="{StaticResource SearchSuggestionAccentBrush}" />
                    <TextBlock
                        Tag="Search.NoResults"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="No matching snapshots"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
