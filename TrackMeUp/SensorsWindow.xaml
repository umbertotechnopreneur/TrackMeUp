<Window x:Class="TrackMeUp.SensorsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls" Title="TrackMeUp">
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="HeaderDragRegion" Background="{ThemeResource TrackMeUpTitleBarOverlayBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="1" Margin="8,0,0,0" Click="BackButton_Click" Visibility="Collapsed"
                Tag="Sensors.Back" AutomationProperties.Name="Back to sensors" ToolTipService.ToolTip="Back to sensors"
                Style="{StaticResource TrackMeUpTitleBarCommandButtonStyle}">
                <FontIcon Glyph="&#xE72B;" FontSize="17" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
            <TextBlock x:Name="HeaderText" Grid.Column="2" Margin="16,0,12,0" TextTrimming="CharacterEllipsis" Style="{StaticResource TrackMeUpTitleBarLabelStyle}"/>
            <Button x:Name="OptionsButton" Grid.Column="3" Click="OptionsButton_Click" Tag="Sensors.Options.Open" AutomationProperties.Name="Sensor options" ToolTipService.ToolTip="Sensor options" Style="{StaticResource TrackMeUpTitleBarCommandButtonStyle}">
                <FontIcon Glyph="&#xE712;" FontSize="19" AutomationProperties.AccessibilityView="Raw"/>
            </Button>
        </Grid>
        <Grid x:Name="MonitorSurface" Grid.Row="1" Margin="16,4,16,8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Visibility="Collapsed" Margin="0,4,0,4" FontSize="12" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Grid x:Name="TracksHost" Grid.Row="1" SizeChanged="TracksHost_SizeChanged"/>
            <Grid Grid.Row="2" Height="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HistoryText" Tag="Sensors.HistoryShort" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <StackPanel x:Name="PageNavigation" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Visibility="Collapsed">
                    <Button x:Name="PreviousPageButton" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderThickness="0" Click="PreviousPageButton_Click"
                        Tag="Sensors.PreviousPage" AutomationProperties.Name="Previous devices" ToolTipService.ToolTip="Previous devices">
                        <FontIcon Glyph="&#xE76B;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                    <TextBlock x:Name="PageText" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Button x:Name="NextPageButton" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0" Background="Transparent" BorderThickness="0" Click="NextPageButton_Click"
                        Tag="Sensors.NextPage" AutomationProperties.Name="Next devices" ToolTipService.ToolTip="Next devices">
                        <FontIcon Glyph="&#xE76C;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <ScrollViewer x:Name="OptionsSurface" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <controls:SensorOptionsControl x:Name="SensorOptions" Margin="24" MaxWidth="760" HorizontalAlignment="Stretch"/>
        </ScrollViewer>
    </Grid>
</Window>
