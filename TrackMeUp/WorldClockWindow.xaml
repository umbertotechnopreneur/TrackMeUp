<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.WorldClockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp World Clocks">
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        Loaded="RootGrid_Loaded">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="WorldClockWindowTintBrush" Color="#6CFFFFFF" />
                        <SolidColorBrush x:Key="WorldClockHeaderTintBrush" Color="#24FFFFFF" />
                        <SolidColorBrush x:Key="WorldClockReferenceFieldBrush" Color="#30FFFFFF" />
                        <SolidColorBrush x:Key="WorldClockOptionsOverlayBrush" Color="#F2FAFAFA" />
                        <SolidColorBrush x:Key="WorldClockColumnDividerBrush" Color="#26000000" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="WorldClockWindowTintBrush" Color="#5A151619" />
                        <SolidColorBrush x:Key="WorldClockHeaderTintBrush" Color="#22151619" />
                        <SolidColorBrush x:Key="WorldClockReferenceFieldBrush" Color="#24101114" />
                        <SolidColorBrush x:Key="WorldClockOptionsOverlayBrush" Color="#F2141518" />
                        <SolidColorBrush x:Key="WorldClockColumnDividerBrush" Color="#34FFFFFF" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="WorldClockWindowTintBrush" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="WorldClockHeaderTintBrush" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="WorldClockReferenceFieldBrush" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="WorldClockOptionsOverlayBrush" ResourceKey="SystemColorWindowColorBrush" />
                        <StaticResource x:Key="WorldClockColumnDividerBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.RowSpan="2"
            Background="{ThemeResource WorldClockWindowTintBrush}"
            IsHitTestVisible="False" />
        <Border
            x:Name="ColumnDividerResource"
            BorderBrush="{ThemeResource WorldClockColumnDividerBrush}"
            Visibility="Collapsed" />

        <Grid
            x:Name="HeaderDragRegion"
            Grid.Row="0"
            Background="{ThemeResource WorldClockHeaderTintBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Loaded="HeaderDragRegion_Loaded"
            SizeChanged="HeaderDragRegion_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="328" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="1"
                Margin="24,0,12,0"
                VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="HeaderBackButton"
                    Width="40"
                    Height="40"
                    Margin="-8,0,8,0"
                    Padding="8"
                    AutomationProperties.Name="Back to world clocks"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="HeaderBackButton_Click"
                    Style="{StaticResource TitleBarOverflowButtonStyle}"
                    Tag="WorldClock.Options.Back"
                    ToolTipService.ToolTip="Back to world clocks"
                    Visibility="Collapsed">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="17"
                        Glyph="&#xE72B;" />
                </Button>
                <TextBlock
                    x:Name="ReferenceInstantLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    CharacterSpacing="70"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Tag="WorldClock.ReferenceInstant"
                    Text="REFERENCE INSTANT"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="OptionsHeaderLabel"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    CharacterSpacing="70"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="WORLD CLOCK OPTIONS"
                    TextTrimming="CharacterEllipsis"
                    Visibility="Collapsed" />
            </Grid>

            <DropDownButton
                x:Name="ReferenceInstantButton"
                Grid.Column="2"
                Height="46"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Reference instant"
                Background="{ThemeResource WorldClockReferenceFieldBrush}"
                BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Tag="WorldClock.ReferenceInstant">
                <DropDownButton.Content>
                    <TextBlock
                        x:Name="ReferenceInstantText"
                        HorizontalAlignment="Center"
                        CharacterSpacing="90"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="15"
                        Text="-- · --:--" />
                </DropDownButton.Content>
                <DropDownButton.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="340" Spacing="12">
                            <ComboBox
                                x:Name="ReferenceCityComboBox"
                                DisplayMemberPath="CityName"
                                Header="Reference city"
                                SelectionChanged="ReferenceCityComboBox_SelectionChanged"
                                Tag="WorldClock.ReferenceCity" />
                            <CalendarDatePicker
                                x:Name="ReferenceDatePicker"
                                HorizontalAlignment="Stretch"
                                DateChanged="ReferenceDatePicker_DateChanged"
                                Header="Date"
                                Tag="WorldClock.ReferenceDate" />
                            <TimePicker
                                x:Name="ReferenceTimePicker"
                                HorizontalAlignment="Stretch"
                                ClockIdentifier="24HourClock"
                                Header="Time"
                                MinuteIncrement="1"
                                Tag="WorldClock.ReferenceTime"
                                TimeChanged="ReferenceTimePicker_TimeChanged" />
                            <Button
                                x:Name="NowButton"
                                HorizontalAlignment="Right"
                                Click="NowButton_Click"
                                Content="Now"
                                Tag="WorldClock.Now"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>

            <Button
                x:Name="OptionsButton"
                Grid.Column="4"
                Width="40"
                Height="40"
                Margin="0,0,4,0"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open world clock options"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="OptionsButton_Click"
                Style="{StaticResource TitleBarOverflowButtonStyle}"
                Tag="WorldClock.Options.Open"
                ToolTipService.ToolTip="Open world clock options">
                <SymbolIcon
                    AutomationProperties.AccessibilityView="Raw"
                    Symbol="More" />
            </Button>
        </Grid>

        <Grid
            x:Name="ClocksSurface"
            Grid.Row="1">
            <HyperlinkButton
                x:Name="WeatherAttributionButton"
                Margin="0,0,16,76"
                Padding="4,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Canvas.ZIndex="10"
                Click="WeatherAttributionButton_Click"
                Tag="WorldClock.WeatherAttribution"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border
                        x:Name="WeatherAttributionLogoContainer"
                        Padding="3,1"
                        Background="White"
                        CornerRadius="3"
                        Visibility="Collapsed">
                        <Image
                            x:Name="WeatherAttributionLogo"
                            Width="44"
                            Height="17"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <TextBlock
                        x:Name="WeatherAttributionText"
                        VerticalAlignment="Center"
                        FontSize="9"
                        Text="Weather data provided by OpenWeather" />
                </StackPanel>
            </HyperlinkButton>

            <ScrollViewer
                x:Name="ClockColumnsScroller"
                HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                SizeChanged="ClockColumnsScroller_SizeChanged"
                VerticalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid
                    x:Name="ClockColumnsHost"
                    AutomationProperties.LandmarkType="Custom" />
            </ScrollViewer>

            <ProgressRing
                x:Name="LoadingIndicator"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.Name="Loading world clocks"
                IsActive="False"
                Visibility="Collapsed" />
        </Grid>

        <Border
            x:Name="OptionsPanel"
            Grid.Row="1"
            Background="{ThemeResource WorldClockOptionsOverlayBrush}"
            Canvas.ZIndex="50"
            Visibility="Collapsed">
            <ContentPresenter x:Name="OptionsHost" />
        </Border>

        <controls:TimedInfoBar
            x:Name="WorldClockNotificationBanner"
            Grid.Row="1"
            Margin="24,0,24,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="100" />
    </Grid>
</Window>
