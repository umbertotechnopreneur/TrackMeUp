<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.MicaDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        KeyDown="RootGrid_KeyDown"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle
            x:Name="AccentVeil"
            Grid.RowSpan="2"
            IsHitTestVisible="False" />

        <Grid
            x:Name="TitleDragRegion"
            Grid.Row="0"
            Padding="22,0">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                CharacterSpacing="150"
                Text="TRACK ME UP" />
        </Grid>

        <Grid
            x:Name="DialogBody"
            Grid.Row="1"
            Padding="24,10,24,22"
            ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                x:Name="SeverityIcon"
                Width="36"
                Height="36"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                FontSize="30" />

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="DialogTitleText"
                    AutomationProperties.LiveSetting="Assertive"
                    FontSize="20"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    x:Name="MessageScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled">
                    <TextBlock
                        x:Name="DialogMessageText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="21"
                        TextWrapping="WrapWholeWords" />
                </ScrollViewer>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="CancelButton"
                        Click="CancelButton_Click"
                        MinWidth="88"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="PrimaryButton"
                        Click="PrimaryButton_Click"
                        MinWidth="88"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
