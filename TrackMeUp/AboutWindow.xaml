<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="About TrackMeUp">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="TitleBarDragRegion"
            Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Image
                Grid.Column="1"
                Margin="16,0,0,0"
                Style="{StaticResource TrackMeUpTitleBarLogoStyle}" />
            <TextBlock
                Grid.Column="2"
                Margin="10,0,12,0"
                AutomationProperties.AccessibilityView="Raw"
                CharacterSpacing="90"
                Style="{StaticResource TrackMeUpTitleBarLabelStyle}"
                Text="TRACK ME UP" />
        </Grid>

        <Grid Grid.Row="1" Padding="28,12,28,24" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <Image
                    x:Name="HeroImage"
                    AutomationProperties.Name="TrackMeUp"
                    HorizontalAlignment="Stretch"
                    Stretch="UniformToFill"
                    VerticalAlignment="Stretch" />
            </Border>

            <Rectangle
                Grid.Row="1"
                Height="1"
                Margin="0,20,0,20"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Grid Grid.Row="2" ColumnSpacing="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                    <TextBlock
                        Tag="About.Description"
                        FontSize="17"
                        MaxLines="3"
                        Opacity="0.82"
                        Text="Simple desktop activity tracking that respects your privacy."
                        TextTrimming="WordEllipsis"
                        TextWrapping="WrapWholeWords" />

                    <Grid ColumnSpacing="18" RowSpacing="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Tag="About.Version" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Version" />
                        <TextBlock x:Name="VersionText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />

                        <TextBlock Grid.Row="1" Tag="About.Built" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Built" />
                        <TextBlock x:Name="BuiltAtText" Grid.Row="1" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />

                        <TextBlock Grid.Row="2" Tag="About.Commit" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Git commit" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="7">
                            <TextBlock x:Name="CommitText" FontFamily="Consolas" Style="{StaticResource CaptionTextBlockStyle}" Text="—" />
                            <TextBlock
                                x:Name="DirtyIndicator"
                                Tag="About.Dirty"
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="uncommitted changes"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Button
                            x:Name="IssuesButton"
                            Padding="0,5"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="IssuesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="15" Glyph="&#xE783;" />
                                <TextBlock Tag="About.Issues" Text="Report a problem" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="LicensesButton"
                            Padding="0,5"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="LicensesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="15" Glyph="&#xE8A7;" />
                                <TextBlock Tag="About.ThirdPartyLicenses" Text="Third-party licenses" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Rectangle
                    Grid.Column="1"
                    Width="1"
                    HorizontalAlignment="Center"
                    Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Grid.Column="2" Spacing="10">
                    <StackPanel Spacing="5">
                        <TextBlock Tag="About.Diagnostics" FontSize="20" FontWeight="SemiBold" Text="Diagnostics" />
                        <TextBlock
                            Tag="About.Diagnostics.Description"
                            MaxLines="3"
                            Opacity="0.72"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Open the current log, or share a bounded copy with private paths and secrets removed."
                            TextTrimming="WordEllipsis"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Name="ShowLogButton"
                            Tag="About.ShowLogs"
                            MinWidth="128"
                            MinHeight="38"
                            HorizontalContentAlignment="Center"
                            Click="ShowLogButton_Click"
                            Content="View logs" />
                        <Button
                            x:Name="ShareLogButton"
                            Tag="About.ShareLog"
                            MinWidth="128"
                            MinHeight="38"
                            HorizontalContentAlignment="Center"
                            Click="ShareLogButton_Click"
                            Content="Share log" />
                    </StackPanel>
                    <InfoBar
                        x:Name="DiagnosticsInfoBar"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Informational" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,22,0,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock Tag="About.CreatedBy" Opacity="0.62" Style="{StaticResource CaptionTextBlockStyle}" Text="Created by" />
                    <Button
                        x:Name="CreatedByButton"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="WebsiteButton_Click"
                        Content="umbertogiacobbi.biz" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                        <FontIcon AutomationProperties.AccessibilityView="Raw" FontSize="21" Foreground="#FFFFD12E" Glyph="&#xE735;" />
                        <TextBlock
                            Tag="About.FavoriteMessage"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Like the app? Star it on GitHub,&#xA;or leave a review on the Microsoft Store!"
                            TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Button
                        x:Name="RepositoryFooterButton"
                        Padding="12,7"
                        HorizontalAlignment="Center"
                        Click="RepositoryButton_Click"
                        Content="GitHub repository"
                        Tag="About.Repository">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon AutomationProperties.AccessibilityView="Raw" Glyph="&#xE8A7;" />
                                    <TextBlock Text="{Binding}" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="CloseButton"
                    Tag="About.Close"
                    Grid.Column="2"
                    MinWidth="120"
                    MinHeight="40"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    Click="CloseButton_Click"
                    Content="Close"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
