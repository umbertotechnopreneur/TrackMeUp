<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TrackMeUp.ActivityLabelsDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TrackMeUp.Controls"
    Title="TrackMeUp">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="RootGrid" Background="Transparent" Loaded="RootGrid_Loaded" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleDragRegion">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Margin="24,0" VerticalAlignment="Center"
                       Text="TRACK ME UP" FontSize="12" FontWeight="SemiBold" CharacterSpacing="150" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,12,24,20" Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Tag="Labels.Manage" Text="Manage labels" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                    <TextBlock Tag="Labels.Description"
                               Text="Organize your activities by project or context with names, icons and colors."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Tag="Labels.FreeHint" Text="Free includes up to 3 labels. Existing labels are kept when you change profile."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <controls:FeatureGate x:Name="LabelsFeatureGate" Feature="ActivityLabels" ShowTitle="False">
                    <controls:ActivityLabelsEditor x:Name="LabelsEditor" />
                </controls:FeatureGate>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Padding="24,12,24,20" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button x:Name="CloseButton" Tag="About.Close" Click="CloseButton_Click"
                    HorizontalAlignment="Right" MinWidth="96">
                <TextBlock Tag="About.Close" Text="Close" TextWrapping="Wrap" />
            </Button>
        </Grid>
    </Grid>
</Window>
