<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="TrackMeUp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TrackMeUp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Controls/TitleBarOverflowButtonStyles.xaml"/>
                <ResourceDictionary Source="Controls/SurfaceChipStyles.xaml"/>
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="ActivityLineBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFF5C5C" Offset="0"/><GradientStop Color="#CFFF8B77" Offset="0.55"/><GradientStop Color="#00FF8B77" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="BrandCoralBrush" Color="#FFF9665B" />
                    <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFB7422E" />
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="ActivityLineBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFF6B6B" Offset="0"/><GradientStop Color="#BFFF927B" Offset="0.55"/><GradientStop Color="#00FF927B" Offset="1"/></LinearGradientBrush>
                    <SolidColorBrush x:Key="BrandCoralBrush" Color="#FFF9665B" />
                    <SolidColorBrush x:Key="PlayerAccentTextBrush" Color="#FFFF9B82" />
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityBackgroundBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconBackground" ResourceKey="ControlFillColorTransparentBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconForeground" ResourceKey="TextFillColorPrimaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="BrandCoralBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="PlayerAccentTextBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="InfoBarInformationalSeverityIconForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="InfoBarSuccessSeverityIconForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="InfoBarWarningSeverityIconForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="InfoBarErrorSeverityIconForeground" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style TargetType="ScrollViewer">
                <Setter Property="local:ScrollBarRevealBehavior.IsEnabled" Value="True" />
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Opacity" Value="0" />
            </Style>
            <Style x:Key="DashboardMetricLabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="CharacterSpacing" Value="100" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PlayerAccentTextBrush}" />
            </Style>
            <Style TargetType="InfoBar">
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <ThemeShadow />
                    </Setter.Value>
                </Setter>
                <Setter Property="local:InfoBarElevationBehavior.IsEnabled" Value="True" />
            </Style>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
